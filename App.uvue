<script setup lang="uts">
import wfc from './wfc/client/wfc.uts'
import store, { miscState } from './store.uts'
import Config from './config.uts'
import CustomMessageConfig from './wfc_custom_message/customMessageConfig.uts'
import avEngineKit from './wfc/av/engine/avEngineKit.uts'
import pttClient from './wfc/ptt/pttClient.uts'
import { initTheme, syncNativeTheme } from './common/theme.uts'
import { initFontScale } from './common/layoutScale.uts'
import { initAudioPlayMode } from './common/audioPlayMode.uts'

onLaunch(() => {
    console.log("App Launch");

    // 只读 storage，不碰 ext-api，所以可以放在最前面（首屏就是正确的明暗与字号）。
    // 真正会碰 uni-theme 的 syncNativeTheme() 放在本函数最后，见那里的说明。
    initTheme();
    initFontScale();
    // 语音消息走扬声器还是听筒，同样只读 storage（会话页标题栏的听筒标识依赖它）
    initAudioPlayMode();

    // 图标字体（原 css :before 方案 uni-app x 不支持，改为 loadFontFace + 文本内联 unicode）
    uni.loadFontFace({
        global: true,
        family: 'customicons',
        source: "url('/static/iconfonts/customicons.ttf')",
        success: (_) => { },
        fail: (err) => {
            console.log('load customicons font fail', err)
        }
    } as LoadFontFaceOptions)
    uni.loadFontFace({
        global: true,
        family: 'wxfont',
        source: "url('/static/iconfonts/wx_iconfont.ttf')",
        success: (_) => { },
        fail: (err) => {
            console.log('load wxfont fail', err)
        }
    } as LoadFontFaceOptions)
    uni.loadFontFace({
        global: true,
        family: 'icomoon',
        source: "url('/static/iconfonts/icomoon/fonts/icomoon.ttf')",
        success: (_) => { },
        fail: (err) => {
            console.log('load icomoon font fail', err)
        }
    } as LoadFontFaceOptions)

    // 初始化 IM
    wfc.init();
    // IM 长连接协议（websocket / TLS），协议栈在 connect 时才初始化，要在 store.init() 自动登录 connect 之前设置
    if (Config.IM_USE_WEBSOCKET) {
        wfc.setUseWebsocket(true);
    }
    if (Config.IM_USE_TLS) {
        wfc.useTls(Config.IM_TLS_SKIP_VERIFY_CERT, Config.IM_TRUST_CERTIFICATES);
    }
    // 双网环境，IM 备选地址及网络策略，要在 store.init() 自动登录 connect 之前设置
    if (Config.IM_SERVER_BACKUP_HOST != '') {
        wfc.setBackupAddress(Config.IM_SERVER_BACKUP_HOST, Config.IM_SERVER_BACKUP_PORT);
        wfc.setBackupAddressStrategy(Config.BACKUP_ADDRESS_STRATEGY);
    }
    if (Config.SEND_LOG_COMMAND != '') {
        wfc.setSendLogCommand(Config.SEND_LOG_COMMAND)
    }
    CustomMessageConfig.registerCustomMessages();
    store.init();

    // 音视频通话、对讲
    if (Config.ENABLE_VOIP) {
        avEngineKit.init();
    }
    if (Config.ENABLE_PTT) {
        pttClient.init();
    }

    // 推送
    uni.getPushClientId({
        success: (res) => {
            console.log('getPushClientId', res.cid);
            wfc.setDeviceToken(10/*unipush 2.0*/, res.cid);
        },
        fail: (err) => {
            console.log('getPushClientId error', err)
        }
    } as GetPushClientIdOptions);

    // 在线时，能收到，可以用来开发调试
    uni.onPushMessage((res) => {
        console.log("收到推送消息：", res.type)
    })

    // 放在最后：它会碰 uni-theme / uni-getDeviceInfo 这两个 ext-api 模块，基座里没带就会
    // 在运行时抛错。一旦它排在 wfc.init()/store.init() 前面，整个 onLaunch 会被打断，
    // IM 压根不初始化 —— 表现是所有列表页全空，但看不出跟主题有任何关系。
    // 内部已全程 try/catch，这里的排序是第二层保险。
    syncNativeTheme();
})

onShow(() => {
    console.log("App Show");
    miscState.isAppHidden = false;
})

onHide(() => {
    console.log("App Hide");
    miscState.isAppHidden = true;
})
</script>

<style>
/*每个页面公共css */
@import './global.css';
@import './wfc.css';
</style>
