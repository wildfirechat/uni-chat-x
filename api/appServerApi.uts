import Config from "../config.uts";
import AppServerError from "./appServerError.uts";
import wfc from "../wfc/client/wfc.uts";
import { jsonHeaderWithAuthToken, saveAuthTokenFromHeader, AUTH_TOKEN_SERVICE_APP } from "./authToken.uts";
import ConnectionStatus from "../wfc/client/connectionStatus.uts";
import { getBackupAddressStrategy, BACKUP_ADDRESS_STRATEGY_AUTO } from "../common/dualNetwork.uts";

/**
 * 登录结果
 */
export class LoginResult {
    userId = ''
    token = ''
    register = false
}

/**
 * 滑块验证码。对齐 flutter `widget/slide_verify_dialog.dart` 的 `SlideVerifyData`。
 *
 * 两张图都是 app server 直接返回的 `data:image/png;base64,...`，可以原样喂给 `<image src>`，
 * 不用像 flutter 那样先 base64 解码成字节（那是 `Image.memory` 的要求）。
 *
 * 坐标系是**背景图原始像素**（app server 固定 300x150，滑块 50x50，见
 * `SlideVerifyService`），[y] 是滑块在背景图里的纵坐标，校验时回传的 x 也要换算回这个坐标系。
 */
export class SlideVerifyData {
    token = ''
    /** 背景图（带缺口），data URI */
    backgroundImage = ''
    /** 滑块图，data URI */
    sliderImage = ''
    /** 滑块在背景图中的 y（原始像素） */
    y = 0
}

/** 滑块验证的背景图原始宽度，与 app server `SlideVerifyService.IMAGE_WIDTH` 一致。 */
export const SLIDE_VERIFY_IMAGE_WIDTH: number = 300
/** 背景图原始高度，同上。 */
export const SLIDE_VERIFY_IMAGE_HEIGHT: number = 150
/** 滑块原始边长（服务端画的是 50x50 正方形）。 */
export const SLIDE_VERIFY_SLIDER_SIZE: number = 50

/**
 * 登录前等 IM 未连接时，探测到的可用应用服务地址，'' 表示还没有探测结果
 */
let probedAppServer = ''
/** 正在进行的探测，探测期间的请求都等这次探测结果 */
let pendingAppServerProbe: Promise<string> | null = null

/**
 * 探测一个应用服务地址是否可达。应用服务根路径返回 Ok，只认它，避免被网关、代理之类返回的 200 误判
 */
function probeAppServer(address: string): Promise<boolean> {
    return new Promise<boolean>((resolve, reject) => {
        uni.request<string>({
            url: address,
            method: 'GET',
            responseType: 'text',
            timeout: 5000,
            success: (res) => {
                resolve(res.statusCode == 200 && (res.data ?? '').trim() == 'Ok')
            },
            fail: (err) => {
                console.log('probe app server fail', address, err.errMsg)
                resolve(false)
            }
        } as RequestOptions<string>)
    })
}

/**
 * 主备网络是隔离的，一般只有一个地址可达，并行探测主备地址，用首个可达的地址。
 * 都探测失败时回退到主地址，让后续请求正常报错，不缓存
 */
function probeAppServers(): Promise<string> {
    return new Promise<string>((resolve, reject) => {
        let pendingCount = 2
        let resolved = false
        const onResult = (address: string, reachable: boolean): void => {
            pendingCount--
            if (resolved) {
                return
            }
            if (reachable) {
                resolved = true
                probedAppServer = address
                resolve(address)
            } else if (pendingCount == 0) {
                resolved = true
                resolve(Config.APP_SERVER)
            }
        }
        probeAppServer(Config.APP_SERVER).then((reachable: boolean): void => {
            onResult(Config.APP_SERVER, reachable)
        })
        probeAppServer(Config.APP_SERVER_BACKUP).then((reachable: boolean): void => {
            onResult(Config.APP_SERVER_BACKUP, reachable)
        })
    })
}

/**
 * 获取当前应使用的应用服务地址。对齐 android-chat `AppService.appServerAddress(callback)`。
 *
 * IM 已连接时，直接用 IM 连接的网络选（Config.getAppServer）；IM 未连接时（登录前），网络未知，
 * 探测主备地址。探测结果会缓存，避免每次请求都探测；请求出现网络错误时清除缓存，下次请求重新探测。
 * 不是双网环境，或者指定了网络策略时，不用探测。
 */
export function resolveAppServer(): Promise<string> {
    return new Promise<string>((resolve, reject) => {
        if (Config.APP_SERVER == '' || Config.APP_SERVER_BACKUP == '' || getBackupAddressStrategy() != BACKUP_ADDRESS_STRATEGY_AUTO) {
            resolve(Config.getAppServer())
            return
        }
        const status = wfc.getConnectionStatus()
        if (status == ConnectionStatus.ConnectionStatusConnected || status == ConnectionStatus.ConnectionStatusReceiveing) {
            // IM 连接后以 IM 连接的网络为准，清除探测结果，IM 断开后（如退出登录）重新探测
            probedAppServer = ''
            resolve(Config.getAppServer())
            return
        }
        if (probedAppServer != '') {
            resolve(probedAppServer)
            return
        }
        if (pendingAppServerProbe == null) {
            pendingAppServerProbe = probeAppServers()
        }
        pendingAppServerProbe!.then((address: string): void => {
            pendingAppServerProbe = null
            resolve(address)
        })
    })
}

/**
 * 请求出现网络错误，可能是网络环境变了，清除探测结果，下次请求重新探测
 */
function onAppServerNetworkError(): void {
    probedAppServer = ''
}

export class AppServerApi {

    /**
     * 请求登录短信验证码。
     *
     * [slideVerifyToken] 传空表示不带滑块验证凭证 —— 服务端 `forceSlideVerify` 关着时才允许，
     * 开着时会直接返回 `ERROR_SLIDE_VERIFY_NOT_PASS`。是否先过滑块由调用方按
     * `Config.ENABLE_SLIDE_VERIFY` 决定，对齐 flutter `LoginFormController.sendCode`。
     */
    requestAuthCode(mobile: string, slideVerifyToken: string = ''): Promise<UTSJSONObject | null> {
        const data = { mobile: mobile } as UTSJSONObject
        if (slideVerifyToken != '') {
            data['slideVerifyToken'] = slideVerifyToken
        }
        return this._post('/send_code', data)
    }

    loginWithPassword(mobile: string, password: string, slideVerifyToken: string = ''): Promise<LoginResult> {
        const data = {
            mobile: mobile,
            password: password,
            platform: Config.getWFCPlatform(),
            clientId: wfc.getClientId()
        } as UTSJSONObject
        if (slideVerifyToken != '') {
            data['slideVerifyToken'] = slideVerifyToken
        }
        return this._login('/login_pwd', data)
    }

    loginWithAuthCode(mobile: string, authCode: string, slideVerifyToken: string = ''): Promise<LoginResult> {
        const data = {
            mobile: mobile,
            code: authCode,
            platform: Config.getWFCPlatform(),
            clientId: wfc.getClientId()
        } as UTSJSONObject
        if (slideVerifyToken != '') {
            data['slideVerifyToken'] = slideVerifyToken
        }
        return this._login('/login', data)
    }

    /**
     * 生成一张滑块验证码。对齐 flutter `AppServer.generateSlideVerifyCode`。
     *
     * 注意这个接口**不需要登录态**（登录页本来就还没登录），`_post` 没有 authToken 时不带。
     */
    generateSlideVerifyCode(): Promise<SlideVerifyData> {
        return new Promise<SlideVerifyData>((resolve, reject) => {
            this._post('/slide_verify/generate', {} as UTSJSONObject)
                .then((result: UTSJSONObject | null): void => {
                    if (result == null) {
                        reject(new AppServerError(-1, '验证码数据不完整'))
                        return
                    }
                    const data = new SlideVerifyData()
                    data.token = result.getString('token') ?? ''
                    data.backgroundImage = result.getString('backgroundImage') ?? ''
                    data.sliderImage = result.getString('sliderImage') ?? ''
                    data.y = result.getNumber('y') ?? 0
                    if (data.token == '' || data.backgroundImage == '' || data.sliderImage == '') {
                        reject(new AppServerError(-1, '验证码数据不完整'))
                        return
                    }
                    resolve(data)
                })
                .catch((e): void => {
                    reject(e)
                })
        })
    }

    /**
     * 校验滑块位置。[x] 是**背景图原始像素**坐标系里的横坐标（服务端容差 10px）。
     * 校验不通过时 `_post` 会 reject，调用方按失败处理。
     */
    verifySlideCode(token: string, x: number): Promise<UTSJSONObject | null> {
        return this._post('/slide_verify/verify', { token: token, x: x } as UTSJSONObject)
    }

    changePassword(oldPassword: string, newPassword: string): Promise<UTSJSONObject | null> {
        return this._post('/change_pwd', {
            oldPassword: oldPassword,
            newPassword: newPassword
        } as UTSJSONObject)
    }

    /**
     * 请求注销账号的短信验证码，发到当前账号绑定的手机号，无需传号码。
     *
     * flutter 侧支持带滑块验证 token（`Config.ENABLE_SLIDE_VERIFY`），滑块验证属于 M4 登录页，
     * 这里先留参数位，默认不带。
     */
    sendDestroyAccountCode(slideVerifyToken: string = ''): Promise<UTSJSONObject | null> {
        const data = {} as UTSJSONObject
        if (slideVerifyToken != '') {
            data['slideVerifyToken'] = slideVerifyToken
        }
        return this._post('/send_destroy_code', data)
    }

    /** 注销账号。成功后调用方负责清本地登录态并回登录页。 */
    destroyAccount(code: string): Promise<UTSJSONObject | null> {
        return this._post('/destroy', { code: code } as UTSJSONObject)
    }

    /**
     * 收藏列表，按 favId 倒序翻页。
     * [startId] 传 0 表示从最新一条开始；后续传上一页最后一条的 favId。
     */
    getFavoriteItems(startId: number, count: number): Promise<UTSJSONObject | null> {
        return this._post('/fav/list', { id: startId, count: count } as UTSJSONObject)
    }

    addFavoriteItem(item: UTSJSONObject): Promise<UTSJSONObject | null> {
        return this._post('/fav/add', item)
    }

    removeFavoriteItem(favId: number): Promise<UTSJSONObject | null> {
        return this._post('/fav/del/' + favId, {} as UTSJSONObject)
    }

    /**
     * 扫到 PC 登录二维码后，先把这个 token 标成「已扫描」。
     * 服务端返回的 result.status：1 = 已扫描待确认，其它值都是异常（过期/已用掉）。
     * 对齐 flutter `AppServer.scanPCLogin`。
     */
    scanPcLogin(token: string): Promise<UTSJSONObject | null> {
        return this._post('/scan_pc/' + token, {} as UTSJSONObject)
    }

    /**
     * 确认 PC 登录。`quick_login` 固定传 1，与 flutter 一致。
     * 成功时服务端返回 result.status == 2。
     */
    confirmPcLogin(token: string, userId: string): Promise<UTSJSONObject | null> {
        return this._post('/confirm_pc', {
            token: token,
            user_id: userId,
            quick_login: 1
        } as UTSJSONObject)
    }

    /** 取消 PC 登录（用户在确认页点了取消） */
    cancelPcLogin(token: string): Promise<UTSJSONObject | null> {
        return this._post('/cancel_pc', { token: token } as UTSJSONObject)
    }

    getGroupAnnouncement(groupId: string): Promise<UTSJSONObject | null> {
        return this._post('/get_group_announcement', { groupId: groupId } as UTSJSONObject)
    }

    updateGroupAnnouncement(author: string, groupId: string, announcement: string): Promise<UTSJSONObject | null> {
        return this._post('/put_group_announcement', {
            author: author,
            groupId: groupId,
            text: announcement
        } as UTSJSONObject)
    }

    private _login(path: string, data: UTSJSONObject): Promise<LoginResult> {
        return new Promise<LoginResult>((resolve, reject) => {
            resolveAppServer().then((appServer: string): void => {
                uni.request<UTSJSONObject>({
                    url: appServer + path,
                    data: data,
                    header: {
                        'content-type': 'application/json',
                    } as UTSJSONObject,
                    method: 'POST',
                    success: (res) => {
                        saveAuthTokenFromHeader(AUTH_TOKEN_SERVICE_APP, res.header as UTSJSONObject | null)
                        if (res.statusCode == 200) {
                            const body = res.data
                            if (body == null) {
                                reject(new AppServerError(-1, '响应为空'));
                                return
                            }
                            const code = body.getNumber('code') ?? -1
                            if (code == 0) {
                                const result = body.getJSON('result')
                                const loginResult = new LoginResult()
                                if (result != null) {
                                    loginResult.userId = result.getString('userId') ?? ''
                                    loginResult.token = result.getString('token') ?? ''
                                    loginResult.register = result.getBoolean('register') ?? false
                                }
                                resolve(loginResult);
                            } else {
                                reject(new AppServerError(code, body.getString('message') ?? ''));
                            }
                        } else {
                            reject(new AppServerError(-1, 'request error, status code: ' + res.statusCode));
                        }
                    },
                    fail: (err) => {
                        console.log('login request fail', err);
                        onAppServerNetworkError();
                        reject(new AppServerError(-1, 'request error: ' + err.errMsg));
                    }
                } as RequestOptions<UTSJSONObject>);
            })
        })
    }

    /**
     * 通用 post，resolve 的是 response.data.result（对象）。
     * result 不是对象（字符串 / 数组 / 布尔，比如会议相关的几个接口）时用 {@link _postForBody}，
     * 自己按类型从响应体里取 —— 直接把 result 当 `any` 传出去，在 Kotlin/Swift 侧强转很容易崩。
     */
    _post(path: string, data: UTSJSONObject): Promise<UTSJSONObject | null> {
        return this._postForBody(path, data).then((body: UTSJSONObject | null): UTSJSONObject | null => {
            return body == null ? null : body!.getJSON('result')
        })
    }

    /**
     * 通用 post，校验完业务 code 之后把**整个响应体**交给调用方，
     * 由调用方用 getString/getArray/getBoolean 按 result 的实际类型取值。
     */
    _postForBody(path: string, data: UTSJSONObject): Promise<UTSJSONObject | null> {
        return new Promise<UTSJSONObject | null>((resolve, reject) => {
            resolveAppServer().then((appServer: string): void => {
                const url = appServer + path;
                console.log('_post', url);
                uni.request<UTSJSONObject>({
                    url: url,
                    data: data,
                    header: jsonHeaderWithAuthToken(AUTH_TOKEN_SERVICE_APP),
                    method: 'POST',
                    success: (res) => {
                        saveAuthTokenFromHeader(AUTH_TOKEN_SERVICE_APP, res.header as UTSJSONObject | null)
                        if (res.statusCode == 200) {
                            const body = res.data
                            if (body == null) {
                                resolve(null);
                                return
                            }
                            const code = body.getNumber('code') ?? -1
                            if (code == 0) {
                                resolve(body);
                            } else {
                                reject(new AppServerError(code, body.getString('message') ?? ''))
                            }
                        } else {
                            reject(new AppServerError(-1, 'request error, status code: ' + res.statusCode))
                        }
                    },
                    fail: (err) => {
                        console.log('_post fail', err);
                        onAppServerNetworkError();
                        reject(new AppServerError(-1, 'request error: ' + err.errMsg))
                    }
                } as RequestOptions<UTSJSONObject>);
            })
        });
    }
}

const appServerApi = new AppServerApi();
export default appServerApi;
