import Config from "../config.uts";
import { jsonHeaderWithAuthToken, saveAuthTokenFromHeader, removeAuthToken, AUTH_TOKEN_SERVICE_ORG } from "./authToken.uts";
import wfc from "../wfc/client/wfc.uts";
import OrganizationServerError from "./organizationServerError.uts";
import UserInfo from "../wfc/model/userInfo.uts";
import { redirectMediaUrl } from '../common/mediaUrlRedirector.uts';
import {
    Organization, Employee, OrganizationEx, EmployeeEx,
    organizationListFromJson, employeeListFromJson,
    organizationExFromJson, employeeExFromJson, toJsonObject,
    employeeDefaultPortrait
} from "./organizationModel.uts";

/** 组织通讯录服务的「没有登录」，token 过期或服务重启后会返回它（HTTP 仍是 200） */
const ERROR_NOT_LOGIN: number = 13

export class OrganizationServerApi {
    isServiceAvailable = true;

    /** 正在进行的重新登录，并发请求遇到「没有登录」时共用这一次 */
    private reloginPromise: Promise<UTSJSONObject | null> | null = null;

    login(): Promise<UTSJSONObject | null> {
        return new Promise<UTSJSONObject | null>((resolve, reject) => {
            const organizationServer = Config.getOrganizationServer()
            if (organizationServer == '') {
                reject(new OrganizationServerError(-1, '未配置组织结构服务'));
                return
            }
            wfc.getAuthCode('admin', 2, '', (code: string) => {
                const path = organizationServer + '/api/user_login';
                uni.request<UTSJSONObject>({
                    url: path,
                    data: { authCode: code } as UTSJSONObject,
                    header: {
                        'content-type': 'application/json',
                    } as UTSJSONObject,
                    method: 'POST',
                    success: (res) => {
                        saveAuthTokenFromHeader(AUTH_TOKEN_SERVICE_ORG, res.header as UTSJSONObject | null)
                        const body = res.data
                        if (res.statusCode == 200 && body != null) {
                            const resultCode = body.getNumber('code') ?? -1
                            if (resultCode == 0) {
                                this.isServiceAvailable = true;
                                resolve(body.getJSON('result'));
                            } else {
                                reject(new OrganizationServerError(resultCode, body.getString('message') ?? ''));
                            }
                        } else {
                            reject(new OrganizationServerError(-1, 'request error, status code: ' + res.statusCode));
                        }
                    },
                    fail: (err) => {
                        reject(new OrganizationServerError(-1, 'request error: ' + err.errMsg));
                    }
                } as RequestOptions<UTSJSONObject>);
            }, (error: number) => {
                console.error('getAuthCode error', error);
                reject(new OrganizationServerError(-1, '未登录，或服务不可用'));
            })
        })
    }

    getRootOrganization(): Promise<any | null> {
        return this._post('/api/organization/root', {} as UTSJSONObject);
    }

    getRelationShip(employeeId: string): Promise<any | null> {
        return this._post('/api/relationship/employee', { employeeId: employeeId } as UTSJSONObject);
    }

    getOrganizationEx(orgId: number): Promise<any | null> {
        return this._post('/api/organization/query_ex', { id: orgId } as UTSJSONObject);
    }

    getOrganizations(orgIds: number[]): Promise<any | null> {
        return this._post('/api/organization/query_list', { ids: orgIds } as UTSJSONObject);
    }

    getOrgEmployees(orgId: number): Promise<any | null> {
        // 参数名是 id 不是 ids（对齐 flutter organization_service.dart:217；
        // 原来写的 ids 服务端解析不到，会返回空列表）
        return this._post('/api/organization/employees', { id: orgId } as UTSJSONObject);
    }

    getEmployee(employeeId: string): Promise<any | null> {
        return this._post('/api/employee/query', { employeeId: employeeId } as UTSJSONObject);
    }

    getEmployeeEx(employeeId: string): Promise<any | null> {
        return this._post('/api/employee/query_ex', { employeeId: employeeId } as UTSJSONObject);
    }

    getEmployeeList(employeeIds: string[]): Promise<any | null> {
        return this._post('/api/employee/query_list', { employeeIds: employeeIds } as UTSJSONObject)
    }

    /**
     * 搜索员工。服务端是分页接口，必须带 count/page（对齐 flutter organization_service.dart:270），
     * 返回体是 `{ contents: [...] }` 而不是裸数组 —— 用 [searchEmployeeList] 拿已解包的结果。
     */
    searchEmployee(orgId: number, keyword: string, page: number = 0, count: number = 50): Promise<any | null> {
        return this._post('/api/employee/search', {
            organizationId: orgId,
            keyword: keyword,
            count: count,
            page: page
        } as UTSJSONObject);
    }

    // ---- 以下是带解析的封装，页面用这些，不要自己解 UTSJSONObject ----

    getRootOrganizationList(): Promise<Organization[]> {
        return this.getRootOrganization().then((res): Organization[] => organizationListFromJson(res))
    }

    getOrganizationExInfo(orgId: number): Promise<OrganizationEx | null> {
        return this.getOrganizationEx(orgId).then((res): OrganizationEx | null => organizationExFromJson(res))
    }

    getOrganizationList(orgIds: number[]): Promise<Organization[]> {
        return this.getOrganizations(orgIds).then((res): Organization[] => organizationListFromJson(res))
    }

    getEmployeeExInfo(employeeId: string): Promise<EmployeeEx | null> {
        return this.getEmployeeEx(employeeId).then((res): EmployeeEx | null => employeeExFromJson(res))
    }

    /** 搜索结果已从 `{ contents: [...] }` 里解包 */
    searchEmployeeList(orgId: number, keyword: string): Promise<Employee[]> {
        return this.searchEmployee(orgId, keyword).then((res): Employee[] => {
            const obj = toJsonObject(res)
            if (obj != null) {
                return employeeListFromJson(obj.get('contents'))
            }
            return employeeListFromJson(res)
        })
    }

    employeeToUserInfo(employee: UTSJSONObject): UserInfo {
        const userInfo = new UserInfo();
        userInfo.uid = employee.getString('employeeId') ?? '';
        userInfo.name = employee.getString('name') ?? '';
        userInfo.displayName = employee.getString('name') ?? '';
        const portrait = employee.getString('portraitUrl') ?? employee.getString('portrait')
        userInfo.portrait = portrait != null && portrait != '' ? redirectMediaUrl(portrait) : employeeDefaultPortrait(userInfo.displayName);
        userInfo.gender = employee.getNumber('gender') ?? 0;
        userInfo.mobile = employee.getString('mobile') ?? '';
        userInfo.email = employee.getString('email') ?? '';
        userInfo.updateDt = employee.getNumber('updateDt') ?? 0;
        userInfo.type = 1;
        userInfo.deleted = 0;
        return userInfo;
    }

    /**
     * 通用 post，resolve 的是 response.data.result（可能是对象或数组）。
     *
     * 本地存的 token 可能已在服务端失效（服务重启、会话过期），遇到「没有登录」时清掉旧 token
     * 重新登录，再重试一次。对齐 flutter `OrganizationService._post`。
     */
    _post(path: string, data: UTSJSONObject): Promise<any | null> {
        return new Promise<any | null>((resolve, reject) => {
            this._postOnce(path, data).then((result: any | null): void => {
                resolve(result)
            }).catch((err: any | null): void => {
                if (!(err instanceof OrganizationServerError) || (err as OrganizationServerError).errorCode != ERROR_NOT_LOGIN) {
                    reject(err)
                    return
                }
                this._relogin().then((_r: UTSJSONObject | null): void => {
                    this._postOnce(path, data).then((result: any | null): void => {
                        resolve(result)
                    }).catch((retryErr: any | null): void => {
                        reject(retryErr)
                    })
                }).catch((_loginErr: any | null): void => {
                    reject(err)
                })
            })
        });
    }

    /** 清除失效的 token 并重新登录，并发的请求共用同一次登录 */
    private _relogin(): Promise<UTSJSONObject | null> {
        const pending = this.reloginPromise
        if (pending != null) {
            return pending
        }
        removeAuthToken(AUTH_TOKEN_SERVICE_ORG)
        const relogin = new Promise<UTSJSONObject | null>((resolve, reject) => {
            this.login().then((result: UTSJSONObject | null): void => {
                this.reloginPromise = null
                resolve(result)
            }).catch((err: any | null): void => {
                this.reloginPromise = null
                reject(err)
            })
        })
        this.reloginPromise = relogin
        return relogin
    }

    private _postOnce(path: string, data: UTSJSONObject): Promise<any | null> {
        return new Promise<any | null>((resolve, reject) => {
            const organizationServer = Config.getOrganizationServer()
            uni.request<UTSJSONObject>({
                url: organizationServer + path,
                data: data,
                header: jsonHeaderWithAuthToken(AUTH_TOKEN_SERVICE_ORG),
                method: 'POST',
                success: (res) => {
                    saveAuthTokenFromHeader(AUTH_TOKEN_SERVICE_ORG, res.header as UTSJSONObject | null)
                    const body = res.data
                    if (res.statusCode == 401 || res.statusCode == 403) {
                        // 服务本身不返回 401/403（没有登录是 HTTP 200 + code 13），对齐 flutter 也按「没有登录」处理
                        reject(new OrganizationServerError(ERROR_NOT_LOGIN, 'request error, status code: ' + res.statusCode))
                    } else if (res.statusCode == 200 && body != null) {
                        const code = body.getNumber('code') ?? -1
                        if (code == 0) {
                            resolve(body.get('result'));
                        } else {
                            reject(new OrganizationServerError(code, body.getString('message') ?? ''))
                        }
                    } else {
                        reject(new OrganizationServerError(-1, 'request error, status code: ' + res.statusCode))
                    }
                },
                fail: (err) => {
                    reject(new OrganizationServerError(-1, 'request error: ' + err.errMsg))
                }
            } as RequestOptions<UTSJSONObject>);
        });
    }
}

const organizationServerApi = new OrganizationServerApi();
export default organizationServerApi;
