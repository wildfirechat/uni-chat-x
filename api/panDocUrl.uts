/**
 * 在线文档页面地址与格式判断。对齐 flutter `chat/lib/pan/pan_service.dart:37-108`。
 *
 * 文档页由 wf-pan-server 自带（`{PAN_DOC_BASE}`，独立部署典型值 `https://host/pan/doc/`），
 * 页面里的登录靠宿主 web-view 的桥取认证码，所以**只能用应用内置网页打开**，
 * 不能丢给系统浏览器（对齐 flutter 的注释：这类页面系统浏览器打不开）。
 */
import Config from "../config.uts";

/** 打开某个文件：编辑还是只读由服务端按权限和平台决定；格式打不开时页面给下载。 */
export function docOpenUrl(fileId: number): string {
    return Config.getPanDocBase() + 'open?fileId=' + fileId
}

/**
 * 按链接**只读**打开一个在线文档页：文件不在网盘里（聊天里的文件消息等），
 * 服务端代理取内容，只能看不能改 —— 要编辑得先「存到网盘」拿到 fileId。
 */
export function docViewUrl(url: string, name: string = ''): string {
    let result = Config.getPanDocBase() + 'open?url=' + encodeURIComponent(url)
    if (name != '') {
        result = result + '&name=' + encodeURIComponent(name)
    }
    return result
}

/** 开源许可页：编辑引擎是 AGPL，文档首页要留这个入口。 */
export function docLicensesUrl(): string {
    return Config.getPanDocBase() + 'licenses.html'
}

/**
 * 是不是在线文档页面的地址。主备两个地址都认：卡片是对方按他当时所在网络的地址发的。
 * 未单独配置 PAN_DOC_BASE 时按 PAN_SERVER 派生的文档根也认。
 */
export function isDocUrl(url: string): boolean {
    const bases: string[] = [
        Config.getPanDocBase(),
        Config.PAN_DOC_BASE,
        Config.PAN_DOC_BASE_BACKUP,
        docBaseFromApi(Config.PAN_SERVER),
        docBaseFromApi(Config.PAN_SERVER_BACKUP)
    ]
    for (let i = 0; i < bases.length; i++) {
        let base = bases[i].trim()
        if (base == '') {
            continue
        }
        if (base.endsWith('/')) {
            base = base.substring(0, base.length - 1)
        }
        if (url.startsWith(base + '/')) {
            return true
        }
    }
    return false
}

/** 从网盘地址（服务根或含 /api/v1 的 API 根）派生文档根目录。 */
function docBaseFromApi(api: string): string {
    let base = api.trim()
    if (base == '') {
        return ''
    }
    if (base.endsWith('/')) {
        base = base.substring(0, base.length - 1)
    }
    const idx = base.lastIndexOf('/api/v1')
    if (idx > 0) {
        base = base.substring(0, idx)
    }
    return base + '/doc'
}

/**
 * 在线文档能打开的格式，与服务端 `DocsService` 的 WORD / CELL / SLIDE / PDF 四组一致
 * （能不能编辑、要不要先转换由服务端决定）。
 */
const ONLINE_DOC_EXTENSIONS: string[] = [
    'doc', 'docx', 'docm', 'dot', 'dotx', 'dotm', 'odt', 'ott', 'rtf', 'txt',
    'wps', 'wpt', 'fodt', 'mht', 'mhtml', 'htm', 'html', 'epub', 'fb2',
    'xls', 'xlsx', 'xlsm', 'xlt', 'xltx', 'xltm', 'xlsb', 'ods', 'ots', 'csv',
    'et', 'ett', 'fods',
    'ppt', 'pptx', 'pptm', 'pot', 'potx', 'potm', 'pps', 'ppsx', 'ppsm',
    'odp', 'otp', 'dps', 'dpt', 'fodp',
    'pdf', 'djvu', 'xps', 'oxps'
]

/**
 * 文件名是不是「在线文档」格式。聊天里的文件消息没有网盘 fileId，只能按扩展名判断
 * 能不能在线预览（服务端按同一个格式表校验，不支持的格式会拒绝「按链接打开」）。
 */
export function isOnlineDocName(name: string): boolean {
    if (name == '') {
        return false
    }
    const idx = name.lastIndexOf('.')
    if (idx <= 0 || idx == name.length - 1) {
        return false
    }
    return ONLINE_DOC_EXTENSIONS.indexOf(name.substring(idx + 1).toLowerCase()) >= 0
}
