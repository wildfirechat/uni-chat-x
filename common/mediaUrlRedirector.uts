/**
 * 双网媒体 URL 前缀转换。对齐 flutter `utils/media_url_redirector.dart`
 * （flutter 那份又是照着 iOS 的 `WFCCUrlRedirector` 做的）。
 *
 * 政企内外双网部署时，同一份媒体资源在主网和备网有两个不同的地址前缀。协议栈自己会在
 * 两张网之间切，但**已经落在消息/资料里的 URL 是当初存下来的那一份**，换到另一张网上
 * 就下载不到。所以每次要用 URL 之前，按当前连的是哪张网把前缀换过来。
 *
 * 只配了一个前缀、或者两个都没配（默认）时，这里原样返回，等于没启用。
 *
 * 用法：**别直接读 `xxx.remoteUrl` / `xxx.portrait` 去下载**，
 * 统一走 [redirectMediaUrl]。大部分地方已经在模型解析处转好了
 * （userInfo / groupInfo / channelInfo / chatRoomInfo 的 portrait、
 * mediaMessageContent 的 remotePath、cardMessageContent 的 portrait 等），
 * 新加的下载/展示路径记得也走一遍。
 */
import Config from '../config.uts'
import { isConnectedToMainNetwork } from './dualNetwork.uts'

const swapNetworkPrefix = (url: string): string => {
    const mainPrefix = Config.MAIN_MEDIA_URL_PREFIX
    const backupPrefix = Config.BACKUP_MEDIA_URL_PREFIX
    if (mainPrefix == '' || backupPrefix == '') {
        return url
    }
    // 当前连的是哪张网见 common/dualNetwork.uts，单网部署下两个前缀都没配，走不到这里
    if (isConnectedToMainNetwork()) {
        // 主网下，把备网地址前缀换成主网
        if (url.indexOf(backupPrefix) == 0) {
            return mainPrefix + url.substring(backupPrefix.length)
        }
    } else {
        // 备网下，把主网地址前缀换成备网
        if (url.indexOf(mainPrefix) == 0) {
            return backupPrefix + url.substring(mainPrefix.length)
        }
    }
    return url
}

/**
 * 转换媒体类 URL（头像、图片、视频、语音、文件等）。
 *
 * 先做双网前缀互换，再过一遍 [Config.urlRedirect] —— 后者是留给使用者自己改写地址的
 * 钩子（默认原样返回），两者互不影响。
 */
export const redirectMediaUrl = (originalUrl: string): string => {
    if (originalUrl == '') {
        return originalUrl
    }
    return Config.urlRedirect(swapNetworkPrefix(originalUrl))
}
