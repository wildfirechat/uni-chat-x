/**
 * 触摸坐标提取工具，以及「把节点几何换算成同一套逻辑像素坐标」的 [getElementScreenRect]。
 *
 * 1) longpress 事件下 touches 可能为空数组，而 changedTouches 始终携带
 *    触发事件的触点坐标（uni-app x 官方 touch 示例及本工程录音长按代码
 *    均为 `changedTouches[0]` 优先）。
 * 2) Harmony 上触点坐标的单位**随事件类型变**，运行时没有归一，见 [touchScale]：
 *    touchstart/touchmove/touchend/touchcancel 已经是逻辑像素(vp)，longpress 是物理像素、要除 pixelRatio。
 * 3) **tap/click 的坐标本来就是 vp，不要折算**，见 [getPointerPoint]。
 *    touch 用 [getTouchPoint]、tap 用 [getPointerPoint]，两者不通用。
 */
export class TouchPoint {
    x: number
    y: number

    constructor(x: number, y: number) {
        this.x = x
        this.y = y
    }
}

// 屏幕密度运行期不会变，而 touchmove 是逐帧回调，不能每次都去问一次 getSystemInfoSync
let _pixelRatio: number = 0

function pixelRatio(): number {
    if (_pixelRatio == 0) {
        _pixelRatio = uni.getSystemInfoSync().pixelRatio
    }
    return _pixelRatio
}

const _loggedTouchTypes = new Map<string, boolean>()

/**
 * 触点坐标要除的系数：已经是逻辑像素返回 1，物理像素返回 pixelRatio。非 Harmony 平台恒为 1。
 *
 * Harmony 上两种单位都是实测出来的：
 * - `touchstart/touchmove/...` 是 **vp**。2026-09-14，376×809 vp、pixelRatio 3.5 的机器：按住底部输入栏的
 *   「按住说话」，clientY≈746，以前一律除 pixelRatio 变成 213 —— 按住说话浮层的弧形区域顶到屏幕上部、
 *   手指永远落在左半边滑不到「转文字」；登录滑块只走手指距离的 1/3.5。
 * - `longpress` 是**物理像素**：07-31 修长按菜单位置（930ec75）就是按除 pixelRatio 调好的。
 *
 * 所以只放开 `touch` 开头的事件类型，其余照旧折算：万一哪个运行时的类型名对不上，退回的是原来的行为，
 * 不会把已经调好的长按菜单弄坏。
 */
function touchScale(e: UniTouchEvent): number {
    // #ifdef APP-HARMONY
    const type = e.type.toLowerCase()
    const scale = type.startsWith('touch') ? 1 : pixelRatio()
    // 临时诊断（真机确认各事件类型的单位后删）：每种事件类型只打一次
    if (!_loggedTouchTypes.has(type)) {
        _loggedTouchTypes.set(type, true)
        console.log('[touch] type=', e.type, 'scale=', scale)
    }
    return scale
    // #endif
    // #ifndef APP-HARMONY
    return 1
    // #endif
}

/**
 * tap/click 事件的触点。
 *
 * `@tap` 给的是 **UniPointerEvent**（clientX/clientY/pageX/pageY），没有
 * touches/changedTouches，不能丢给 [getTouchPoint]（会崩在 `.length` 上）。
 *
 * ⚠️ **和 [getTouchPoint] 不一样，这里三端都不折算，clientX/clientY 直接就是逻辑像素。**
 * 别看鸿蒙运行时里 click 和 touch 都走 `helper/pointer.ets` 的同一个 `getPointer()`
 * （`dom/UniPointerEvent.ets` / `dom/UniTouchEvent/init.ets`）就以为单位一致 ——
 * 喂进去的 ArkUI 原始值单位本来就不同：`ClickEvent.windowX` 是 vp，
 * `TouchObject.windowX` 是物理像素，运行时没有归一。
 *
 * 实测（388×837 vp、pixelRatio 3.25 的鸿蒙机）：点右边缘的按钮，clientX 就是 365 左右，
 * 再除一次 pixelRatio 会变成 110，菜单整体被压到屏幕左上角。
 */
export function getPointerPoint(e: UniPointerEvent): TouchPoint {
    return new TouchPoint(e.clientX, e.clientY)
}

export function getTouchPoint(e: UniTouchEvent): TouchPoint | null {
    let t: UniTouch | null = null
    if (e.changedTouches.length > 0) {
        t = e.changedTouches[e.changedTouches.length - 1]
    } else if (e.touches.length > 0) {
        t = e.touches[0]
    }
    if (t == null) {
        return null
    }
    const scale = touchScale(e)
    return new TouchPoint(t.clientX / scale, t.clientY / scale)
}

/**
 * touch 事件触点的**屏幕坐标**，单位逻辑像素。给窗口级的原生浮层用（wfc-voice-input 的按住说话）。
 *
 * 为什么不直接用 [getTouchPoint]：clientX/clientY 相对的是「页面可显示区域」，而插件的浮层是单独的窗口
 * （Android 的 PopupWindow、iOS 加在 key window 上），它不知道页面区域在屏幕上偏了多少
 * （原生导航栏、分屏都会让它变）。screenX/screenY 本来就是屏幕坐标，插件自己再换算到浮层坐标系。
 *
 * - 鸿蒙照旧返回 [getTouchPoint]：插件在鸿蒙上按窗口坐标算，2026-09-14 真机验证过，不动它；
 * - 运行时万一没填 screenX/screenY（两个都是 0），退回 clientX/clientY ——
 *   会话页是自定义导航栏、页面从屏幕顶上开始，两者本来就差不多。
 */
export function getTouchScreenPoint(e: UniTouchEvent): TouchPoint | null {
    // #ifdef APP-HARMONY
    return getTouchPoint(e)
    // #endif
    // #ifndef APP-HARMONY
    let t: UniTouch | null = null
    if (e.changedTouches.length > 0) {
        t = e.changedTouches[e.changedTouches.length - 1]
    } else if (e.touches.length > 0) {
        t = e.touches[0]
    }
    if (t == null) {
        return null
    }
    const touch = t as UniTouch
    if (touch.screenX == 0 && touch.screenY == 0) {
        return new TouchPoint(touch.clientX, touch.clientY)
    }
    return new TouchPoint(touch.screenX, touch.screenY)
    // #endif
}

/** 节点在屏幕坐标系里的矩形，单位逻辑像素 */
export class ScreenRect {
    x: number
    y: number
    width: number
    height: number

    constructor(x: number, y: number, width: number, height: number) {
        this.x = x
        this.y = y
        this.width = width
        this.height = height
    }
}

/** 触点判定的容差：手指可能落在子节点溢出的部分上，或压在边框上 */
const PROBE_TOLERANCE = 8

/** 触点是否落在矩形里（带 [PROBE_TOLERANCE] 容差）。用来校验一个算出来的矩形可不可信。 */
export function rectContainsPoint(rect: ScreenRect, probe: TouchPoint): boolean {
    return probe.x >= rect.x - PROBE_TOLERANCE && probe.x <= rect.x + rect.width + PROBE_TOLERANCE
        && probe.y >= rect.y - PROBE_TOLERANCE && probe.y <= rect.y + rect.height + PROBE_TOLERANCE
}

/**
 * 取节点在屏幕坐标系里的矩形，单位统一成逻辑像素；判定不出来时返回 null。
 *
 * ## 为什么要传一个 probe 而不是按平台写死折算
 *
 * 因为鸿蒙上这个矩形的单位**查不到也不稳定**：
 * - 老的 dom1 运行时（HBuilderX `launcher-harmony/base/project-x.zip` → `libs/runtime.har`）里，
 *   `getBoundingClientRect()` 的**位置是物理像素、尺寸是 vp** —— `dom/UniElement.ets` 的
 *   `_getSize()` 走了 px2vp，`_getPosition()` 没有。这是个 bug，随时可能被修。
 * - 本项目（vapor + bytecode）实际用的是 dom2 运行时（`project-dom2-dyn.zip` → `libs/sdk.har`），
 *   那里 `getBoundingClientRect()` 直接转发给原生节点，实现看不到，单位无从查证。
 *
 * 所以这里不猜单位：调用方传一个**已知落在该节点内**的触点（[getTouchPoint] 归一化过的
 * 逻辑像素），折算前/折算后两个候选矩形里哪个能把触点框住就用哪个 —— 单位怎么变都不会错。
 * 两个都框不住（拿到的几何压根不可信）就返回 null，让调用方退回不依赖节点几何的路径。
 *
 * 先试不折算的候选：那是规范里本来的语义。
 */
export function getElementScreenRect(el: UniElement, probe: TouchPoint): ScreenRect | null {
    // 鸿蒙 dom2 运行时（本项目 vapor + bytecode 用的就是它）这几个几何属性全部走原生：
    // 拿不到时 `getBoundingClientRect()` 会 `?? new DOMRect()` 返回全 0，运气差还可能直接抛。
    // 而**事件监听器里抛出的异常会被运行时吞掉**（dispatchEvent 里是个空 catch），
    // 表现是「长按毫无反应」，极难定位 —— 所以整段兜起来，失败一律退化成 null。
    try {
        const rect = el.getBoundingClientRect()
        let width = rect.width
        let height = rect.height
        if (width <= 0 || height <= 0) {
            // 节点还没排版好时 rect 是 0，退回布局尺寸（布局坐标恒为逻辑像素）
            width = el.offsetWidth
            height = el.offsetHeight
        }
        if (width <= 0 || height <= 0) {
            return null
        }
        const ratio = pixelRatio()
        const candidates: ScreenRect[] = [
            new ScreenRect(rect.x, rect.y, width, height),
            new ScreenRect(rect.x / ratio, rect.y / ratio, width, height)
        ]
        for (let i = 0; i < candidates.length; i++) {
            const c = candidates[i]
            if (rectContainsPoint(c, probe)) {
                return c
            }
        }
        // 框不住触点 = 拿到的几何不可信，调用方有不依赖节点几何的后路。
        // 临时诊断（定位准了就删）：鸿蒙上想知道原生给回来的到底是全 0、还是别的坐标系里的
        // 有效值 —— 后者的话就能直接换算，不用绕布局坐标。android 命中候选后不会走到这里。
        console.log('[anchor] 节点矩形不可信 rect=', rect.x, rect.y, width, height,
            'probe=', probe.x, probe.y, 'ratio=', ratio)
        return null
    } catch (e) {
        console.log('getElementScreenRect: 读节点几何失败', e)
        return null
    }
}

/**
 * touch 事件里**全部**触点，单位统一成逻辑像素。
 *
 * [getTouchPoint] 只给一个点，双指缩放要同时拿到两根手指才能算距离和中点，所以单开一个。
 * 取的是 `touches`（当前仍按在屏上的触点）：touchend 时它已经不含抬起的那根手指，
 * 正好用来判断「双指变单指」。
 */
export function getTouchPoints(e: UniTouchEvent): TouchPoint[] {
    const scale = touchScale(e)
    const points: TouchPoint[] = []
    for (let i = 0; i < e.touches.length; i++) {
        const t = e.touches[i]
        points.push(new TouchPoint(t.clientX / scale, t.clientY / scale))
    }
    return points
}
