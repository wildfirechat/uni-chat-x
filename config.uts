export class ICEServer {
    uri: string
    userName: string
    password: string

    constructor(uri: string, userName: string, password: string) {
        this.uri = uri
        this.userName = userName
        this.password = password
    }
}

export default class Config {
    // 调试用
    static ENABLE_AUTO_LOGIN = true;
    // 是否支持多人音视频通话
    static ENABLE_MULTI_VOIP_CALL = false;
    // 是否支持1对1音视频通话
    static ENABLE_SINGLE_VOIP_CALL = false;

    static DEFAULT_PORTRAIT_URL = 'data:image/png;base64,';
    static DEFAULT_GROUP_PORTRAIT_URL = 'data:image/png;base64,'

    static DEFAULT_ORGANIZATION_PORTRAIT_URL = 'data:image/png;base64,';
    static DEFAULT_DEPARTMENT_PORTRAIT_URL = 'data:image/png;base64,';

    // 视频消息发送完成之前，无法拿到缩略图，故显示一个占位图，256x256
    static DEFAULT_VIDEO_POSTER = 'data:image/png;base64,'

    // 默认缩略图，200 x200，#d3d3d3
    static DEFAULT_THUMBNAIL_URL = 'data:image/png;base64,'

    // APP SERVER的地址，不能省略http(s)前缀。
    // 默认的app server使用端口是8888，注意端口号别忘记了。
    // 上线建议使用https，使用https更安全。
    //static APP_SERVER = 'http://wildfirechat.net:8888';
    static APP_SERVER = 'https://app.wildfirechat.net';

    // 组织结构服务地址，如果没有部署组织结构服务，或者不需要组织结构的话，可置为 ''
    // 组织结构项目：https://github.com/wildfirechat/organization-platform 或 https://gitee.com/wfchat/organization-platform
    static ORGANIZATION_SERVER = 'https://org.wildfirechat.net';

    // 工作台地址，如果不需要工作台，请删除 pages.json 里面，WorkspacePage 相关配置
    static WORKSPACE_URL = "https://open.wildfirechat.cn/work.html";

    // 语音转文字（ASR）服务地址。不走 IM 协议栈，客户端直接 POST 语音的 remoteUrl 过去。
    // 置空则消息长按菜单不显示「语音转文字」。
    static ASR_SERVER = 'https://app.wildfirechat.net/asr/api/recognize';

    // 实时语音输入服务地址（asr-api 的实时识别接口）。配置后输入框右侧显示麦克风按钮，按住说话时也可以滑到「转文字」；置空则关闭。
    // 连接时会在 header authCode 里带上 IM 认证码，由 asr-api 校验。内网测试也可以直连 wf-voice（如 ws://192.168.1.100:12436），
    // wf-voice 本身没有鉴权、不支持 wss，请勿暴露到公网。
    // 野火提供的测试服务会记录语音和识别出的文字，上线请部署自己的服务，参考 https://gitee.com/wfchat/asr-api
    // 目前只有鸿蒙端实现了（uni_modules/wfc-voice-input），Android / iOS 配了也不生效。
    static ASR_STREAM_SERVER = 'wss://app.wildfirechat.net/asr/api/stream';

    // 实时语音输入是否边说边出字。关闭时每说完一句才显示这句话；开启后服务端 CPU 占用更高，旧版 wf-voice 不支持（效果同关闭）。
    static ENABLE_ASR_PARTIAL_RESULT = true;

    // 群接龙服务地址。独立服务，不走 IM 协议栈，鉴权走 getAuthCode（见 api/authCodeApiClient.uts）。
    // 置空则群聊输入框的扩展面板不显示「群接龙」入口，接龙消息气泡也不再可点。
    static COLLECTION_SERVER = 'https://jielong.wildfirechat.net';

    // 群投票服务地址。独立服务，不走 IM 协议栈，鉴权走 getAuthCode（见 api/authCodeApiClient.uts）。
    // 置空则群聊输入框的扩展面板不显示「群投票」入口，投票消息气泡也不再可点。
    static POLL_SERVER = 'https://poll.wildfirechat.net';

    // 请仔细看注释
    // 仅仅是 HOST，没有 http 前缀，后面也没有端口
    // IM SERVER 的 host 地址，一定要和 APP_SERVER 对应起来，即 APP_SERVER 上配置的 im-server 和下面所配置的im-server 是同一个
    static IM_SERVER_HOST = 'wildfirechat.net'/** 请仔细看上面的注释，仅仅是 HOST，没有 http 前缀，后面也没有端口 **/;

    static QR_CODE_PREFIX_PC_SESSION = "wildfirechat://pcsession/";

    // turn server 配置，音视频功能暂未迁移，保留配置
    static ICE_SERVERS: ICEServer[] = [new ICEServer('turn:turn.wildfirechat.net:3478', 'wfchat', 'wfchat123')];
    static LANGUAGE = 'zh_CN';

    // 允许主动加入多人音视频通话
    static ENABLE_MULTI_CALL_AUTO_JOIN = true;

    // 是否启用语音对讲功能
    static ENABLE_PTT = true;

    // 是否启用音视频通话功能
    static ENABLE_VOIP = true;

    // 是否启用朋友圈功能。对齐 flutter `Config.ENABLE_MOMENTS` —— 关掉时发现页和用户详情页
    // 都不出现朋友圈入口。
    // ⚠️ 朋友圈依赖 `wfc.sendMomentsRequest`，目前只有鸿蒙端的原生插件导出了它，
    // android / iOS 的插件更新之前，那两端开着也会返回 254。
    static ENABLE_MOMENTS = true;

    // ---- 对讲(PTT) 相关配置，透传给 wfc-ptt-client 插件的 initClient ----
    // 是否支持双工模式，双工模式下，说话的时候，允许收听其他人的说话
    static PTT_ENABLE_FULL_DUPLEX = false;
    // 全局开启对讲功能，为 false 时，会话需要分别调用 pttClient.setEnablePtt 开启
    static PTT_ENABLE_GLOBAL_PTT = true;
    // 优先级模式：开启后一个会话里同一时间只允许一个人说话（优先级最高的那个）；关闭时按 MAX_SPEAKER_COUNT 允许多人同时说话
    static PTT_ENABLE_PRIORITY_MODE = false;
    // 单聊会话里，最多允许几个人同时说话（仅在非优先级模式下生效）
    static PTT_SINGLE_CHAT_MAX_SPEAKER_COUNT = 1;
    // 群聊会话里，最多允许几个人同时说话（仅在非优先级模式下生效）
    static PTT_GROUP_CHAT_MAX_SPEAKER_COUNT = 3;
    // 对讲时，是否额外保存一条语音消息到会话记录里
    static PTT_SINGLE_CHAT_SAVE_VOICE_MESSAGE = true;
    static PTT_GROUP_CHAT_SAVE_VOICE_MESSAGE = true;
    // 单次讲话最长时间，单位秒
    static PTT_SINGLE_CHAT_MAX_SPEAK_TIME = 60;
    static PTT_GROUP_CHAT_MAX_SPEAK_TIME = 60;

    static SDK_PLATFORM_WINDOWS = 3;
    static SDK_PLATFORM_OSX = 4;
    static SDK_PLATFORM_WEB = 5;
    static SDK_PLATFORM_WX = 6;

    // uni-app 默认录音格式为mp3
    // 只有移动端时，录音可以直接播放，可将下面的AMR_TO_MP3_SERVER_ADDRESS置为""
    static AMR_TO_MP3_SERVER_ADDRESS = "";
    // 文件传输助手ID
    static FILE_HELPER_ID = 'wfc_file_transfer';

    /**
     * AI 机器人账号。这些账号 `isMyFriend` 恒为 true，但没有音视频能力，
     * 用户详情页不给它们显示通话入口。对齐 flutter `Config.AI_ROBOTS`。
     */
    static AI_ROBOTS = ['FireRobot'];

    static isAiRobot(userId: string): boolean {
        return Config.AI_ROBOTS.indexOf(userId) >= 0;
    }

    // 用户协议和隐私政策，上线前请替换成您自己的内容。
    // 登录页的勾选项和「我的 → 设置」里的两行都读这两个值。
    static USER_AGREEMENT_URL = 'https://static.wildfirechat.cn/agreement.html';
    static PRIVACY_AGREEMENT_URL = 'https://static.wildfirechat.cn/privacy.html';

    /**
     * 发验证码/登录/改密码前是否要过滑块验证。对齐 flutter `Config.ENABLE_SLIDE_VERIFY`。
     * 需要 app server 提供 `/slide_verify/generate` 与 `/slide_verify/verify`。
     */
    static ENABLE_SLIDE_VERIFY = true;

    /** 登录页默认用密码登录还是验证码登录。对齐 flutter `Config.Prefer_Password_Login`。 */
    static PREFER_PASSWORD_LOGIN = false;

    // 发送日志命令，当发送此文本消息时，会把协议栈日志发送到当前会话中，为空时关闭此功能。
    static SEND_LOG_COMMAND = '*#marslog#';

    /**
     * 是否开启全局安全水印（用户ID + 时间，倾斜平铺在页面之上）。
     * 对齐 flutter `Config.ENABLE_WATER_MARKER`。
     *
     * ⚠️ 关掉它只是让 `<watermark-overlay />` 渲染成空，节点还挂在每个页面模板里。
     * 新增页面要记得跟着挂一个，否则那一页没有水印，见
     * [components/watermark-overlay/watermark-overlay.uvue](components/watermark-overlay/watermark-overlay.uvue)。
     */
    static ENABLE_WATER_MARKER = true;

    /**
     * 允许重新编辑多长时间内的撤回消息，单位是秒
     */
    static RECALL_REEDIT_TIME_LIMIT = 60;

    static platform = -1;

    static getWFCPlatform(): number {
        if (Config.platform > 0) {
            return Config.platform;
        }
        const info = uni.getSystemInfoSync();
        if (info.osName == 'ios' || info.platform == 'ios') {
            Config.platform = info.deviceType != 'phone' ? 8 : 1;
        } else if (info.osName == 'android' || info.platform == 'android') {
            Config.platform = info.deviceType != 'phone' ? 9 : 2;
        } else {
            Config.platform = 10;
        }
        return Config.platform;
    }

    /**
     * 双网媒体地址前缀，用于头像/媒体类消息中的 URL 转换。对齐 flutter
     * `Config.MAIN_MEDIA_URL_PREFIX` / `BACKUP_MEDIA_URL_PREFIX`。
     *
     * 只在政企内外双网部署时配置，两个都配上才生效；不需要双网就保持空字符串。
     * 实际的前缀互换在 [common/mediaUrlRedirector.uts](common/mediaUrlRedirector.uts)，
     * 当前连的是主网还是备网由协议栈的 onConnectToServer 回调告知。
     */
    static MAIN_MEDIA_URL_PREFIX = '';
    static BACKUP_MEDIA_URL_PREFIX = '';

    /**
     * 网络地址重定向 —— 留给使用者自己改写地址的钩子，默认原样返回。
     *
     * ⚠️ 双网环境的主/备前缀互换**不在这里**，见上面两个 PREFIX 和
     * [common/mediaUrlRedirector.uts](common/mediaUrlRedirector.uts)：
     * `redirectMediaUrl()` 会先做前缀互换，再调一次本方法，两者互不影响。
     * 业务代码要转 URL 请调 `redirectMediaUrl()`，不要直接调这里。
     */
    static urlRedirect(url: string): string {
        if (url == '') {
            return url;
        }
        // 示例代码
        // url = url.replace('oss.xxxx.com', '192.168.2.19');
        return url;
    }

    /**
     * 表情 base 路径，一定要求以 / 结尾
     */
    static emojiBaseUrl(): string {
        return 'https://static.wildfirechat.net/twemoji/assets/';
    }

    /**
     * 动态表情 base 路径，一定要求以 / 结尾
     */
    static stickerBaseUrl(): string {
        return 'https://static.wildfirechat.net/sticker/';
    }
}
