{
  "modelVersion": "5.0.0",
  "name": "template",
  "version": "1.0.0",
  "description": "Please describe the basic information.",
  "main": "",
  "author": "",
  "license": "",
  // 注意：本文件会和编译器生成的 oh-package.json5 **合并**（不是覆盖），
  // @uni_modules/*、@dcloudio/uni-app-x-runtime 这些由编译器自动写入，不用也不要在这里重复声明。
  // 这里只放项目自己的原生依赖。
  //
  // 被多个 uts 插件共用的 har 也要放这里，不能写进各插件的 config.json：插件 config.json 里的依赖只链接进
  // 该插件自己的 oh_modules，别的插件解析不到；各带一份又会按路径装出两个同名同版本的包。
  //   @wfc/client —— harmony-configs/wfcclient 打出来的适配层，wfc-av-client 和 wfc-ptt-client 共用
  //   @wfc/ptt    —— 对讲 SDK（取自 hm-chat），wfc-ptt-client 用它对讲，wfc-voice-input 用它的 AMR 编码
  "dependencies": {
    "@uni_modules/wfc-client": "./uni_modules/wfc-client",
     "@wfc/marswrapper": "file:./libs/marswrapper.har",
    "@wfc/client": "file:./libs/wfcclient.har",
    "@wfc/ptt": "file:./libs/ptt.har",
    "@ohos/pinyin4js": "^2.0.0"
  },
  "devDependencies": {
    "@ohos/hypium": "1.0.19",
    "@ohos/hamock": "1.0.0"
  },
  "dynamicDependencies": {}
}
