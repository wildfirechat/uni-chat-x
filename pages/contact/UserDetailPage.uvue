<template>
    <view class="user-detail-page" :style="{ backgroundColor: c.primaryBackground }">
        <NavBar :title="t('user.user_info')" :showBack="true" :rightIcon1="isSelf ? '' : moreIcon"
            @right1Tap="openMoreMenu" />

        <scroll-view v-if="user != null" class="page-scroll" direction="vertical">
            <!-- 头像 + 名字 + 备注 + 野火号 -->
            <view class="header" :style="{ backgroundColor: c.surface }">
                <image class="header-portrait" :src="(user as UserInfo).portrait" :style="{ backgroundColor: c.inputBg }" />
                <view class="header-text">
                    <text class="header-name single-line" :style="{ fontSize: fontPx(16), color: c.textPrimary }">{{ displayName }}</text>
                    <text v-if="aliasLine != ''" class="header-sub single-line"
                        :style="{ fontSize: fontPx(12), color: c.textSecondary }">{{ aliasLine }}</text>
                    <view class="header-id-row">
                        <text class="header-sub single-line" :style="{ fontSize: fontPx(12), color: c.textSecondary }">{{ wildfireIdLine }}</text>
                        <!-- 星标朋友标记，对齐 flutter 的 Icons.star(amber) -->
                        <text v-if="isFriend && isStarred" class="icomoon star-icon" :style="{ color: '#FFC107', fontSize: iconPx(14) }">&#xf2fc;</text>
                    </view>
                </view>
            </view>

            <!-- 所在组织。没有从属关系时整段不展示 -->
            <template v-if="organizations.length > 0">
                <section-divider />
                <view :style="{ backgroundColor: c.surface }">
                    <option-item v-for="(org, index) in organizations" :key="index" :title="org.name"
                        :showBottomDivider="index < organizations.length - 1" @tap="openOrganization(org)" />
                </view>
            </template>

            <section-divider v-if="supportMoments" />
            <view v-if="supportMoments" :style="{ backgroundColor: c.surface }">
                <option-item :title="t('moment.entry')" :showBottomDivider="false" @tap="openMoments" />
            </view>

            <section-divider />
            <view :style="{ backgroundColor: c.surface }">
                <option-item v-if="isSelf" :title="t('user.modify_nickname')" :showBottomDivider="false"
                    @tap="editDisplayName" />
                <option-item v-else-if="isFriend" :title="t('user.set_alias')" :desc="(user as UserInfo).friendAlias"
                    :showBottomDivider="false" @tap="editAlias" />
            </view>

            <section-divider />
            <view :style="{ backgroundColor: c.surface }">
                <option-button-item :title="isSelf || isFriend ? t('user.send_msg') : t('friend_request.add_friend')"
                    tone="accent" :showBottomDivider="showCallAction" @tap="onPrimaryAction" />
                <option-button-item v-if="showCallAction" :title="t('user.audio_video_call')" tone="accent"
                    :showBottomDivider="false" @tap="showCallSheet = true" />
            </view>
            <view class="bottom-gap"></view>
        </scroll-view>

        <bottom-action-sheet v-model="showCallSheet" :items="callSheetItems" @select="onCallSheetSelect" />
        <dropdown-menu v-model="showMoreMenu" :items="moreMenuItems" @select="onMoreMenuSelect"
            :targetX="moreMenuX" :targetY="moreMenuY" />
        <watermark-overlay />
    </view>
</template>

<script setup lang="uts">
/**
 * 用户详情页。对齐 `../flutter-chat/chat/lib/user_info_widget.dart` 的移动端形态
 * （`_buildMobileBody`）：凹槽灰底 + 白卡片分组。
 *
 * 改版前这一页是「备注名/野火ID/地区/标签」四行表格 + 底部一排图标动作，和 flutter 完全不是
 * 一个版式，也没有黑名单、星标朋友、所在组织。
 *
 * ## 刻意没做的两项
 *
 * - **更多信息**：flutter 有这一行，但点了只是 `showToast(methodNotImpl)` —— 它自己也没实现。
 *   按 §M2「宁可不放入口，也不放一个点了弹『暂未实现』的行」，这里不放。
 * 朋友圈入口（M6）已补，同样由 `Config.ENABLE_MOMENTS` 控制。
 *
 * ## 与 flutter 的刻意差异
 *
 * - flutter 的「删除好友」二次确认是 AlertDialog，这里走 showConfirmDialog（同项目其他页）
 *
 * ## 右上角菜单
 *
 * flutter 这里是 `PopupMenuButton`——系统风格的浅色竖排文字下拉，不是消息长按那套深色图标网格。
 * 之前这页图省事复用了深色网格 popup-menu，视觉上和 flutter 差太远；改用
 * [dropdown-menu](@/components/dropdown-menu/dropdown-menu.uvue)，跟随主题的浅色竖排列表，
 * 对齐 flutter 观感。菜单项集合与 flutter 一致。
 */
import NavBar from "@/pages/common/NavBar.uvue";
import store, { contactState } from "@/store.uts";
import Config from "@/config.uts";
import ConversationType from "@/wfc/model/conversationType.uts";
import Conversation from "@/wfc/model/conversation.uts";
import UserInfo from "@/wfc/model/userInfo.uts";
import ModifyMyInfoEntry from "@/wfc/model/modifyMyInfoEntry.uts";
import ModifyMyInfoType from "@/wfc/model/modifyMyInfoType.uts";
import wfc from "@/wfc/client/wfc.uts";
import organizationServerApi from "@/api/organizationServerApi.uts";
import { Organization, EmployeeEx, OrganizationRelationship } from "@/api/organizationModel.uts";
import { go2ConversationPage } from "@/common/nav.uts";
import { PopupMenuItem } from "@/common/popupMenu.uts";
import { ActionSheetItem } from "@/components/bottom-action-sheet/actionSheetItem.uts";
import { showEditDialog, showConfirmDialog, toast, toastError } from "@/common/prompt.uts";
import { startSingleCall } from "@/common/avcall.uts";
import { t, t1 } from "@/i18n/i18n.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx, iconPx } from "@/common/layoutScale.uts";

defineOptions({
    name: "UserDetailPage"
})

const c = computed<AppColors>((): AppColors => colors())
// 三个点，与 ConversationPage 的「更多」入口同一个字形；原先这里错用了播放按钮的字形
const moreIcon = ref<string>('')

const user = ref<UserInfo | null>(contactState.currentFriend as UserInfo | null)
const isStarred = ref<boolean>(false)
const isBlacklisted = ref<boolean>(false)
const organizations = ref<Organization[]>([] as Organization[])

const supportMoments = Config.ENABLE_MOMENTS

const openMoments = () => {
    const u = user.value
    if (u == null) {
        return
    }
    uni.navigateTo({
        url: '/pages/moment/MomentFeedListPage?userId=' + (u as UserInfo).uid,
        fail: (err) => {
            console.log('nav to moment page fail', err)
        }
    } as NavigateToOptions)
}

const showCallSheet = ref<boolean>(false)
const showMoreMenu = ref<boolean>(false)
const moreMenuX = ref<number>(0)
const moreMenuY = ref<number>(0)

const displayName = computed<string>((): string => {
    const friend = user.value;
    if (friend == null) {
        return '';
    }
    return friend.displayName != '' ? friend.displayName : friend.name;
})

const isFriend = computed<boolean>((): boolean => {
    const friend = user.value
    return friend != null && wfc.isMyFriend(friend.uid);
})

/** 有备注时单独一行「备注:xxx」，对齐 flutter 的 nameList */
const aliasLine = computed<string>((): string => {
    const friend = user.value
    if (friend == null || !isFriend.value || friend.friendAlias == '') {
        return ''
    }
    return t('common.alias') + ':' + friend.friendAlias
})

const wildfireIdLine = computed<string>((): string => {
    const friend = user.value
    return friend == null ? '' : t1('user.wildfire_id', friend.name)
})

const isSelf = computed<boolean>((): boolean => {
    const friend = user.value
    return friend != null && friend.uid == wfc.getUserId();
})

/** 给自己打电话没意义；机器人也没有音视频能力（对齐 flutter 的 AI_ROBOTS 判断） */
const showCallAction = computed<boolean>((): boolean => {
    return isFriend.value && !isSelf.value && !Config.isAiRobot(user.value?.uid ?? '')
})

const callSheetItems = computed<ActionSheetItem[]>((): ActionSheetItem[] => {
    const video = new ActionSheetItem(t('user.video_call'), 'video')
    video.icon = ''
    const audio = new ActionSheetItem(t('user.audio_call'), 'audio')
    audio.icon = ''
    return [video, audio]
})

/** 菜单项集合与 flutter `_handleMenuSelection` 的 itemBuilder 一致 */
const moreMenuItems = computed<PopupMenuItem[]>((): PopupMenuItem[] => {
    const items: PopupMenuItem[] = []
    items.push(new PopupMenuItem(isBlacklisted.value ? t('user.remove_from_blacklist') : t('user.add_to_blacklist'),
        'blacklist', ''))
    if (isFriend.value) {
        items.push(new PopupMenuItem(isStarred.value ? t('user.cancel_starred') : t('user.set_starred'),
            'star', ''))
        items.push(new PopupMenuItem(t('user.delete_friend'), 'delete', ''))
    } else {
        items.push(new PopupMenuItem(t('friend_request.add_friend'), 'add_friend', ''))
    }
    return items
})

/**
 * 「所在组织」只显示末级部门（`bottom == true` 的从属关系），与 flutter 一致。
 * 没配组织服务就整段不展示。
 */
const loadOrganizations = (userId: string) => {
    if (Config.getOrganizationServer() == '') {
        return
    }
    organizationServerApi.getEmployeeExInfo(userId)
        .then((ex: EmployeeEx | null): void => {
            if (ex == null) {
                return
            }
            const bottomIds: number[] = []
            for (let i = 0; i < ex.relationships.length; i++) {
                const rel: OrganizationRelationship = ex.relationships[i]
                if (rel.bottom) {
                    bottomIds.push(rel.organizationId)
                }
            }
            if (bottomIds.length == 0) {
                return
            }
            organizationServerApi.getOrganizationList(bottomIds)
                .then((orgs: Organization[]): void => {
                    organizations.value = orgs
                })
                .catch((err): void => {
                    console.log('getOrganizations error', err)
                })
        })
        .catch((err): void => {
            console.log('getEmployeeEx error', err)
        })
}

const chat = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    const conversation = new Conversation(ConversationType.Single, friend.uid, 0);
    store.setCurrentConversation(conversation);
    go2ConversationPage();
}

onMounted(() => {
    const friend = user.value
    if (friend == null) {
        return
    }
    wfc.getUserInfo(friend.uid, true);
    isStarred.value = wfc.isFavUser(friend.uid)
    isBlacklisted.value = wfc.isBlackListed(friend.uid)
    loadOrganizations(friend.uid)
})

onUnload(() => {
    store.setCurrentFriend(null);
})

const openOrganization = (_org: Organization) => {
    // 组织架构页自己从根部门进，参数只用于将来定位；当前与 flutter 一样是整页打开
    uni.navigateTo({
        url: '/pages/contact/OrganizationPage',
        fail: (err) => {
            console.log('nav to OrganizationPage err', err)
        }
    } as NavigateToOptions)
}

const openMoreMenu = () => {
    // 菜单锚在标题栏右上角（没有 element API 拿不到按钮矩形，用窗口宽度反推）
    const sysInfo = uni.getSystemInfoSync()
    moreMenuX.value = sysInfo.windowWidth - 24
    moreMenuY.value = sysInfo.statusBarHeight + 44
    showMoreMenu.value = true
}

const openInviteFriend = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    uni.navigateTo({
        url: '/pages/contact/InviteFriendPage?userId=' + friend.uid,
        fail: (err) => {
            console.log('nav to InviteFriendPage err', err)
        }
    } as NavigateToOptions)
}

const onPrimaryAction = () => {
    if (isSelf.value || isFriend.value) {
        chat()
    } else {
        openInviteFriend()
    }
}

const onCallSheetSelect = (item: ActionSheetItem) => {
    const friend = user.value
    if (friend == null) {
        return
    }
    startSingleCall(friend.uid, item.tag == 'audio')
}

const toggleBlacklist = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    const next = !isBlacklisted.value
    wfc.setBlackList(friend.uid, next, () => {
        isBlacklisted.value = next
        toast(t('common.operate_success'))
    }, (err: number) => {
        toastError(err)
    })
}

const toggleStar = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    const next = !isStarred.value
    // 星标状态还要带动通讯录的「星标朋友」分组，走 store 统一处理
    store.setFavUser(friend.uid, next, () => {
        isStarred.value = next
        toast(t('common.operate_success'))
    }, (err: number) => {
        toastError(err)
    })
}

const editDisplayName = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    showEditDialog(t('user.modify_nickname'), friend.displayName, t('user.input_nickname'), (value: string) => {
        wfc.modifyMyInfo([new ModifyMyInfoEntry(ModifyMyInfoType.Modify_DisplayName, value)], () => {
            toast(t('common.operate_success'))
            user.value.displayName = value
        }, (err: number) => {
            toastError(err)
        })
    })
}

const editAlias = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    showEditDialog(t('user.set_alias'), friend.friendAlias, t('user.input_alias'), (value: string) => {
        wfc.setFriendAlias(friend.uid, value, () => {
            toast(t('common.operate_success'))
            user.value.friendAlias = value
        }, (err: number) => {
            toastError(err)
        })
    })
}

const deleteFriend = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    // 走 store.deleteFriend 而不是直接 wfc.deleteFriend：删好友之后那条单聊会话
    // 也要从会话列表里清掉，这一步只有 store 那个方法做了。直接调 wfc 的话好友删了、
    // 会话还留在列表里。失败的 toast 也由 store 统一发，这里不要再发一遍。
    showConfirmDialog(t('user.delete_friend'), t('user.delete_friend_confirm'), true, () => {
        store.deleteFriend(friend.uid, () => {
            toast(t('common.operate_success'))
            setTimeout(() => {
                uni.navigateBack({} as NavigateBackOptions)
            }, 800)
        })
    })
}

const onMoreMenuSelect = (item: PopupMenuItem) => {
    switch (item.tag) {
        case 'blacklist':
            toggleBlacklist()
            break
        case 'star':
            toggleStar()
            break
        case 'delete':
            deleteFriend()
            break
        case 'add_friend':
            openInviteFriend()
            break
    }
}

</script>

<style scoped>
/* 页面默认 styleIsolation: 'app' 能吃到全局 .icomoon，但这一页有独立组件插槽，
 * 保险起见自己声明一份（见 M0「写组件的两个静默坑」） */
.icomoon {
    font-family: "icomoon";
}

.user-detail-page {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.page-scroll {
    flex: 1;
}

.header {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
    min-height: 80px;
}

.header-portrait {
    width: 60px;
    height: 60px;
    border-radius: 6px;
    margin-right: 16px;
    flex-shrink: 0;
}

.header-text {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.header-name {
    text-align: left;
}

.header-sub {
    margin-top: 3px;
    text-align: left;
}

.header-id-row {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.star-icon {
    margin-left: 4px;
    flex-shrink: 0;
}

/* 最后一组卡片下面留一段凹槽，不然卡片直接贴到屏幕底 */
.bottom-gap {
    height: 16px;
}
</style>
