<template>
    <view class="conversation-page">
        <NavBar :title="navTitle" :titleIcon="navTitleIcon" :subtitle="navSubtitle" :showBack="true"
            :rightIcon1="conversationInfo != null ? moreIcon : ''" @right1Tap="showConversationInfo" />
        <view v-if="conversationInfo == null" class="conversation-empty-container">
            <text>^~^</text>
        </view>
        <view v-else class="conversation-content-container" :style="{ backgroundColor: c.conversationBg }">
            <view class="message-list-container">
                <!-- 倒置渲染：scroll-view 整体 rotate(180deg)，每个 message-item 再各自转回来，
                     渲染的是倒序列表 renderMessageList。于是「最新一条消息」落在滚动内容偏移 0 处，
                     转过来正好显示在视觉底部；「加载历史消息」变成往滚动内容**末尾**追加，
                     已有内容一格都不动，不需要任何位置补偿，闪烁从根上消失。
                     取舍、坐标换算和已知代价见下面 loadHistoryMessages 上方的注释。 -->
                <scroll-view ref="messageListEl" class="message-list" direction="vertical"
                    :show-scrollbar="false" @scroll="onMessageListScroll" @touchstart="onTouchStart"
                    @touchmove="onTouchMove" @tap="hideKeyboardAndPanel">
                    <!-- :key 必须是 index，不能用 messageId，理由见下面 loadHistoryMessages 上方的注释 -->
                    <view v-for="(message, index) in renderMessageList" :id="'id-' + message.messageId" :key="index"
                        class="message-item"
                        :style="{ backgroundColor: message.messageId == highlightMessageId ? c.messageHighlight : 'transparent' }"
                        @tap="clickMessageItem(message)">
                        <NotificationMessageContentView :message="message" v-if="isNotificationMessage(message)" />
                        <RecallNotificationMessageContentView :message="message"
                            v-else-if="isRecallNotificationMessage(message)" />
                        <ContextableNotificationMessageContentContainerView :message="message"
                            v-else-if="isContextableNotificationMessage(message)" />
                        <NormalOutMessageContentView :message="message" v-else-if="message.direction == 0" />
                        <NormalInMessageContentView :message="message" v-else />
                    </view>
                </scroll-view>
                <view v-if="showUnreadLabel" class="unread-label-container">
                    <view v-if="unreadMentionCount > 0" class="unread-label"
                        :style="{ backgroundColor: c.surface, borderColor: c.hairline }" @tap="locateFirstUnreadMention">
                        <text class="unread-label-text" :style="{ fontSize: fontPx(12), color: c.accent }">有 {{ unreadMentionCount }} 条@我的消息</text>
                    </view>
                    <view v-if="showUnreadCountLabel" class="unread-label"
                        :style="{ backgroundColor: c.surface, borderColor: c.hairline }" @tap="locateFirstUnread">
                        <text class="unread-label-text" :style="{ fontSize: fontPx(12), color: c.accent }">{{ unreadCount }} 条未读消息</text>
                    </view>
                    <text class="unread-label-close icomoon" :style="{ color: c.textSecondary }"
                        @tap="hideUnreadLabel">&#xf12a;</text>
                </view>
                <view v-if="hasMoreNewMessages" class="back-to-latest"
                    :style="{ backgroundColor: c.surface, borderColor: c.hairline }" @tap="backToLatest">
                    <text class="back-to-latest-text" :style="{ fontSize: fontPx(12), color: c.accent }">回到最新消息</text>
                </view>
            </view>
            <popup-menu v-model="showContextMenu" :items="contextMenuItems" @select="onContextMenuItemSelect"
                :targetX="contextMenuX" :targetY="contextMenuY" :targetHeight="contextMenuHeight" />
            <MessageInputView v-if="!enableMessageMultiSelection" :conversationInfo="conversationInfo"
                class="message-input-container" ref="messageInputView" @panelShow="scrollToBottom" />
            <MultiSelectActionView v-if="enableMessageMultiSelection" />
        </view>
        <watermark-overlay />
    </view>
</template>

<script setup lang="uts">
import NavBar from "@/pages/common/NavBar.uvue";
import MessageInputView from "@/pages/conversation/MessageInputView.uvue";
import NormalOutMessageContentView from "@/pages/conversation/message/NormalOutMessageContentContainerView.uvue";
import NormalInMessageContentView from "@/pages/conversation/message/NormalInMessageContentContainerView.uvue";
import NotificationMessageContentView from "@/pages/conversation/message/NotificationMessageContentView.uvue";
import RecallNotificationMessageContentView from "@/pages/conversation/message/RecallNotificationMessageContentView.uvue";
import ContextableNotificationMessageContentContainerView from "./message/ContextableNotificationMessageContentContainerView.uvue";
import MultiSelectActionView from "@/pages/conversation/MessageMultiSelectActionView.uvue";
import NotificationMessageContent from "@/wfc/messages/notification/notificationMessageContent.uts";
import RichNotificationMessageContent from "../../wfc/messages/notification/richNotificationMessageContent.uts";
import ArticlesMessageContent from "../../wfc/messages/articlesMessageContent.uts";
import TextMessageContent from "@/wfc/messages/textMessageContent.uts";
import SoundMessageContent from "@/wfc/messages/soundMessageContent.uts";
import TypingMessageContent from "@/wfc/messages/typingMessageContent.uts";
import MessageContentType from "@/wfc/messages/messageContentType.uts";
import Message from "@/wfc/messages/message.uts";
import ConversationInfo from "@/wfc/model/conversationInfo.uts";
import ConversationType from "@/wfc/model/conversationType.uts";
import ConnectionStatus from "@/wfc/client/connectionStatus.uts";
import GroupMemberType from "@/wfc/model/groupMemberType.uts";
import store, { conversationState, miscState } from "@/store.uts";
import wfc from "../../wfc/client/wfc.uts";
import Config from "../../config.uts";
import { getItem, setItem } from "../util/storageHelper.uts";
import { copyText } from "@/pages/util/clipboard.uts";
import { PopupMenuItem } from "@/common/popupMenu.uts";
import { navigateToPage } from "@/common/nav.uts";
import { forward } from "@/common/forward.uts";
import { isSavableMessage, isSaveToAlbumMessage, saveMessageMedia } from "@/common/mediaSaver.uts";
import ForwardType from "@/pages/conversation/message/forward/ForwardType.uts";
import eventBus from "@/common/eventBus.uts";
import { getTouchPoint, getElementScreenRect, rectContainsPoint, ScreenRect, TouchPoint } from "@/common/touch.uts";
import { OpenMessageContextMenuEvent } from "./message/messageEvents.uts";
import { isAsrEnabled, speechToText } from "@/common/asr.uts";
import { isEarpieceMode, setEarpieceMode, applyAudioRoute } from "@/common/audioPlayMode.uts";
import { isFavoriteAble, favoriteMessage } from "@/common/favorite.uts";
import { report } from "@/common/report.uts";
import FileMessageContent from "@/wfc/messages/fileMessageContent.uts";
import panServerApi from "@/api/panServerApi.uts";
import { isOnlineDocName } from "@/api/panDocUrl.uts";
import { saveFileMessageToMyPan } from "@/common/panSave.uts";
import { openDocByUrl } from "@/common/panFileOpen.uts";
import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
import { t, t1 } from "@/i18n/i18n.uts";

let innerAudioContext: InnerAudioContext | null = null;

defineOptions({
    name: 'ConversationPage'
})

const c = computed<AppColors>((): AppColors => colors())

const moreIcon = ref<string>('')

const isScroll = ref<boolean>(false)
const touchStartX = ref<number>(0)
const touchStartY = ref<number>(0)

const showContextMenu = ref<boolean>(false)
// 菜单的锚：横向锚在触点上（targetX + 宽 0），纵向锚在整条气泡上（targetY/targetHeight），
// 理由见 showMessageContextMenu
const contextMenuX = ref<number>(0)
const contextMenuY = ref<number>(0)
const contextMenuHeight = ref<number>(0)
const contextMenuItems = ref<PopupMenuItem[]>([] as PopupMenuItem[])
const contextMenuMessage = ref<Message | null>(null)

const keyboardHeight = ref<number>(0)
const freshing = ref<boolean>(false)
const loadingNewMessages = ref<boolean>(false)

// 最后一次手指碰消息列表的时间，scrollToBottom 的延迟兜底靠它避让用户操作
let lastTouchMessageListAt = 0

// 与原生一致：未读数超过 10 条才显示顶部提示条
const UNREAD_LABEL_MIN_COUNT = 10
const UNREAD_LABEL_MAX_COUNT = 300
const unreadLabelDismissed = ref<boolean>(false)
let highlightClearTimer = 0
let keyboardHeightChangeId = 0

// onUnload 时会清空 store 里的当前会话，而此时页面关闭动画才刚开始，页面仍在渲染，
// 直接渲染 store 数据会导致整个页面瞬间变白(白屏动画滑出后才看到会话列表)。
// 所以关闭时冻结渲染，用关闭前的数据副本，保证动画期间页面内容不变。
const closing = ref<boolean>(false)
const closingConversationInfo = ref<ConversationInfo | null>(null)
const closingMessageList = ref<Message[]>([] as Message[])

const messageInputView = ref<ComponentPublicInstance | null>(null)
// 消息列表 scroll-view 的原生元素，scrollToBottom / scrollToMessage 要直接操作它的滚动偏移
const messageListEl = ref<UniElement | null>(null)

const conversationInfo = computed<ConversationInfo | null>((): ConversationInfo | null => {
    return closing.value ? closingConversationInfo.value : conversationState.currentConversationInfo
})

const messageList = computed<Message[]>((): Message[] => {
    return closing.value ? closingMessageList.value : conversationState.currentConversationMessageList
})

/**
 * 真正丢给 v-for 的列表：messageList 的倒序副本（最新一条在 0）。
 *
 * 配合 .message-list / .message-item 上的 rotate(180deg)，倒序渲染的结果在视觉上仍然是
 * 「老消息在上、新消息在下」，但在**滚动内容坐标系**里方向反了过来：
 *   - 内容偏移 0 = 最新一条 = 视觉底部
 *   - 内容偏移越大 = 消息越老 = 视觉越靠上
 * 于是 store 往列表头部插历史消息，落到这里就是往数组**末尾**追加，
 * 对应 scroll-view 里「在已有内容下方接一段」，已有内容的布局位置完全不变。
 *
 * ⚠️ 不要用 reverse()：它原地修改数组，会把 store 里的列表也翻掉。
 */
const renderMessageList = computed<Message[]>((): Message[] => {
    const list = messageList.value
    const reversed: Message[] = []
    for (let i = list.length - 1; i >= 0; i--) {
        reversed.push(list[i])
    }
    return reversed
})

const enableMessageMultiSelection = computed<boolean>((): boolean => {
    return conversationState.enableMessageMultiSelection
})

const highlightMessageId = computed<number>((): number => {
    return conversationState.highlightMessageId
})

const hasMoreNewMessages = computed<boolean>((): boolean => {
    return conversationState.hasMoreNewMessages
})

const unreadCount = computed<number>((): number => {
    return conversationState.enterUnreadCount
})

const unreadMentionCount = computed<number>((): number => {
    return conversationState.enterUnreadMentionCount
})

const showUnreadCountLabel = computed<boolean>((): boolean => {
    return unreadCount.value > UNREAD_LABEL_MIN_COUNT && unreadCount.value < UNREAD_LABEL_MAX_COUNT
})

const showUnreadLabel = computed<boolean>((): boolean => {
    if (unreadLabelDismissed.value) {
        return false
    }
    return unreadMentionCount.value > 0 || showUnreadCountLabel.value
})

const conversationTitle = computed<string>((): string => {
    const info = conversationInfo.value;
    if (info == null) {
        return ''
    }
    const target = store.ensureConversationTarget(info.conversation)
    return target != null ? target._displayName : '';
})

const targetUserOnlineStateDesc = computed<string>((): string => {
    const info = conversationInfo.value;
    // 必须走 store.ensureTargetOnlineStateDesc：在线状态存在 store 的普通 Map 里，
    // 只有它才会先读一次 onlineStateVersion 建立响应式依赖。
    return info != null ? store.ensureTargetOnlineStateDesc(info.conversation) : '';
})

// 「对方正在输入」，与原生 ConversationFragment#updateTypingStatusTitle 对齐
const typingDesc = computed<string>((): string => {
    const user = conversationState.inputtingUser
    const info = conversationInfo.value
    if (user == null || info == null) {
        return ''
    }
    const conversationType = info.conversation.type
    if (conversationType != ConversationType.Single && conversationType != ConversationType.Group) {
        return ''
    }
    let desc: string
    switch (conversationState.inputtingTypingType) {
        case TypingMessageContent.TYPING_VOICE:
            desc = '正在录音'
            break;
        case TypingMessageContent.TYPING_CAMERA:
            desc = '正在拍照'
            break;
        case TypingMessageContent.TYPING_LOCATION:
            desc = '正在发送位置'
            break;
        case TypingMessageContent.TYPING_FILE:
            desc = '正在发送文件'
            break;
        default:
            desc = '正在输入'
            break;
    }
    if (conversationType == ConversationType.Group) {
        const name = user._displayName != '' ? user._displayName : user.displayName
        return (name != '' ? name : '有人') + ' ' + desc
    }
    return '对方' + desc
})

// 群会话的副标题兜底：群人数。和 android-chat 的「群名(N)」是同一份信息，
// 只是挪到了副标题行。有了它，群会话的标题栏稳定是两行，不会因为「正在输入」
// 来一下走一下就在一行/两行之间跳。群资料还没解析出来时 memberCount 是 0，返回空串。
const groupMemberCountDesc = computed<string>((): string => {
    const info = conversationInfo.value
    if (info == null || info.conversation.type != ConversationType.Group) {
        return ''
    }
    const target = store.ensureConversationTarget(info.conversation)
    if (target == null || target.memberCount <= 0) {
        return ''
    }
    return t1('group.member_count', '' + target.memberCount)
})

// 连接状态。会话列表页把它做成标题栏下面的独立一条（见 ConversationListPage），
// 会话页没地方挂那条横幅（挂上去消息列表就要跟着上下跳），塞进副标题正好。
const connectionStatusDesc = computed<string>((): string => {
    let desc = ''
    switch (miscState.connectionStatus) {
        case ConnectionStatus.ConnectionStatusConnecting:
            desc = '正在连接...'
            break;
        case ConnectionStatus.ConnectionStatusReceiveing:
            desc = '正在同步...'
            break;
        case ConnectionStatus.ConnectionStatusUnconnected:
            desc = '连接失败'
            break;
        default:
            break;
    }
    return desc
})

/**
 * 标题行只放**会话身份**：名字 + 会话自身的持久属性标识（免打扰、听筒播放）。
 * 「正在输入」「在线状态」这类会来回闪的东西一律进副标题 —— 改造前它们是直接顶掉
 * 标题文字的，对方一敲键盘会话名就没了，从标题栏认不出自己在跟谁说话。
 */
const navTitle = computed<string>((): string => conversationTitle.value)

/**
 * 标题行的状态标识，按「会话属性 → 本机播放通道」排：
 *   免打扰   \uf39a  ion-android-notifications-off，和会话列表行用的是同一个字形
 *   听筒播放 \uf4b9  同 android-chat 的 ConversationTitleHelper（它画的是自绘的耳朵
 *                   vector，icomoon 里没有耳朵，用和长按菜单同一个听筒字形，两处能对上）
 * 两个都在时拼成一个字符串交给 NavBar，中间那个空格就是它们的间距。
 */
const navTitleIcon = computed<string>((): string => {
    const icons: string[] = []
    const info = conversationInfo.value
    if (info != null && info.isSilent) {
        icons.push('\uf39a')
    }
    if (isEarpieceMode()) {
        icons.push('\uf4b9')
    }
    return icons.join(' ')
})

/**
 * 副标题：会话身份之外、随时会变的状态。同一时刻只显示一条，按「越临时越靠前」排：
 *   连接状态 > 对方正在输入 > 单聊在线状态 / 群人数
 * 全都没有时返回空串，NavBar 自动退回单行标题。
 */
const navSubtitle = computed<string>((): string => {
    if (connectionStatusDesc.value != '') {
        return connectionStatusDesc.value
    }
    if (typingDesc.value != '') {
        return typingDesc.value
    }
    if (targetUserOnlineStateDesc.value != '') {
        return targetUserOnlineStateDesc.value
    }
    return groupMemberCountDesc.value
})

// 同时只能播放一个语音，逻辑放在会话页统一控制
const playVoice = (message: Message) => {
    let ctx = innerAudioContext
    if (ctx != null) {
        ctx.stop();
    }
    const content = message.messageContent
    if (!(content instanceof SoundMessageContent)) {
        return
    }
    const voice = content as SoundMessageContent;
    let mp3RemotePath = voice.remotePath
    if (!voice.remotePath.endsWith(".mp3") && Config.AMR_TO_MP3_SERVER_ADDRESS != '') {
        mp3RemotePath = Config.AMR_TO_MP3_SERVER_ADDRESS + voice.remotePath;
    }
    // 播放通道（扬声器/听筒）是全局的，且框架在 play() 时才读，所以每次播放前都要设一遍；
    // 播完/停掉再还原成扬声器，见下面 currentVoiceMessage 的 else 分支。
    const earpiece = isEarpieceMode()
    applyAudioRoute(earpiece)
    if (earpiece) {
        // 与 android-chat 一致：听筒模式下开始播放时提示贴近听筒。
        // 它还会在插了耳机时跳过这条提示，uni-app x 没有查输出设备的 API，这里一律提示。
        uni.showToast({
            title: t('audio.earpiece_playing_hint'),
            icon: 'none'
        } as ShowToastOptions)
    }
    ctx = uni.createInnerAudioContext();
    innerAudioContext = ctx;
    ctx.autoplay = false;
    ctx.src = mp3RemotePath;
    ctx.onPlay(() => {
        voice._isPlaying = true;
    });
    ctx.onError((res) => {
        console.log('play voice error', res)
        voice._isPlaying = false;
        store.playVoice(null)
    });
    ctx.onEnded(() => {
        voice._isPlaying = false;
        store.playVoice(null)
    })
    ctx.onCanplay(() => {
        innerAudioContext?.play();
    })
}

// 用于控制同时只能播放一个语音
const currentVoiceMessage = computed<Message | null>((): Message | null => {
    const voice = conversationState.currentVoiceMessage;
    if (voice != null) {
        playVoice(voice);
    } else {
        const ctx = innerAudioContext
        if (ctx != null) {
            ctx.stop();
            innerAudioContext = null;
        }
        // 还原成扬声器：这个选项是全局的，通话铃声用的也是 InnerAudioContext，
        // 不还原的话听筒模式下来电铃声也会从听筒里响。
        applyAudioRoute(false)
    }
    return voice;
})

/**
 * 滚到「最新一条消息」（视觉底部）。
 *
 * 倒置渲染下最新一条就在滚动内容偏移 0 处，所以这里退化成 scrollTo(0, 0)：
 * 不再依赖 scrollHeight / offsetHeight，也就不存在「排版还没完成、算出来的底部偏移是旧值」
 * 这类时序问题 —— 以前那个 200ms / 600ms 双保险就是为了绕它，现在不需要了。
 *
 * 顺带也解决了鸿蒙上「scroll-top 给个魔法大数会过卷」的老坑：0 永远是合法偏移。
 *
 * 唯一还留一次延迟兜底的原因：新消息插入的那一帧，原生端可能还在应用上一次滚动动画，
 * scrollTo(0,0) 落点会被覆盖。scrollTo(0,0) 本身是幂等的，多调一次没有副作用。
 * 但这 200ms 里用户可能已经开始往上翻了，所以兜底那次要避让手指 —— 否则就是
 * 「刚开始翻历史就被弹回最新一条」。
 */
const scrollToBottom = () => {
    const doScrollToBottom = () => {
        const el = messageListEl.value
        if (el != null) {
            el.scrollTo(0, 0)
        }
    }
    doScrollToBottom()
    const scheduledAt = Date.now()
    setTimeout(() => {
        if (lastTouchMessageListAt > scheduledAt) {
            return
        }
        doScrollToBottom()
    }, 200)
}

/**
 * 滚到指定消息，把它摆在视觉顶部（对齐原来 scroll-into-view 的效果）。
 *
 * **不能用 `scroll-into-view`**：它内部是 `_scrollToItem` → `getChildOffset()` →
 * `getBoundingClientRect()`，而 getBoundingClientRect 拿的是带 transform 的**屏幕位置**，
 * 在旋转 180° 的容器里算出来是镜像的，会滚到完全相反的地方。
 *
 * 这里改成用**布局坐标**自己算。`UniElement.offsetTop/offsetHeight` 走的是
 * `layoutNode.getLayoutTop()/getLayoutHeight()`，纯排版结果，既不受 transform 影响，
 * 也不受当前滚动偏移影响；scroll-view 的子节点又是直接挂在它的排版节点下的，
 * 所以 offsetTop 就是这条消息在滚动内容坐标系里的位置。
 *
 * 换算：视口显示内容区间 [S, S+H)（S = scrollTop，H = 可视区高）。
 * 旋转之后 c=S 在视觉底部、c=S+H 在视觉顶部。目标消息占 [t, t+h)，
 * 要让它贴在视觉顶部就是 t+h = S+H，即 S = t + h - H。
 *
 * 定位场景（搜索跳转 / @我 / 未读定位）是 store 换了一整批消息，排版没跑完之前
 * querySelector 找不到节点、offsetHeight 也是 0，所以这里轮询等排版结果。
 * 这跟之前「补偿滚动位置」不一样：那个要求同帧命中否则就闪，这里是用户主动发起的跳转，
 * 晚几十毫秒只是跳转动作本身，看不出问题。
 */
const LOCATE_PROBE_INTERVAL = 16
const LOCATE_PROBE_TIMEOUT = 3000

const scrollToMessage = (messageId: number) => {
    let elapsed = 0
    const probe = () => {
        const el = messageListEl.value
        if (el == null) {
            return
        }
        const target = el.querySelector('#id-' + messageId)
        if (target != null && target.offsetHeight > 0) {
            const viewportHeight = el.offsetHeight
            let top = target.offsetTop + target.offsetHeight - viewportHeight
            const maxScrollTop = el.scrollHeight - viewportHeight
            if (top > maxScrollTop) {
                top = maxScrollTop
            }
            if (top < 0) {
                top = 0
            }
            el.scrollTo(0, top)
            console.log('scrollToMessage id=' + messageId + ' waited=' + elapsed
                + 'ms offsetTop=' + target.offsetTop + ' -> scrollTop=' + top)
            return
        }
        elapsed += LOCATE_PROBE_INTERVAL
        if (elapsed >= LOCATE_PROBE_TIMEOUT) {
            console.log('scrollToMessage timeout, id=' + messageId)
            return
        }
        setTimeout(probe, LOCATE_PROBE_INTERVAL)
    }
    setTimeout(probe, LOCATE_PROBE_INTERVAL)
}

/**
 * 列表尾部(= 最新一条消息)的标识。
 * messageId 为 0 的(远程拉回来还没落库)用 messageUid 兜底，避免两条不同的消息算出同一个标识。
 */
const newestKeyOf = (list: Message[]): string => {
    if (list.length == 0) {
        return ''
    }
    const last = list[list.length - 1]
    return last.messageId != 0 ? ('' + last.messageId) : ('u' + last.messageUid)
}

/**
 * 列表尾部标识的当前值，watch 用它判断「最新一条变没变」。
 *
 * ⚠️ **必须用进页面时的实际列表初始化，不能写成 ''。**
 * 会话列表页是 `store.setCurrentConversationInfo(...)` 之后才 `navigateTo` 的
 * (ConversationListPage.uvue showConversation)，消息在本页 setup 跑之前就已经装进 store 了；
 * 而 watch 不是 immediate，注册时不会跑一遍。初始化成 '' 的话，
 * 进会话后**第一次任何列表变动**(一条已读回执、一次资料 patch、一次状态更新)
 * 都会算出「key 从 '' 变成了 14934」→ 被当成来了新消息 → 把正在快速下拉的用户弹回最新一条。
 * 表现就是「进会话第一次下拉松手，非常容易被拽回最新」。
 */
let newestMessageKey = newestKeyOf(messageList.value)

watch(messageList, (_newList: Message[], _old: Message[]) => {
    // ⚠️ 这里判的是「最新一条消息变没变」，不是「列表变没变」，别改回后者。
    //
    // messageList 被整体换掉的场合远不止「收到新消息」：消息状态更新(已发送/已送达/已读)、
    // 撤回、发送进度，以及用户资料/群成员资料回来之后的 _deferPatchCurrentConversationMessages，
    // 都会 slice(0) 换一个新数组。这些事件跟用户翻历史消息是并发的 —— 翻历史正好把一批新
    // 发送者的资料带回来，150ms 后那个整表 patch 落地，就出现「期间根本没有新消息，
    // 却偶发被拽到最新一条」。概率低，但一定会碰上。
    //
    // 以前用「正在加载历史消息」标志位挡，挡不住：标志位只在一次加载的窗口内为真，
    // 上面这些事件落在窗口外照样放行。改成看尾部标识就跟时序无关了：
    // 倒置渲染下历史消息只往数组**头部**插，尾部一动不动；状态更新是原位替换，
    // 尾部还是同一个 messageId。两种情况算出来的 key 都不变，自然不会滚。
    const newestKey = newestKeyOf(messageList.value)
    const hasNewMessage = newestKey != newestMessageKey
    const prevNewestKey = newestMessageKey
    newestMessageKey = newestKey
    if (hasNewMessage && conversationState.shouldAutoScrollToBottom) {
        // 诊断用：再遇到「莫名其妙滚到最新一条」，先看有没有这条，能区分是不是走了自动跟随。
        // 前一个 key 是空的说明是刚进会话的第一次变动，正常情况下不该走到这里
        console.log('autoScrollToBottom, newest [' + prevNewestKey + '] -> ' + newestKey
            + ' count=' + messageList.value.length)
        scrollToBottom();
    }
    const info = conversationState.currentConversationInfo
    if (info != null && info.unreadCount.unread > 0) {
        store.clearConversationUnreadStatus(info.conversation);
    }
}, { deep: false })

/**
 * 加载更多历史消息。
 *
 * ## 触发方式：@scroll 自己量距离，不用 scrolltolower
 *
 * 倒置渲染下「最老的一条」在滚动内容的**末尾**，看起来应该用 `scrolltolower`。
 * 但那个事件是「**穿越**阈值」才触发一次的（UniScroll.ets 里判的是
 * `bottom <= lowerThreshold && bottom + yOffset >= lowerThreshold`，yOffset 是这一帧的增量），
 * 于是有两种情况它永远不会响：
 *   ① 内容总高本来就小于「一屏 + 阈值」—— bottom 一开始就在阈值带里，没有穿越可言；
 *   ② 内容压根填不满一屏 —— 列表根本滚不动，连 scroll 事件都不会有。
 * 真机上就是这么翻的：一次只捞回 20 条，会话里的消息又都很短（极端情况每条就 1 个字符），
 * 20 条撑不过一屏 + 阈值，于是历史消息再也加载不出来。消息长、气泡高的会话看着一切正常，
 * 所以很容易误判成「某类会话的问题」—— 它跟会话类型无关，只跟内容总高有关。
 * 所以改成在 `@scroll` 里自己量 `scrollHeight - scrollTop - offsetHeight`，只看距离不看穿越；
 * ② 那种情况由下面的「自动补齐」兜底。
 * `scrolltoupper` 真机上不触发，别拿它当另一端的入口。
 *
 * 预取距离 HISTORY_PREFETCH 特意留了 400：提前大半屏就开始加载，新内容接在**视口之外**，
 * 用户滑到那儿的时候已经在了 —— 微信那种「没有加载动画、一路平滑」的观感就是这么来的。
 * 也正因为提前量足够，不再需要下拉刷新控件（倒置之后刷新区也会跑到视觉底部，用不了）。
 *
 * ## 自动补齐
 *
 * 加载完如果内容还是没填满「一屏 + 预取距离」，就接着加载，直到填满或者真没有了。
 * 不这么做的话，短会话会卡死在「滚不动 → 没有 scroll 事件 → 加载不了 → 还是滚不动」。
 * 终止条件是「这一轮没拿到新消息」→ historyExhausted，只挡自动补齐；
 * 用户手动滑到底仍然会再试一次，避免一次网络抖动把这个会话永久锁死。
 *
 * ## 改这块之前先看这几条约束
 *
 * 1. 消息列表的 `:key` 必须是 `index`，**不能**换成 `message.messageId`。
 *    vapor 的 keyed diff 在「一次插入多条」时，发给原生端的 mount 指令是按新下标
 *    **倒序**的一串插入(19,18,...,0)，原生端顺序套用之后新旧节点就交叉了 ——
 *    真机上表现为「新旧消息一条隔一条交替出现、并且行与行重叠」，android 和鸿蒙都会复现。
 *    倒置之后「加载历史」确实变成了末尾追加(稳定 key 也安全)，但「收到一批新消息」
 *    仍然是一次性头部插多条，稳定 key 在那条路径上照样会交叉。所以还是 index。
 *
 * 2. 用 index 做 key 的代价：头部插入会让每一行的下标内容都变，整表重渲染。
 *    倒置之后这个代价从「每次加载历史」挪到了「每次收到新消息」（新消息插在数组头部）。
 *    消息渲染量大到卡顿时，下一步是给 renderMessageList 加个渲染窗口（只渲染最新 N 条，
 *    滑到窗口末尾再放开），而不是去动 key。
 *
 * 3. **不要**再用「正在加载历史消息」标志位去挡 watch 里的自动滚动。标志位只在一次加载的
 *    窗口内为真，而消息状态更新、资料回来之后的整表 patch 这些事件是并发的、会落在窗口外，
 *    照样把用户拽到最新一条(表现为「翻历史时低概率跳到最后，期间并没有收到新消息」)。
 *    正确做法见 watch(messageList)：只看列表尾部(最新一条)变没变。
 *
 * ⚠️ 倒置之前试过并失败、别再回头的路子（目标都是消除插入历史消息时那一下闪烁）：
 * - `nextTick` / `nextTick`+`setTimeout(0)` / 猜时间的 `setTimeout` / `flush:'post'` 的 watch
 *   / 8ms 轮询探测 scrollHeight 再 scrollTo 补偿 —— 全部追不上那一帧。根因是首屏之后
 *   uni-app x **不存在**跑在「排版完成」和「画帧」之间的 JS 钩子：
 *   `waitNativeRender()` 在 renderStatus 变成 RENDERED 之后永不复位、一律同步直返，
 *   而排版本身在 `applyRenderQueue()` 的 setTimeout(0) 里跑，期间 JS 定时器被饿死。
 * - 和插入同一次提交里设 `scroll-into-view` 指向锚点 —— 属性按旧排版算，等于空操作。
 * - **换 list-view**：`getWrapperSize()` 拿"最后一个已实例化子节点"估算高度，
 *   `scrollHeight` 会飘，进会话就闪，delta 也算错。已回退。
 */
// 离最老的一条还有这么远(px)就开始预取历史消息
const HISTORY_PREFETCH = 400
// 定位状态下，离最新的一条还有这么远就开始把更新的消息补回来
const NEWER_MESSAGE_PREFETCH = 400
// store 那边的回调有几条分支两个回调都不调(比如拉回来时会话已经切走)，加个看门狗别把 freshing 卡死
const HISTORY_LOAD_TIMEOUT = 15000
// 排版是异步的，加载完要等一会儿才量得到新的 scrollHeight
const FILL_CHECK_DELAY = 300
// 已经没有历史消息了之后的重试间隔：人停在最顶上时 @scroll 每帧都满足距离条件，
// 不限流会变成每帧一次数据库+远程拉取
const HISTORY_RETRY_INTERVAL = 3000

// 自动补齐已经补不出新消息了(真没有历史消息了)。只挡自动补齐，不挡用户手动滑到底
let historyExhausted = false
let historyExhaustedAt = 0

const loadHistoryMessages = () => {
    if (freshing.value || closing.value) {
        return
    }
    if (historyExhausted && Date.now() - historyExhaustedAt < HISTORY_RETRY_INTERVAL) {
        return
    }
    freshing.value = true

    const before = messageList.value.length
    let settled = false
    const done = () => {
        if (settled) {
            return
        }
        settled = true
        freshing.value = false
        const after = messageList.value.length
        // 诊断用：加载历史消息没反应时先看这条，能区分「没触发」和「触发了但没拿到消息」
        console.log('loadHistory done, count ' + before + ' -> ' + after)
        if (after > before) {
            historyExhausted = false
            // 可能还是没填满一屏，等排版出结果再量一次
            setTimeout(fillHistoryIfNeeded, FILL_CHECK_DELAY)
        } else {
            historyExhausted = true
            historyExhaustedAt = Date.now()
        }
    }
    setTimeout(() => {
        if (!settled) {
            console.log('loadHistory timeout')
            done()
        }
    }, HISTORY_LOAD_TIMEOUT)
    store.loadConversationHistoryMessages(done, done)
}

// 内容没填满「一屏 + 预取距离」就补，见 loadHistoryMessages 上方「自动补齐」一段
const fillHistoryIfNeeded = () => {
    if (historyExhausted || freshing.value || closing.value) {
        return
    }
    const el = messageListEl.value
    if (el == null) {
        return
    }
    const bottom = el.scrollHeight - el.scrollTop - el.offsetHeight
    // 诊断用：bottom 是「离最老的一条还有多远」，一直是负数/0 说明内容还没填满一屏
    console.log('fillHistoryIfNeeded, bottom=' + bottom
        + ' scrollHeight=' + el.scrollHeight + ' scrollTop=' + el.scrollTop + ' viewport=' + el.offsetHeight)
    if (bottom <= HISTORY_PREFETCH) {
        loadHistoryMessages()
    }
}

// 从「定位到某条历史消息」的状态往回滑到最新消息时，把更新的消息补回来
const loadNewerMessages = () => {
    if (!conversationState.hasMoreNewMessages || loadingNewMessages.value) {
        return
    }
    loadingNewMessages.value = true
    store.loadConversationNewMessages(() => {
        loadingNewMessages.value = false
    }, () => {
        loadingNewMessages.value = false
    })
}

/**
 * 倒置渲染下两端的含义都反了过来，所以两个方向的翻页都在这里按距离判断：
 *   - scrollTop 越小 → 越靠近最新一条(视觉底部) → 需要往回补更新的消息
 *   - scrollHeight - scrollTop - 可视区高 越小 → 越靠近最老一条(视觉顶部) → 需要加载历史消息
 * 判断只有几次数值读取，逐帧调不会成为瓶颈。
 */
const onMessageListScroll = (e: UniScrollEvent) => {
    const el = messageListEl.value
    if (el == null) {
        return
    }
    const scrollTop = e.detail.scrollTop
    if (scrollTop <= NEWER_MESSAGE_PREFETCH) {
        loadNewerMessages()
    }
    if (el.scrollHeight - scrollTop - el.offsetHeight <= HISTORY_PREFETCH) {
        loadHistoryMessages()
    }
}

// 触发 currentVoiceMessage computed 的求值
watch(currentVoiceMessage, (_n: Message | null, _o: Message | null) => {
}, { immediate: true })

// keyboardHeight 是记住的键盘高度(表情/更多面板复用它)，currentHeight 是当前键盘实际高度，收起时为 0
const notifyKeyboardHeight = (currentHeight: number) => {
    const inputView = messageInputView.value
    if (inputView != null) {
        (inputView as ComponentPublicInstance).$callMethod('onKeyboardHeightChange', keyboardHeight.value, currentHeight);
    }
}

/**
 * 键盘高度监听要在每次 onShow 时重挂一遍。
 *
 * Android 上每个页面是一个 Activity，而 uni.onKeyboardHeightChange 的实现（离线 SDK
 * uni-keyboard → OnKeyBoardChangedListener）是把一个全局 OnGlobalLayoutListener 挂在
 * 「当前 activity」的 decorView 上，只在别的 activity onResume 时搬过去，返回本页时不搬回来。
 * 于是从任意页面（选人、群信息……）返回后，本页再也收不到键盘高度事件 —— 表现为输入框不再被顶到
 * 键盘上方，直接被键盘盖住（真机实测：进会话点输入框正常，去一趟群信息返回再点就沉底了）。
 * 重新 on 一次会让它把监听挂到当前 activity 的 decorView 上。
 */
const registerKeyboardHeightChange = () => {
    if (keyboardHeightChangeId != 0) {
        uni.offKeyboardHeightChange(keyboardHeightChangeId);
        keyboardHeightChangeId = 0;
    }
    keyboardHeightChangeId = uni.onKeyboardHeightChange((res) => {
        if (keyboardHeight.value != res.height && res.height > 0) {
            keyboardHeight.value = res.height;
            setItem('keyboardHeight', '' + keyboardHeight.value)
        }
        // 键盘收起(height == 0)也要通知，输入框需要据此撤掉顶起用的 padding
        notifyKeyboardHeight(res.height);
        // 只在键盘弹出时顶到底部；键盘收起（含点/滑消息列表触发的 hideKeyboard）不该把
        // 正在往上翻看历史消息的用户强制拽回最新消息
        if (res.height > 0) {
            scrollToBottom();
        }
    });
}

const onReeditMessage = (data: any | null) => {
    if (data != null) {
        const inputView = messageInputView.value
        if (inputView != null) {
            (inputView as ComponentPublicInstance).$callMethod('insertText', '' + data);
        }
    }
}

const showConversationInfo = () => {
    const info = conversationState.currentConversationInfo
    if (info == null) {
        return
    }
    if (info.conversation.type == ConversationType.Single) {
        navigateToPage('/pages/conversation/SingleConversationInfoPage', info);
    } else if (info.conversation.type == ConversationType.Group) {
        navigateToPage('/pages/conversation/GroupConversationInfoPage', info);
    } else if (info.conversation.type == ConversationType.Channel) {
        navigateToPage('/pages/conversation/ChannelConversationInfoPage', info);
    } else {
        uni.showToast({
            title: 'TODO 暂不支持该会话类型',
            icon: 'none'
        } as ShowToastOptions)
    }
}

const clickMessageItem = (message: Message) => {
    if (message.messageContent instanceof NotificationMessageContent) {
        return;
    }
    if (conversationState.enableMessageMultiSelection) {
        store.selectOrDeselectMessage(message);
    }
}

const isNotificationMessage = (message: Message): boolean => {
    return message.messageContent instanceof NotificationMessageContent
        && message.messageContent.type != MessageContentType.RecallMessage_Notification
        && message.messageContent.type != MessageContentType.Rich_Notification;
}

const isContextableNotificationMessage = (message: Message): boolean => {
    return message.messageContent instanceof RichNotificationMessageContent || message.messageContent instanceof ArticlesMessageContent;
}

const isRecallNotificationMessage = (message: Message): boolean => {
    return message.messageContent.type == MessageContentType.RecallMessage_Notification;
}

// 目前仅文本消息支持复制
const isCopyable = (message: Message): boolean => {
    return message.messageContent instanceof TextMessageContent;
}

const isDownloadAble = (message: Message): boolean => {
    return isSavableMessage(message);
}

/** 文件消息且有 remotePath 时返回文件内容，否则 null（网盘菜单项据此显示） */
const fileContentOf = (message: Message): FileMessageContent | null => {
    const content = message.messageContent
    if (content instanceof FileMessageContent) {
        const fileContent = content as FileMessageContent
        if (fileContent.remotePath != '') {
            return fileContent
        }
    }
    return null
}

const isForwardable = (message: Message): boolean => {
    if (message.messageContent instanceof SoundMessageContent) {
        return false;
    }
    return true;
}

const isRecallable = (message: Message): boolean => {
    if (message.conversation.type == ConversationType.Group) {
        const groupInfo = wfc.getGroupInfo(message.conversation.target);
        const selfUserId = wfc.getUserId();
        if (groupInfo.owner == selfUserId) {
            return true;
        }

        const groupMember = wfc.getGroupMember(message.conversation.target, selfUserId);
        if (groupMember.type == GroupMemberType.Manager || groupMember.type == GroupMemberType.Owner) {
            return true;
        }
    }
    const delta = wfc.getServerDeltaTime();
    const now = new Date().getTime();
    if (message.direction == 0 && now - (message.timestamp - delta) < 60 * 1000) {
        return true;
    }
    return false;
}

const isQuotable = (message: Message): boolean => {
    return [MessageContentType.VOIP_CONTENT_TYPE_START,
    MessageContentType.Voice,
    MessageContentType.Ptt_Voice,
    MessageContentType.Video,
    MessageContentType.Composite_Message,
    MessageContentType.CONFERENCE_CONTENT_TYPE_INVITE].indexOf(message.messageContent.type) <= -1;
}

/** 语音消息（普通语音 + 对讲语音，PttSoundMessageContent 继承自 SoundMessageContent）。 */
const isAudioMessage = (message: Message): boolean => {
    return message.messageContent instanceof SoundMessageContent
}

/**
 * 切换语音消息的播放通道，对齐 android-chat `AudioMessageContentViewHolder.switchAudioPlayMode`：
 * 菜单项显示的是「切换到」的目标通道，切完停掉当前播放（正在响的那条不换通道，下次播放才生效）。
 */
const switchAudioPlayMode = () => {
    const earpiece = !isEarpieceMode()
    setEarpieceMode(earpiece)
    store.playVoice(null)
    uni.showToast({
        title: earpiece ? t('audio.switched_to_earpiece') : t('audio.switched_to_speaker'),
        icon: 'none'
    } as ShowToastOptions)
}

/**
 * 语音转文字。只对还没转过的语音消息显示，且要配了 ASR 服务地址。
 * 与 flutter 一致：转过一次之后菜单里就不再出现这一项（结果已经贴在气泡下面了）。
 */
const isSpeechToTextable = (message: Message): boolean => {
    if (!isAsrEnabled()) {
        return false
    }
    const content = message.messageContent
    if (!(content instanceof SoundMessageContent)) {
        return false
    }
    return (content as SoundMessageContent)._speechText == ''
}

const speechToTextMessage = (message: Message) => {
    const content = message.messageContent as SoundMessageContent
    if (content.remotePath == '') {
        uni.showToast({
            title: t('asr.audio_not_available'),
            icon: 'none'
        } as ShowToastOptions)
        return
    }
    content._speechToTextInProgress = true
    speechToText(content.remotePath, (text: string) => {
        content._speechToTextInProgress = false
        if (text == '') {
            content._speechText = t('asr.convert_fail')
            uni.showToast({
                title: t('asr.fail'),
                icon: 'none'
            } as ShowToastOptions)
            return
        }
        content._speechText = text
    }, (err: string) => {
        console.log('speech to text fail', err)
        content._speechToTextInProgress = false
        content._speechText = t('asr.convert_fail')
        uni.showToast({
            title: t('asr.fail'),
            icon: 'none'
        } as ShowToastOptions)
    })
}

const copy = (message: Message) => {
    const content = message.messageContent;
    if (content instanceof TextMessageContent) {
        copyText((content as TextMessageContent).content)
    }
}

const recallMessage = (message: Message) => {
    wfc.recallMessage(message.messageUid, null, null);
}

const forwardMessage = (message: Message) => {
    forward(ForwardType.NORMAL, [message]);
}

const multiSelect = (message: Message) => {
    store.toggleMessageMultiSelection(message);
}

// 点击/滑动消息列表时，收起软键盘以及表情/更多这类占用键盘位置的面板，
// 面板收起由 MessageInputView 自己的 minimizeMessageInputView 负责（之前定义了但没人调用）
const hideKeyboardAndPanel = () => {
    uni.hideKeyboard();
    const inputView = messageInputView.value
    if (inputView != null) {
        (inputView as ComponentPublicInstance).$callMethod('minimizeMessageInputView');
    }
}

const onTouchStart = (e: UniTouchEvent) => {
    lastTouchMessageListAt = Date.now()
    isScroll.value = false
    if (e.touches.length > 0) {
        touchStartX.value = e.touches[0].clientX
        touchStartY.value = e.touches[0].clientY
    }
}

const onTouchMove = (e: UniTouchEvent) => {
    lastTouchMessageListAt = Date.now()
    hideKeyboardAndPanel();
    if (e.touches.length > 0) {
        const delX = e.touches[0].clientX - touchStartX.value
        const delY = e.touches[0].clientY - touchStartY.value
        if (Math.abs(delX) > 5 || Math.abs(delY) > 5) {
            isScroll.value = true
        }
    }
}

/** 自定义导航栏正文高度，见 [NavBar](../common/NavBar.uvue) 的 `.nav-bar`；状态栏另算 */
const NAV_BAR_HEIGHT = 44

/** 逐级向上找的层数上限，够本项目最深的消息结构（In 消息气泡到行是 7 层）用了 */
const WALK_MAX_DEPTH = 12

/**
 * 从 [from] 逐级向上累加 `offsetTop`。
 *
 * `offsetTop` 在鸿蒙上是「相对**直接父节点**」的布局坐标（dom1 里就是 `layoutNode.getLayoutTop()`，
 * dom2 转发原生但行为一致 —— [messageAnchorRect] 里那条行定位一直是准的，就是靠它）。
 * 所以一路加上去就是相对某个祖先的偏移。
 *
 * @param stopHeight >0 时，撞见**高度 ≥ 它**的祖先就停（用来「加到行为止」：行本身和撑满行的
 *   包装层相对行的偏移都是 0，停在哪一层结果一样。这样就不必比较节点身份 —— dom2 里
 *   `parentElement` 和 `querySelector` 返回的是原生节点，不保证是同一个 JS 对象）。
 *   传 0 表示一路加到根（用来求某个节点的页面坐标）。
 */
const sumOffsetTopUp = (from: UniElement, stopHeight: number): number => {
    let node: UniElement | null = from
    let offset = 0
    let depth = 0
    while (node != null && depth < WALK_MAX_DEPTH) {
        if (stopHeight > 0 && node!.offsetHeight >= stopHeight) {
            break
        }
        offset += node!.offsetTop
        node = node!.parentElement
        depth++
    }
    return offset
}

/**
 * 长按的那条消息在屏幕上的矩形；拿不到可信几何时返回 null，调用方退回锚在触点上。
 *
 * ## 两条路
 *
 * 1. **节点矩形**（android 走这条，实测生效）：`currentTarget` 就是挂 `@longpress` 的那个节点，
 *    也就是 [MessageContentContainerView](./message/MessageContentContainerView.uvue) 包住气泡的
 *    那层 view，矩形≈气泡本身。`target` 是命中的最深子节点，必然在气泡内，作兜底。
 * 2. **布局坐标**（鸿蒙走这条）：`getBoundingClientRect()` 在鸿蒙 dom2 里转发给原生，实测校验
 *    不过，所以这条完全不碰节点矩形，只用 `offsetTop / offsetHeight / scrollTop` ——
 *    跟 [scrollToMessage] 同一套原语，恒为逻辑像素、不受 transform 影响，鸿蒙上一直是准的。
 *
 * ## 第 2 条的换算，以及为什么是「一堆候选 + 挑一个」
 *
 * 倒置渲染下内容坐标 c 落在视觉 y =(scrollTop + 视口高) - c（推导见 [scrollToMessage]），
 * 于是行的内容区间 [t, t+h) 对应视口内的视觉区间 [S+H-t-h, S+H-t)。再加上**视口顶边在屏幕上的
 * 位置**就是屏幕坐标 —— 而这个「视口顶边」有三种说法，谁对取决于页面 body 是不是从状态栏底下开始：
 * 逐级累加到根（不依赖任何假设，前提是 `parentElement` 在这个运行时里能用）、状态栏 + 导航栏、
 * 只有导航栏。
 *
 * 与其赌一个，不如**三个都算成候选，谁能把触点框住就用谁** —— 反正调用方本来就要这条校验。
 * 每种视口顶边又各有「气泡」和「整行」两个版本：气泡版把时间标签和昵称让出来（不让的话菜单
 * 摆在上方会平白高出一截），矩形小、校验严，优先；整行版兜底，最多是离气泡远一点点。
 *
 * 真机上要是还不对，看 `[anchor]` 那行日志：`picked` 是命中的候选序号（0/1/2 是气泡版，
 * 3/4/5 是整行版，-1 是全没命中），配合 `vt*` 三个值就能判断是哪种假设成立。
 */
const messageAnchorRect = (e: UniTouchEvent, message: Message, point: TouchPoint): ScreenRect | null => {
    let el: UniElement | null = e.currentTarget
    if (el == null) {
        el = e.target
    }
    if (el != null) {
        const rect = getElementScreenRect(el!, point)
        if (rect != null) {
            return rect
        }
    }
    const listEl = messageListEl.value
    if (listEl == null) {
        return null
    }
    try {
        const row = listEl!.querySelector('#id-' + message.messageId)
        if (row == null) {
            return null
        }
        const rowHeight = row.offsetHeight
        const viewportHeight = listEl!.offsetHeight
        if (rowHeight <= 0 || viewportHeight <= 0) {
            return null
        }
        const scrollTop = listEl!.scrollTop
        const visualTop = scrollTop + viewportHeight - row.offsetTop - rowHeight

        // 拿不到事件节点时（鸿蒙 dom2 的 target/currentTarget 未必给），按 id 去找气泡节点，
        // 用的是跟上面找行一样的 querySelector，行找得到气泡就也找得到
        let bubbleEl: UniElement | null = el
        if (bubbleEl == null) {
            bubbleEl = row.querySelector('#bubble-' + message.messageId)
        }
        const bubbleHeight = bubbleEl == null ? -1 : bubbleEl!.offsetHeight
        const bubbleOffset = bubbleEl == null ? -1 : sumOffsetTopUp(bubbleEl!, rowHeight)

        const sysInfo = uni.getSystemInfoSync()
        const width = sysInfo.windowWidth
        const viewportTops: number[] = [
            sumOffsetTopUp(listEl!, 0),
            sysInfo.statusBarHeight + NAV_BAR_HEIGHT,
            NAV_BAR_HEIGHT
        ]
        const candidates: ScreenRect[] = []
        if (bubbleOffset >= 0 && bubbleHeight > 0 && bubbleHeight <= rowHeight) {
            for (let i = 0; i < viewportTops.length; i++) {
                candidates.push(new ScreenRect(0, viewportTops[i] + visualTop + bubbleOffset, width, bubbleHeight))
            }
        }
        for (let i = 0; i < viewportTops.length; i++) {
            candidates.push(new ScreenRect(0, viewportTops[i] + visualTop, width, rowHeight))
        }
        let picked = -1
        for (let i = 0; i < candidates.length; i++) {
            if (rectContainsPoint(candidates[i], point)) {
                picked = i
                break
            }
        }
        // 临时诊断，定位准了就删。鸿蒙每次长按一行，android 走不到这里（第 1 条就返回了）
        // console.log('[anchor] probeY=', point.y, 'elNull=', el == null, 'bubbleNull=', bubbleEl == null,
        //     'vtWalk=', viewportTops[0], 'vtStatus+Nav=', viewportTops[1], 'vtNav=', viewportTops[2],
        //     'visualTop=', visualTop, 'rowOffsetTop=', row.offsetTop, 'rowH=', rowHeight,
        //     'S=', scrollTop, 'H=', viewportHeight, 'bubOff=', bubbleOffset, 'bubH=', bubbleHeight,
        //     'picked=', picked)
        if (picked >= 0) {
            return candidates[picked]
        }
        return null
    } catch (err) {
        console.log('[anchor] 读布局坐标失败', err)
        return null
    }
}

const showMessageContextMenu = (e: UniTouchEvent, message: Message) => {
    if (isScroll.value) {
        return;
    }
    // longpress 事件 touches 可能为空，改用 changedTouches 兜底取触点坐标；
    // 取不到触点就沿用上一次的锚点，但高度要清掉，免得拿上一条气泡的高度去摆这次的菜单
    contextMenuHeight.value = 0;
    const point = getTouchPoint(e)
    if (point != null) {
        contextMenuX.value = point.x;
        // 纵向锚在整条气泡上：菜单尽量落在气泡的上方/下方，只有上下都塞不下才压到气泡身上
        // （微信的行为）。横向仍锚在触点上 —— 气泡可能很宽，箭头指着手指比指着气泡中心更贴手。
        // 取不到气泡矩形就退回锚在触点上，也就是这次改动之前的老行为。
        const rect = messageAnchorRect(e, message, point!)
        contextMenuY.value = rect != null ? rect!.y : point!.y;
        contextMenuHeight.value = rect != null ? rect!.height : 0;
    }
    contextMenuMessage.value = message;

    // 顺序对齐 flutter `conversation_controller.dart` 的 buildMessageMenuItems：
    // 删除 → 复制 → 转文字 → 转发 → 撤回 → 多选 → 引用 → 收藏 → 举报。
    // uni 侧多出的一项（保存）紧跟同类项，不打乱 flutter 的相对次序。
    // 「删除」只有一项，本地/远程由 showDeleteOptions 弹窗二选一，同 flutter `_showDeleteOptions`。
    // 图标是 icomoon（Ionicons）码位，加新项前先在 static/iconfonts/icomoon/style.css 里确认存在。
    const items: PopupMenuItem[] = [];
    items.push(new PopupMenuItem(t('common.delete'), 'delete', '\uf4c4'))
    if (isCopyable(message)) {
        items.push(new PopupMenuItem('复制', 'copy', '\uf41b'))
    }
    if (isDownloadAble(message)) {
        items.push(new PopupMenuItem(isSaveToAlbumMessage(message) ? '保存到相册' : '保存到本地', 'save', '\uf41f'))
    }
    // 网盘专属项：只有配了网盘（isPanEnabled）的文件消息才有
    const fileContent = fileContentOf(message)
    if (panServerApi.isAvailable() && fileContent != null) {
        if (isOnlineDocName(fileContent!.name) && Config.getPanDocBase() != '') {
            items.push(new PopupMenuItem(t('pan.online_doc_preview'), 'docOnlinePreview', '\uf133'))
        }
        items.push(new PopupMenuItem(t('pan.save_to_my_pan'), 'panSave', '\uf40a'))
        items.push(new PopupMenuItem(t('pan.save_to_my_pan_and_open'), 'panSaveOpen', '\uf378'))
    }
    if (isSpeechToTextable(message)) {
        items.push(new PopupMenuItem(t('asr.speech_to_text'), 'speechToText', '\uf12e'))
    }
    if (isAudioMessage(message)) {
        // 显示「切换到」的目标通道：当前听筒就给「扬声器播放」，反之亦然，同 android-chat
        items.push(isEarpieceMode()
            ? new PopupMenuItem(t('audio.play_mode_speaker'), 'audioPlayMode', '\uf2b2')
            : new PopupMenuItem(t('audio.play_mode_earpiece'), 'audioPlayMode', '\uf4b9'))
    }
    if (isForwardable(message)) {
        items.push(new PopupMenuItem('转发', 'forward', '\uf13a'))
    }
    if (isRecallable(message)) {
        items.push(new PopupMenuItem('撤回', 'recall', '\uf4c6'))
    }
    items.push(new PopupMenuItem('多选', 'multiSelection', '\uf453'))
    if (isQuotable(message)) {
        items.push(new PopupMenuItem('引用', 'quote', '\uf347'))
    }
    if (isFavoriteAble(message)) {
        items.push(new PopupMenuItem(t('common.fav'), 'favorite', '\uf4b2'))
    }
    items.push(new PopupMenuItem(t('setting.report'), 'report', '\uf42c'))
    contextMenuItems.value = items;
    showContextMenu.value = true;
}

// 没有 messageUid（还没发出去/发送失败）的消息在服务端不存在，只能删本地，同 flutter `_deleteRemoteMessage`
const deleteRemoteMessage = (message: Message) => {
    if (message.messageUid == '' || message.messageUid == '0') {
        wfc.deleteMessage(message.messageId);
        return
    }
    wfc.deleteRemoteMessageByUid(message.messageUid, () => {
        console.log('delete remote message success')
    }, (err: number) => {
        console.log('delete remote message fail', err);
        uni.showToast({
            title: t1('message.delete_remote_fail', '' + err),
            icon: 'none'
        } as ShowToastOptions)
    })
}

// 对齐 flutter `conversation_controller.dart` 的 `_showDeleteOptions`：菜单里只有一项「删除」，
// 点了之后再让用户选删本地还是删远程。flutter 用的是 SimpleDialog，uni 侧用 showActionSheet
// （项目里其它二选一的地方也是它，见 MessageInputView 的「拍照/录像」）。
const showDeleteOptions = (message: Message) => {
    uni.showActionSheet({
        title: t('message.delete_title'),
        itemList: [t('message.delete_local'), t('message.delete_remote')],
        success: (res) => {
            if (res.tapIndex == 0) {
                wfc.deleteMessage(message.messageId);
            } else {
                deleteRemoteMessage(message);
            }
        },
        fail: (err) => {
            console.log('show delete action sheet fail', err)
        }
    } as ShowActionSheetOptions)
}

/** 长按菜单「在线预览」：文档格式走只读在线文档页 */
const previewPanFile = (message: Message) => {
    const fileContent = fileContentOf(message)
    if (fileContent == null) {
        return
    }
    openDocByUrl(fileContent!.remotePath, fileContent!.name)
}

/** 长按菜单「存到网盘 / 存到网盘并打开」 */
const savePanFile = (message: Message, openAfterSave: boolean) => {
    const fileContent = fileContentOf(message)
    if (fileContent == null) {
        return
    }
    saveFileMessageToMyPan(fileContent!.name, fileContent!.size, fileContent!.remotePath, '', openAfterSave)
}

const onContextMenuItemSelect = (t: PopupMenuItem) => {
    const message = contextMenuMessage.value
    if (message == null) {
        return
    }
    switch (t.tag) {
        case 'delete':
            showDeleteOptions(message);
            break;
        case 'forward':
            forwardMessage(message)
            break;
        case 'recall':
            recallMessage(message);
            break;
        case 'quote':
            store.quoteMessage(message);
            break;
        case 'multiSelection':
            multiSelect(message);
            break;
        case 'copy':
            copy(message);
            break;
        case 'save':
            saveMessageMedia(message);
            break;
        case 'docOnlinePreview':
            previewPanFile(message);
            break;
        case 'panSave':
            savePanFile(message, false);
            break;
        case 'panSaveOpen':
            savePanFile(message, true);
            break;
        case 'speechToText':
            speechToTextMessage(message);
            break;
        case 'audioPlayMode':
            switchAudioPlayMode();
            break;
        case 'favorite':
            favoriteMessage(message);
            break;
        case 'report':
            report();
            break;
        default:
            uni.showToast({
                title: 'TODO ' + t.title,
                icon: 'none'
            } as ShowToastOptions)
            break;
    }
    eventBus.$emit('contextMenuClosed', null)
}

const onOpenMessageContextMenu = (data: any | null) => {
    if (data instanceof OpenMessageContextMenuEvent) {
        const e = data as OpenMessageContextMenuEvent
        showMessageContextMenu(e.event, e.message)
    }
}

const hideUnreadLabel = () => {
    unreadLabelDismissed.value = true
}

// 定位成功后滚动到目标消息并高亮 3s，与原生 checkAndHighlightMessage 对齐
const onLocated = (found: boolean) => {
    if (!found) {
        uni.showToast({
            title: '未找到该消息',
            icon: 'none'
        } as ShowToastOptions)
        return
    }
    const messageId = conversationState.highlightMessageId
    historyExhausted = false
    scrollToMessage(messageId)
    // 定位之后列表被换成了目标消息附近的一小段，同样可能填不满一屏
    setTimeout(fillHistoryIfNeeded, 800)
    if (highlightClearTimer != 0) {
        clearTimeout(highlightClearTimer)
    }
    highlightClearTimer = setTimeout(() => {
        highlightClearTimer = 0
        store.clearHighlightMessage()
    }, 3000)
}

const locateFirstUnread = () => {
    hideUnreadLabel()
    store.locateFirstUnreadMessage(unreadCount.value, onLocated)
}

const locateFirstUnreadMention = () => {
    hideUnreadLabel()
    store.locateFirstUnreadMentionMessage(unreadCount.value, onLocated)
}

const onLocateMessageEvent = (data: any | null) => {
    if (data == null) {
        return
    }
    const messageId = parseInt('' + data)
    if (messageId > 0) {
        store.locateMessage(messageId, onLocated)
    }
}

const backToLatest = () => {
    store.backToLatestMessages()
    historyExhausted = false
    scrollToBottom()
    setTimeout(fillHistoryIfNeeded, 500)
}

onUnload(() => {
    // 先冻结渲染，再清空 store，避免关闭动画期间页面变白
    closingConversationInfo.value = conversationState.currentConversationInfo;
    closingMessageList.value = conversationState.currentConversationMessageList;
    closing.value = true;

    if (highlightClearTimer != 0) {
        clearTimeout(highlightClearTimer);
        highlightClearTimer = 0;
    }
    if (keyboardHeightChangeId != 0) {
        uni.offKeyboardHeightChange(keyboardHeightChangeId);
        keyboardHeightChangeId = 0;
    }
    // 离开会话页要停掉语音并把播放通道还原成扬声器。不能只靠 currentVoiceMessage 那个
    // computed —— 它是页面的 effect，onUnload 之后组件很快销毁，再没有求值机会。
    const voiceCtx = innerAudioContext
    if (voiceCtx != null) {
        voiceCtx.stop();
        innerAudioContext = null;
        applyAudioRoute(false);
    }
    store.setCurrentConversationInfo(null);
    eventBus.$off('openMessageContextMenu', onOpenMessageContextMenu)
    eventBus.$off('reeditMessage', onReeditMessage)
    eventBus.$off('locateMessage', onLocateMessageEvent)
})

onMounted(() => {
    scrollToBottom();
    // 首屏消息可能填不满一屏(超级群组尤其明显：一次只捞 20 条、通知类消息又很矮)，
    // 填不满就滚不动、滚不动就没有 scroll 事件、也就再没有机会加载历史消息。
    // 两个时间点各量一次：600ms 覆盖本地直接出数据的情况，1800ms 覆盖要走远程拉取的会话。
    setTimeout(fillHistoryIfNeeded, 600);
    setTimeout(fillHistoryIfNeeded, 1800);
    const info = conversationState.currentConversationInfo
    if (info != null) {
        store.clearConversationUnreadStatus(info.conversation);
    }

    const savedKeyboardHeight = getItem('keyboardHeight');
    if (savedKeyboardHeight != '') {
        keyboardHeight.value = parseInt(savedKeyboardHeight);
    }
    // 表情/更多面板高度沿用记住的键盘高度，进页面时先同步一次
    notifyKeyboardHeight(0);
    registerKeyboardHeightChange();

    eventBus.$on('openMessageContextMenu', onOpenMessageContextMenu);
    eventBus.$on('reeditMessage', onReeditMessage);
    eventBus.$on('locateMessage', onLocateMessageEvent);
})

// 从搜索结果等页面跳转过来时，定位到指定消息
onShow(() => {
    registerKeyboardHeightChange();
    const messageId = store.takePendingLocateMessageId()
    if (messageId != 0) {
        setTimeout(() => {
            store.locateMessage(messageId, onLocated)
        }, 300)
    }
})

</script>

<style scoped>
.conversation-page {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.conversation-empty-container {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.conversation-content-container {
    position: relative;
    display: flex;
    flex: 1;
    overflow: hidden;
    flex-direction: column;
}

.message-list-container {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

/* 倒置渲染的两半：容器整体转 180°，每一行再各自转回来，抵消掉行内文字/头像的翻转。
 * transform-origin 默认就是元素中心，正好是原地翻转，不用额外设置。
 * 为什么要倒置、坐标怎么换算，见模板里 scroll-view 上方和 loadHistoryMessages 上方的注释。
 *
 * 滚动条也会跟着翻到左边、方向相反，所以模板里用 show-scrollbar="false" 关掉了。
 */
.message-list {
    flex: 1;
    transform: rotate(180deg);
}

.message-item {
    transform: rotate(180deg);
}

/* 高亮态原来是 `.message-item.highlight`（复合选择器是支持的）。改成 :style 的理由只有一个：
 * 高亮色要跟明暗主题走，静态 class 给不了。
 */
.unread-label-container {
    position: absolute;
    top: 10px;
    right: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.unread-label {
    margin-left: 8px;
    padding: 6px 10px;
    border-width: 1px;
    border-style: solid;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

.unread-label-close {
    padding: 6px 8px;
    font-size: 14px;
}

.back-to-latest {
    position: absolute;
    bottom: 10px;
    right: 10px;
    padding: 6px 12px;
    border-radius: 14px;
    border-width: 1px;
    border-style: solid;
}

.message-input-container {
    width: 100%;
}
</style>
