<template>
    <view>
        <view class="wf-message-input-container"
            :style="{ paddingBottom: inputPaddingBottom + 'px', backgroundColor: c.bottomBarBg }">
            <view class="wf-message-input-toolbar" :style="{ borderTopColor: c.hairline, borderBottomColor: c.hairline, alignItems: toolbarAlignItems }">
                <text class="wf-input-button-icon wxfont" :style="{ color: c.iconSecondary }" @tap="toggleVoice">{{ showVoice ? '' : '' }}</text>
                <text v-if="isPttEnable" class="wf-input-button-icon wxfont" :style="{ color: c.iconSecondary }" @tap="togglePtt">{{ showPtt ? '' : '' }}</text>
                <!-- 频道菜单开关：频道配了菜单才出现，对齐 flutter message_input_bar.dart 的 showMenu 分支 -->
                <text v-if="showChannelMenuBar" class="wf-input-button-icon wxfont"
                    :style="{ color: c.iconSecondary }" @tap="toggleChannelMenu">&#xe661;</text>
                <text v-else-if="hasChannelMenus" class="wf-input-button-icon icomoon"
                    :style="{ color: c.iconSecondary }" @tap="toggleChannelMenu">&#xf394;</text>
                <channel-menu-bar v-if="showChannelMenuBar" :menus="channelMenus" @select="onChannelMenuSelect" />
                <view class="wf-input-voice-container" v-else-if="showVoice">
                    <AudioInputView :conversationInfo="conversationInfo"></AudioInputView>
                </view>
                <view class="wf-input-voice-container" v-else-if="showPtt">
                    <PttAudioInputView :conversationInfo="conversationInfo"></PttAudioInputView>
                </view>
                <view v-else class="wf-input-middle">
                    <view class="wf-input-text-container" :style="{ backgroundColor: c.surface }">
                        <view class="wf-input-text-row">
                            <!-- cursor 必须写在 value 后面：同一次 patch 里属性是按模板顺序下发的，
                                 先 setText(会把光标带到别处)、后 setSelection 才是我们要的位置 -->
                            <textarea class="wf-input-textarea" :style="{ backgroundColor: c.surface, color: c.textPrimary }" @focus="onInputFocus" @blur="onInputBlur" @input="onInput" :value="text"
                                :cursor="inputCursor" :focus="inputFocus"
                                placeholder="" :hold-keyboard="true" confirm-type="send" @confirm="send" :maxlength="-1"
                                :auto-height="true" :adjust-position="adjustPosition" @linechange="onLineChange" />
                            <!-- 实时语音输入：点一下开始边说边出字，再点一下停止。对齐 android-chat 输入框右侧的 asrImageView；
                                 录音时主色调闪烁，停止后等剩余识别结果时保持主色调 -->
                            <view v-if="asrInputAvailable" class="wf-asr-mic" @tap="onAsrMicTap">
                                <text class="wf-asr-mic-icon icomoon" :style="{ color: asrMicColor, opacity: asrMicOpacity }">&#xf461;</text>
                            </view>
                        </view>
                    </view>
                    <view v-if="quotedMessage != null" class="quote-message-container" :style="{ backgroundColor: c.bubbleQuoted }">
                        <text class="quoted-message single-line" :style="{ fontSize: fontPx(13), color: c.bubbleQuotedText }">{{ quotedMessageDigest }}</text>
                        <text class="cancel icomoon" :style="{ fontSize: iconPx(16), color: c.textSecondary }" @tap="cancelQuote">&#xf12a;</text>
                    </view>
                </view>
                <!-- 菜单栏占满中间那格时右侧按钮全部让位，与 flutter 的 status != menuStatus 分支一致 -->
                <text v-if="!showChannelMenuBar" @tap="toggleEmoji" class="wf-input-button-icon wxfont" :style="{ color: c.iconSecondary }">&#xe60b;</text>
                <view v-if="!showChannelMenuBar && !hideSendButton && text != ''" class="wf-input-text-send-button"
                    :style="{ backgroundColor: c.accent, borderColor: c.accent }" @tap="send">
                    <text class="send-button-text" :style="{ fontSize: fontPx(15), color: c.onAccent }">发送</text>
                </view>
                <text v-if="!showChannelMenuBar && (hideSendButton || text == '')" @tap="toggleExt" class="wf-input-button-icon wxfont"
                    :style="{ color: c.iconSecondary }">&#xe657;</text>
            </view>
            <!-- 扩展面板：一页 4 列 × 2 行，最多 8 个，超出的横滑翻页（对齐微信的 + 面板） -->
            <view v-if="showExt" class="wf-ext-container"
                :style="{ height: extPanelHeight + 'px', backgroundColor: c.bottomBarBg }">
                <swiper class="wf-ext-swiper" :style="{ height: extSwiperHeight + 'px' }" :current="extPageIndex"
                    @change="onExtPageChange">
                    <swiper-item v-for="(page, pi) in extPages" :key="pi">
                        <view class="wf-ext-page">
                            <view class="wf-ext-item" v-for="(v, i) in page" @tap="onClickExt(v)" :key="i">
                                <view class="wf-ext-item-icon" :style="{ backgroundColor: c.surface }">
                                    <!-- 字形颜色跟主题走：原来没写 color，深色模式下是黑字压深色底板 -->
                                    <text class="ext-icon" :class="v.font" :style="{ color: c.iconSecondary }">{{ v.icon }}</text>
                                </view>
                                <text class="wf-ext-item-text single-line" :style="{ fontSize: fontPx(12), color: c.textSecondary }">{{ v.title }}</text>
                            </view>
                        </view>
                    </swiper-item>
                </swiper>
                <!-- 页码点自己画：swiper 内置 indicator-dots 的 indicator-color/indicator-active-color
                     在鸿蒙 vapor 上不支持（uni_vue_tag/swiper.json 标的是 x），跟不了主题色 -->
                <view v-if="extPages.length > 1" class="wf-ext-indicator" :style="{ height: EXT_INDICATOR_HEIGHT + 'px' }">
                    <view class="wf-ext-dot" v-for="(dotPage, i) in extPages" :key="i"
                        :style="{ backgroundColor: i == extPageIndex ? c.iconSecondary : c.hairline }"></view>
                </view>
            </view>
            <view v-if="showEmoji" class="wf-stickers-container"
                :style="{ height: keyboardHeight + 'px', backgroundColor: c.inputBg }">
                <view class="category-container">
                    <view class="category" :style="{ borderBottomColor: c.hairline }" v-for="(v, i) in emojiStickerList" :key="i"
                        @tap="onCategoryClick(i)">
                        <image class="category-poster" :class="{ active: i == currentEmojiStickerIndex }" :src="v.poster" mode="aspectFit" />
                    </view>
                </view>
                <scroll-view v-if="currentEmojiStickerIndex == 0" direction="vertical" class="wf-emoji-container"
                    :style="{ height: (keyboardHeight - 60) + 'px' }">
                    <view class="wf-emoji-content">
                        <text class="emoji-item" @tap="onClickEmoji(v)" v-for="(v, i) in emojiStickerList[0].emojis"
                            :key="i">{{ v }}</text>
                    </view>
                </scroll-view>
                <scroll-view v-else direction="vertical" class="wf-sticker-container"
                    :style="{ height: (keyboardHeight - 60) + 'px' }">
                    <view class="wf-sticker-content">
                        <image :src="s" class="sticker-item" mode="aspectFit" @tap="onClickSticker(s)"
                            v-for="(s, j) in emojiStickerList[currentEmojiStickerIndex].stickers" :key="j" />
                    </view>
                </scroll-view>
            </view>
        </view>
        <!-- 一级菜单带子菜单时点开，弹在触点上方（菜单栏贴着屏幕底部，dropdown-menu 会自动翻上去） -->
        <dropdown-menu v-model="showSubMenu" :items="subMenuItems" :targetX="subMenuTargetX" :targetY="subMenuY"
            :targetWidth="SUB_MENU_WIDTH" :menuWidth="SUB_MENU_WIDTH" @select="onSubMenuSelect" />
    </view>
</template>

<script setup lang="uts">
import TextMessageContent from "../../wfc/messages/textMessageContent.uts";
import CardMessageContent from "../../wfc/messages/cardMessageContent.uts";
import TypingMessageContent from "../../wfc/messages/typingMessageContent.uts";
import ConversationInfo from "../../wfc/model/conversationInfo.uts";
import Message from "../../wfc/messages/message.uts";
import UserInfo from "../../wfc/model/userInfo.uts";
import wfc from "../../wfc/client/wfc.uts";
import store, { conversationState, contactState } from "../../store.uts";
import ConversationType from "../../wfc/model/conversationType.uts";
import emojiStickerConfig, { EmojiStickerCategory } from "./emojiStickerConfig.uts";
import StickerMessageContent from "../../wfc/messages/stickerMessageContent.uts";
import Config from "../../config.uts";
import QuoteInfo from "../../wfc/model/quoteInfo.uts";
import AudioInputView from "./message/AudioInputView.uvue";
import PttAudioInputView from "./message/PttAudioInputView.uvue";
import Draft from "../util/draft.uts";
import { pickUser, PickUserOptions, pickUsers, PickUsersOptions } from "../../common/picker.uts";
import avEngineKit from "../../wfc/av/engine/avEngineKit.uts";
import CallState from "../../wfc/av/engine/callState.uts";
import checkVoipPermissions from "../../wfc/av/voipUtil.uts";
import { startSingleCall } from "../../common/avcall.uts";
import pttClient from "../../wfc/ptt/pttClient.uts";
import { navigateToPage } from "../../common/nav.uts";
import { toLocalFilePath } from "../../common/filePath.uts";

import { toast } from "../../common/prompt.uts";
import { t } from "../../i18n/i18n.uts";
import collectionServerApi from "../../api/collectionServerApi.uts";
import pollServerApi from "../../api/pollServerApi.uts";
import ChannelMenu from "../../wfc/model/channelMenu.uts";
import ChannelMenuEventMessageContent from "../../wfc/messages/channelMenuEventMessageContent.uts";
import { ChannelMenuSelectEvent, CHANNEL_MENU_TYPE_VIEW, CHANNEL_MENU_TYPE_CLICK } from "../../common/channelMenu.uts";
import { PopupMenuItem } from "../../common/popupMenu.uts";
import { isAsrInputAvailable, startAsr as startVoiceAsr, stopAsr as stopVoiceAsr, cancelAsr as cancelVoiceAsr, isAsrRecognizing as isVoiceAsrRecognizing } from "../../common/voiceInput.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx, iconPx, scale, TEXT_CAP } from "@/common/layoutScale.uts";
class ExtItem {
    title = ''
    tag = ''
    icon = ''
    /** icon 所属字体：wxfont（默认）或 icomoon。wxfont 里没有柱状图字形，投票只能借 icomoon */
    font = 'wxfont'

    constructor(title: string, tag: string, icon: string, font: string = 'wxfont') {
        this.title = title
        this.tag = tag
        this.icon = icon
        this.font = font
    }
}

defineOptions({
    name: "MessageInputView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    conversationInfo: ConversationInfo
}>()

// 表情/更多面板弹出时通知会话页把消息列表滚到底部 —— 这两个面板和软键盘一样会占掉底部空间，
// 但它们不触发 onKeyboardHeightChange，所以得自己发一次事件，否则最新消息会被面板顶出可视区。
const emit = defineEmits(['panelShow'])

const emojiStickerList = ref<EmojiStickerCategory[]>(emojiStickerConfig as EmojiStickerCategory[])
const currentEmojiStickerIndex = ref<number>(0)
const hideSendButton = ref<boolean>((Config.getWFCPlatform() == 1 || Config.getWFCPlatform() == 8) as boolean)
const showVoice = ref<boolean>(false)
const showPtt = ref<boolean>(false)
const isPttEnable = ref<boolean>(Config.ENABLE_PTT && pttClient.isEnable())

// ---- 频道菜单（公众号底部菜单）----
// 菜单本身随 channelInfo 下发，由 store 在进入频道会话/收到 ChannelInfosUpdate 时维护。
// showChannelMenu 是「当前在菜单态还是输入态」，进入带菜单的频道会话时默认是菜单态，
// 对齐 flutter `MessageInputBarController` 的 menuStatus。
const channelMenus = computed<ChannelMenu[]>((): ChannelMenu[] => conversationState.channelMenus)
const hasChannelMenus = computed<boolean>((): boolean => conversationState.channelMenus.length > 0)
const showChannelMenuBar = computed<boolean>((): boolean => hasChannelMenus.value && conversationState.showChannelMenu)

// 子菜单弹窗。宽度固定，targetX 取「触点 - 半个宽度」让弹窗横向居中在手指上
// （dropdown-menu 是把面板右边缘对齐 targetX + targetWidth 的，超出屏幕它自己会夹回来）
const SUB_MENU_WIDTH: number = 160
const showSubMenu = ref<boolean>(false)
const subMenuItems = ref<PopupMenuItem[]>([] as PopupMenuItem[])
const subMenus = ref<ChannelMenu[]>([] as ChannelMenu[])
const subMenuX = ref<number>(0)
const subMenuY = ref<number>(0)
const subMenuTargetX = computed<number>((): number => subMenuX.value - SUB_MENU_WIDTH / 2)
// 「群接龙」「群投票」只在群会话且配了对应服务时才出现，与 flutter `input_bar/plugin_board.dart` 一致
// （顺序也一致：接龙在前、投票在后）
const extList = computed<ExtItem[]>((): ExtItem[] => {
    const items = [
        new ExtItem('相册', 'image', ''),
        new ExtItem('语音通话', 'voip_a', ''),
        new ExtItem('视频通话', 'voip_v', ''),
        new ExtItem('拍摄', 'shot', ''),
        new ExtItem('文件', 'file', ''),
        new ExtItem('位置', 'location', ''),
        new ExtItem('名片', 'userCard', ''),
    ] as ExtItem[]
    let converstionInfo = props.conversationInfo as ConversationInfo;
    const isGroup = converstionInfo.conversation.type == ConversationType.Group
    if (isGroup && collectionServerApi.isAvailable()) {
        items.push(new ExtItem(t('collection.collection'), 'collection', '\uf391', 'icomoon'))
    }
    if (isGroup && pollServerApi.isAvailable()) {
        items.push(new ExtItem(t('poll.poll'), 'poll', '\uf2b5', 'icomoon'))
    }
    return items
})

/**
 * 扩展面板分页：一页 4 列 × 2 行 = 8 个，多出来的翻到下一页。
 * 列宽是 25%（见 .wf-ext-item），所以最左一列的左边距天然等于最右一列的右边距，整体水平居中；
 * 不足一页的最后一页按列左对齐，不会把剩下的一两个撑开居中。
 */
const EXT_PAGE_SIZE: number = 8
/** 页码点那一条的高度，swiper 高度要把它扣掉，否则最后一行会被压出面板 */
const EXT_INDICATOR_HEIGHT: number = 20
/** 一行的高度：上下 padding 17 + 图标 55 + margin 8 + 一行文字（跟字号档位走，1.5 倍行高留够） */
const extRowHeight = computed<number>((): number => {
    return 17.0 + 55.0 + 8.0 + scale(12, TEXT_CAP) * 1.5 + 17.0
})
const extPages = computed<ExtItem[][]>((): ExtItem[][] => {
    const pages = [] as ExtItem[][]
    const all = extList.value
    // 下标一律显式标 number：UTSArray.length 落到 Kotlin 是 Int，和 Number 混着算会类型不匹配
    const total: number = all.length
    let start: number = 0
    while (start < total) {
        let end: number = start + EXT_PAGE_SIZE
        if (end > total) {
            end = total
        }
        pages.push(all.slice(start, end))
        start = end
    }
    return pages
})
const extPageIndex = ref<number>(0)
const onExtPageChange = (event: UniSwiperChangeEvent) => {
    extPageIndex.value = event.detail.current
}
const showExt = ref<boolean>(false)
const showEmoji = ref<boolean>(false)
const text = ref<string>('')
// textarea 没有读取选区的接口，光标只能从 input / blur 事件里记。
// 这几个声明必须在 moveCursorTo 之前：UTS 编译到 Kotlin 后，lambda 里引用后声明的局部变量是编译错误。
let lastCursor = -1
let inputFocused = false
let lastBlurTime = 0

// 「代码改 value」不会把光标带到新文本末尾 —— Android 实测 @ 选完人之后，光标还停在刚敲的
// '@' 后面(卡在 "@张三 " 中间)，接着打字会插到名字前面；iOS 原生侧 setText 后保持原光标位置
// 不动，语音输入连续写入识别结果时，光标就被留在了新输入内容的前面。鸿蒙没这个问题。
// 解法是显式指定 textarea 的 cursor：Android 端收到 cursor 属性就直接 setSelection
// (离线 SDK app-runtime → InputComponent.setAttrProperty 的 "cursor" 分支)，iOS 端同理。
const inputCursor = ref<number>(-1)
const moveCursorTo = (pos: number) => {
    // #ifdef APP-ANDROID || APP-IOS
    // #ifdef APP-IOS
    // iOS 在 HBuilderX 5.26 之前设置 cursor 会连带触发 focus(框架 bug)，键盘没弹时不动光标，
    // 免得插表情/@ 时把键盘意外弹出来；语音输入期间输入框本来就持有焦点，不受这个限制影响
    if (!inputFocused) {
        return
    }
    // #endif
    // 目标位置和挂起的值相同时属性不算变化、不会下发 —— 语音输入的识别结果连续到达，两次目标
    // 位置经常相同。先打回 -1、下一拍再设回目标位置，保证每次调用都有一次真正的 setSelection。
    if (inputCursor.value == pos) {
        inputCursor.value = -1
        nextTick((): void => {
            inputCursor.value = pos
            nextTick((): void => {
                inputCursor.value = -1
            })
        })
        return
    }
    inputCursor.value = pos
    // 用完立刻置回 -1(cursor 的默认值，不会触发 setSelection)，否则下次要落的位置万一和这次相同，
    // 属性没变化就不会下发，光标又不动了。
    nextTick((): void => {
        inputCursor.value = -1
    })
    // #endif
}

// ---- 实时语音输入（输入框右侧麦克风）----
// 对齐 android-chat ConversationInputPanel 的 asrImageView / hm-chat ConversationInputPanelView：
// 点一下开始录音，识别结果边说边写进输入框（写在开始时的光标处），再点一下停止并等剩余结果；
// 期间用户自己编辑文本、发送、切到语音/对讲，都会结束语音输入，已经写进去的文字保留。
// 录音、识别都在 uni_modules/wfc-voice-input 里，入口见 common/voiceInput.uts。
const asrInputAvailable = isAsrInputAvailable()
/** 正在录音：麦克风主色调闪烁 */
const asrRecording = ref<boolean>(false)
/** 已停止录音、等待剩余识别结果：麦克风保持主色调 */
const asrWaiting = ref<boolean>(false)
/** 闪烁时的透明度，定时器在 1 和 0.3 之间切换，渐变交给样式里的 transition */
const asrMicOpacity = ref<number>(1)
const asrMicColor = computed<string>((): string => {
    return asrRecording.value || asrWaiting.value ? c.value.accent : c.value.iconSecondary
})
/** textarea 的 focus 属性。开始语音输入时置 true 让输入框获焦、弹出键盘，失焦时复位，下次才能再触发 */
const inputFocus = ref<boolean>(false)
let asrPulseTimer = 0
// 识别结果写到 [asrTextStart, asrTextEnd)，每次用最新的全部识别文本覆盖这一段
let asrTextStart = 0
let asrTextEnd = 0
// 最近一次写入识别结果后的文本，用来区分用户自己的编辑
let asrExpectedText = ''

const stopAsrPulse = () => {
    if (asrPulseTimer != 0) {
        clearInterval(asrPulseTimer)
        asrPulseTimer = 0
    }
    asrMicOpacity.value = 1
}

const startAsrPulse = () => {
    stopAsrPulse()
    asrPulseTimer = setInterval((): void => {
        asrMicOpacity.value = asrMicOpacity.value > 0.5 ? 0.3 : 1
    }, 600)
}

const resetAsrState = () => {
    asrRecording.value = false
    asrWaiting.value = false
    stopAsrPulse()
}

/** 用最新的识别文本替换输入框里语音输入的那一段，光标移到识别文本末尾 */
const updateAsrText = (result: string) => {
    const current = text.value
    const start = Math.min(asrTextStart, current.length)
    const end = Math.min(Math.max(asrTextEnd, start), current.length)
    const newText = current.substring(0, start) + result + current.substring(end)
    asrTextStart = start
    asrTextEnd = start + result.length
    asrExpectedText = newText
    text.value = newText
    lastCursor = asrTextEnd
    moveCursorTo(asrTextEnd)
}

/** 取消语音输入，丢弃还没返回的识别结果，已经写进输入框的文字保留 */
const cancelAsrInput = () => {
    if (!asrRecording.value && !asrWaiting.value) {
        return
    }
    cancelVoiceAsr()
    resetAsrState()
}

const startAsrInput = () => {
    const length = text.value.length
    // 写在开始时的光标处；输入框没有焦点时写到末尾。点麦克风本身可能先让输入框失焦，所以刚失焦的也算
    const focused = inputFocused || Date.now() - lastBlurTime < 500
    const cursor = focused && lastCursor >= 0 && lastCursor <= length ? lastCursor : length
    asrTextStart = cursor
    asrTextEnd = cursor
    asrExpectedText = text.value
    asrRecording.value = true
    asrWaiting.value = false
    startAsrPulse()
    inputFocus.value = true
    startVoiceAsr((result: string): void => {
        updateAsrText(result)
    }, (result: string): void => {
        // 没有识别出文字时，保留原来的文本
        if (result != '') {
            updateAsrText(result)
        }
        resetAsrState()
    }, (message: string): void => {
        toast(t('voice_input.asr_error') + message)
        resetAsrState()
    }, (): void => {
        toast(t('voice_input.mic_permission_denied'))
        resetAsrState()
    })
}

const onAsrMicTap = () => {
    if (asrRecording.value) {
        // 正在录音：停止，剩余识别结果返回后在 onFinal 里复位
        stopVoiceAsr()
        asrRecording.value = false
        stopAsrPulse()
        if (isVoiceAsrRecognizing()) {
            asrWaiting.value = true
        } else {
            resetAsrState()
        }
        return
    }
    if (isVoiceAsrRecognizing()) {
        // 已停止录音，正在等待剩余识别结果
        return
    }
    startAsrInput()
}
// 输入框当前行数，由 textarea 的 linechange 事件维护，用来决定工具栏是居中还是底部对齐
const inputLineCount = ref<number>(1)
const keyboardHeight = ref<number>(300)
// 下面两个声明必须在 keyboardHeight 之后：UTS 编译到 Kotlin 后，lambda 里引用后声明的局部变量是编译错误。
// 面板高度默认跟键盘走，但两行图标 + 页码点是硬需求，键盘矮于这个数就撑到这个数，否则第二行被切掉。
const extPanelHeight = computed<number>((): number => {
    const need: number = extRowHeight.value * 2 + (extPages.value.length > 1 ? EXT_INDICATOR_HEIGHT : 0.0)
    return keyboardHeight.value > need ? keyboardHeight.value : need
})
const extSwiperHeight = computed<number>((): number => {
    return extPages.value.length > 1 ? extPanelHeight.value - EXT_INDICATOR_HEIGHT : extPanelHeight.value
})
const currentKeyboardHeight = ref<number>(0)
const mentions = ref<UserInfo[]>([] as UserInfo[])
const groupMemberUserInfos = ref<UserInfo[]>([] as UserInfo[])
const safeAreaBottomHeight = ref<number>(0)

const sysInfo = uni.getSystemInfoSync()
safeAreaBottomHeight.value = sysInfo.safeAreaInsets.bottom

// 三个 App 平台都关掉系统的键盘避让，改为手动把输入区抬到键盘上方：
// - 鸿蒙：textarea 聚焦时框架会把 KeyboardAvoidMode 设为 OFFSET，整个页面(含页面内自定义导航栏)
//   被键盘顶出屏幕，且顶起高度按光标算，输入框仍会被挡住一部分；
// - Android：adjust-position=true 时框架是给页面根容器加 translationY(见离线 SDK app-runtime 里的
//   io.dcloud.px.v0)，位移量只在键盘弹出的那一刻按输入框当时的位置算一次，之后不再重算。而我们在
//   @focus 里收起表情/更多面板，输入框随后又往下掉了一个面板的高度，位移量就成了错的 —— 表现为先开
//   面板再点输入框时，输入框留在底部被键盘盖住(直接点输入框没有这个落差，所以看着是正常的)。
// - iOS：同样是上推量只在键盘弹出那一刻按输入框当时的高度算一次，textarea 是 auto-height，
//   输入框随输入长高之后不再重算，多行输入时键盘就盖住输入框的下部。
const adjustPosition = ref<boolean>(true)
// #ifdef APP-HARMONY
adjustPosition.value = false
// #endif
// #ifdef APP-ANDROID
adjustPosition.value = false
// #endif
// #ifdef APP-IOS
adjustPosition.value = false
// #endif

// Android 的 uni.onKeyboardHeightChange 报的高度是扣掉导航栏之后的(框架自己也要把 navigationBars
// 的 inset 加回去才当成键盘的真实高度)，所以顶起输入区时要补上底部安全区；
// 鸿蒙和 iOS 报的就是完整高度(键盘下沿贴着屏幕底边)。
const keyboardBottomInset = ref<number>(0)
// #ifdef APP-ANDROID
keyboardBottomInset.value = safeAreaBottomHeight.value
// #endif

// 关掉了系统避让时，键盘弹出期间用等高的 padding 顶起输入区；其余情况只留底部安全区。
// 表情/更多面板本身就占着键盘的位置，面板显示期间不叠加键盘高度，否则「面板已经显示、键盘还没收完」
// 的那一瞬间输入区会往上跳一整个面板的高度。
const inputPaddingBottom = computed<number>((): number => {
    if (!adjustPosition.value && currentKeyboardHeight.value > 0 && !showExt.value && !showEmoji.value) {
        return currentKeyboardHeight.value + keyboardBottomInset.value
    }
    return safeAreaBottomHeight.value
})

const quotedMessage = computed<Message | null>((): Message | null => {
    return conversationState.quotedMessage
})

const quotedMessageDigest = computed<string>((): string => {
    const quotedMsg = conversationState.quotedMessage
    if (quotedMsg == null) {
        return ''
    }
    return quotedMsg.messageContent.digest(quotedMsg)
})

// linechange 只在用户输入导致行数变化时触发，代码里直接改 value（恢复草稿、插入表情/@）不一定会触发，
// 所以再用文本里的换行符兜底
const isMultiLineInput = computed<boolean>((): boolean => {
    return inputLineCount.value > 1 || text.value.indexOf('\n') >= 0
})

// 单行且没有引用消息时，输入框和两侧按钮等高，工具栏各项垂直居中最好看；
// 一旦换行或带上引用条，输入区变高，各项就得靠底部对齐，否则发送按钮会浮在半空
const toolbarAlignItems = computed<string>((): string => {
    if (isMultiLineInput.value || conversationState.quotedMessage != null) {
        return 'flex-end'
    }
    return 'center'
})

const onLineChange = (event: UniTextareaLineChangeEvent) => {
    inputLineCount.value = event.detail.lineCount
}

const restoreDraft = () => {
    const conversationInfo = props.conversationInfo as ConversationInfo
    const draft = Draft.getConversationDraftEx(conversationInfo);
    store.quoteMessage(draft.quotedMessage);
    if (text.value != '') {
        console.log('inputting, ignore', draft.text)
    } else {
        text.value = draft.text;
    }
}

const storeDraft = () => {
    const conversationInfo = props.conversationInfo as ConversationInfo
    const quotedMsg = conversationState.quotedMessage;
    const draftText = text.value.trim();
    const quoteInfo = quotedMsg != null
        ? QuoteInfo.init(quotedMsg.messageUid, quotedMsg.from, quotedMsg.messageContent.digest(quotedMsg))
        : null;

    if (draftText.length == 0) {
        if (conversationInfo.draft != '') {
            Draft.setConversationDraft(conversationInfo.conversation, draftText, quoteInfo)
        }
    } else {
        if (draftText != conversationInfo.draft) {
            Draft.setConversationDraft(conversationInfo.conversation, draftText, quoteInfo)
        }
    }
}

onMounted(() => {
    const conversationInfo = props.conversationInfo as ConversationInfo
    if (conversationInfo.conversation.type == ConversationType.Group) {
        groupMemberUserInfos.value = store.getGroupMemberUserInfos(conversationInfo.conversation.target, false, false);
    }
    restoreDraft();
})

onBeforeUnmount(() => {
    cancelAsrInput()
    stopAsrPulse()
    storeDraft()
})

// 与原生保持一致，10s 内最多发一条 typing 消息
const TYPING_INTERVAL = 10 * 1000
let lastTypingTime = 0

const notifyTyping = (typingType: number) => {
    const conversationInfo = props.conversationInfo as ConversationInfo
    const conversation = conversationInfo.conversation
    if (conversation.type != ConversationType.Single && conversation.type != ConversationType.Group) {
        return
    }
    const now = new Date().getTime()
    if (now - lastTypingTime <= TYPING_INTERVAL) {
        return
    }
    lastTypingTime = now
    wfc.sendConversationMessage(conversation, new TypingMessageContent(typingType))
}

const onInput = (event: UniInputEvent) => {
    // 语音输入过程中用户自己改了文本（输入、删除），结束语音输入，已写入的文字保留
    if ((asrRecording.value || asrWaiting.value) && event.detail.value != asrExpectedText) {
        cancelAsrInput();
    }
    let inserting = false;
    if (event.detail.value.length > text.value.length) {
        inserting = true;
    }
    text.value = event.detail.value;
    const cursor = event.detail.cursor;
    lastCursor = cursor;
    if (inserting) {
        notifyTyping(TypingMessageContent.TYPING_TEXT);
    }
    const conversationInfo = props.conversationInfo as ConversationInfo
    if (conversationInfo.conversation.type == ConversationType.Group) {
        if (inserting && text.value.length > 0 && cursor > 0 && text.value.charAt(cursor - 1) == '@') {
            const atAll = new UserInfo()
            atAll.uid = '@all'
            atAll.displayName = '所有人'
            const target = store.ensureConversationTarget(conversationInfo.conversation)
            atAll.portrait = target != null ? target.portrait : ''
            atAll._displayName = '所有人'

            const options = new PickUserOptions()
            const users: UserInfo[] = [atAll]
            options.users = users.concat(groupMemberUserInfos.value)
            options.showCategoryLabel = false
            options.successCB = (user: UserInfo) => {
                const mentionText = `@${user.displayName} `
                text.value = text.value.substring(0, cursor - 1) + mentionText + text.value.substring(cursor);
                // 光标落到 "@某人 " 之后，接着打字才不会插进名字里
                moveCursorTo(cursor - 1 + mentionText.length);
                mentions.value.push(user);
                // #ifdef APP-ANDROID
                // 从选人页返回时键盘会自己回来，但这一次弹出未必还能等到 onKeyboardHeightChange
                // (监听得等页面 onShow 重挂，见 ConversationPage 里 registerKeyboardHeightChange
                // 的注释)，所以先按记住的键盘高度把输入区顶起来，真实事件到了会自己校正。
                currentKeyboardHeight.value = keyboardHeight.value;
                // #endif
            }
            pickUser(options)
        }
    }
}

// 供会话页调用：撤回后重新编辑、@ 某人
const insertText = (insert: string) => {
    cancelAsrInput();
    text.value = text.value + insert;
    moveCursorTo(text.value.length);
}

const mention = (groupId: string, userId: string) => {
    cancelAsrInput();
    const userInfo = wfc.getUserInfo(userId, false, groupId);
    mentions.value.push(userInfo);
    text.value = text.value + '@' + userInfo.displayName + ' ';
    moveCursorTo(text.value.length);
}

const send = () => {
    // 正在语音输入时先取消，避免之后返回的识别结果写进已经清空的输入框
    cancelAsrInput();
    if (text.value != '') {
        const textMessageContent = new TextMessageContent(text.value)
        const quotedMsg = conversationState.quotedMessage;
        if (quotedMsg != null) {
            const quoteInfo = QuoteInfo.init(quotedMsg.messageUid, quotedMsg.from, quotedMsg.messageContent.digest(quotedMsg));
            textMessageContent.quoteInfo = quoteInfo;
            store.quoteMessage(null);
        }
        const conversationInfo = props.conversationInfo as ConversationInfo
        if (conversationInfo.conversation.type == ConversationType.Group && mentions.value.length > 0) {
            // 匹配以@开始，后面跟着至少一个非空白字符，并且以空格或行尾结尾的字符串
            const regex = /@\S+(\s|$)/g;
            const matches = text.value.match(regex);
            if (matches != null) {
                for (let i = 0; i < matches.length; i++) {
                    const match = (matches[i] ?? '').trim();
                    if (match == '@所有人') {
                        const index = mentions.value.findIndex((user: UserInfo): boolean => user.uid == '@all')
                        if (index >= 0) {
                            textMessageContent.mentionedType = 2;
                            break
                        }
                    } else {
                        const index = mentions.value.findIndex((user: UserInfo): boolean => user.displayName == match.substring(1));
                        if (index >= 0) {
                            const uid = mentions.value[index].uid;
                            if (textMessageContent.mentionedTargets.indexOf(uid) == -1) {
                                textMessageContent.mentionedType = 1;
                                textMessageContent.mentionedTargets.push(uid);
                            }
                        }
                    }
                }
            }
        }

        wfc.sendConversationMessage(conversationInfo.conversation, textMessageContent);
        text.value = '';
        // 清空后 textarea 不一定回调 linechange，手动复位，否则工具栏会一直保持底部对齐
        inputLineCount.value = 1;
        mentions.value = [];
        Draft.setConversationDraft(conversationInfo.conversation, '', null);
    }
}

const minimizeMessageInputView = () => {
    showEmoji.value = false;
    showExt.value = false;
    // 对齐 flutter：点/拖消息列表会走 resetStatus()，菜单态一并退回输入态
    store.toggleChannelMenu(false);
}

const onInputFocus = () => {
    inputFocused = true;
    showEmoji.value = false;
    showExt.value = false;
    store.toggleChannelMenu(false);
}

const onInputBlur = (event: UniTextareaBlurEvent) => {
    inputFocused = false;
    lastBlurTime = Date.now();
    lastCursor = event.detail.cursor;
    inputFocus.value = false;
}

const toggleVoice = () => {
    // 输入框要被换掉了，语音输入跟着结束
    cancelAsrInput();
    // 语音/表情/更多面板都是占据键盘位置的，切过去时先收起键盘，否则两者会同时占底部空间
    uni.hideKeyboard();
    store.toggleChannelMenu(false);
    showVoice.value = !showVoice.value;
    showPtt.value = false;
    showEmoji.value = false;
    showExt.value = false;
    if (showVoice.value) {
        notifyTyping(TypingMessageContent.TYPING_VOICE);
    }
}

const togglePtt = () => {
    cancelAsrInput();
    uni.hideKeyboard();
    store.toggleChannelMenu(false);
    showPtt.value = !showPtt.value;
    showVoice.value = false;
    showEmoji.value = false;
    showExt.value = false;
}

const toggleEmoji = () => {
    uni.hideKeyboard();
    store.toggleChannelMenu(false);
    showEmoji.value = !showEmoji.value;
    showExt.value = false;
    showVoice.value = false;
    showPtt.value = false;
    if (showEmoji.value) {
        emit('panelShow');
    }
}

const toggleExt = () => {
    uni.hideKeyboard();
    store.toggleChannelMenu(false);
    showExt.value = !showExt.value;
    // 每次重新打开都回到第一页，顺带兜住「收藏/投票不可用后页数变少」时 current 越界
    extPageIndex.value = 0;
    showEmoji.value = false;
    showVoice.value = false;
    showPtt.value = false;
    if (showExt.value) {
        emit('panelShow');
    }
}

/** 菜单栏 / 输入框互切。flutter 那边是 setStatus(menuStatus)，语音、表情、扩展面板都要让位 */
const toggleChannelMenu = () => {
    cancelAsrInput();
    uni.hideKeyboard();
    const toMenu = !showChannelMenuBar.value
    store.toggleChannelMenu(toMenu);
    if (toMenu) {
        showVoice.value = false;
        showPtt.value = false;
        showEmoji.value = false;
        showExt.value = false;
    }
}

/**
 * 执行一个菜单项。对齐 flutter `channel_menu_widget.dart` 的 `_handleMenuSelected`：
 * - view：内嵌 WebView 打开链接
 * - click：给频道发一条透传的 ChannelMenuEventMessageContent，由频道后台响应
 * - 其它（miniprogram 等）：给提示，不静默无反应
 */
const handleChannelMenu = (menu: ChannelMenu) => {
    const conversationInfo = props.conversationInfo as ConversationInfo
    if (menu.type == CHANNEL_MENU_TYPE_VIEW) {
        let url = menu.url
        if (url == '') {
            // flutter 那边 url 为空是静默不动作。本项目的规矩是不留哑操作，给一句提示
            toast(t('channel.menu_invalid_url'))
            return
        }
        // 对齐 flutter `Utilities.openLink`：只补 www. 开头的裸域名，其它原样交给 WebView
        if (url.indexOf('://') < 0 && url.indexOf('www.') == 0) {
            url = 'https://' + url
        }
        // 双网前缀互换由 WebViewPage 统一做，这里不重复
        uni.navigateTo({
            url: '/pages/misc/WebViewPage?url=' + encodeURIComponent(url),
            fail: (err) => {
                console.log('nav to WebViewPage err', err)
            }
        } as NavigateToOptions)
    } else if (menu.type == CHANNEL_MENU_TYPE_CLICK) {
        wfc.sendConversationMessage(conversationInfo.conversation, new ChannelMenuEventMessageContent(menu))
    } else {
        toast(t('channel.menu_not_supported'))
    }
}

const onChannelMenuSelect = (e: ChannelMenuSelectEvent) => {
    const menu = e.menu
    if (menu.subMenus.length == 0) {
        handleChannelMenu(menu)
        return
    }
    const items: PopupMenuItem[] = []
    for (let i = 0; i < menu.subMenus.length; i++) {
        items.push(new PopupMenuItem(menu.subMenus[i].name, '' + i))
    }
    subMenus.value = menu.subMenus
    subMenuItems.value = items
    subMenuX.value = e.x
    subMenuY.value = e.y
    showSubMenu.value = true
}

const onSubMenuSelect = (item: PopupMenuItem) => {
    const index = parseInt(item.tag)
    if (index < 0 || index >= subMenus.value.length) {
        return
    }
    handleChannelMenu(subMenus.value[index])
}

/** 群接龙入口：直接进发起接龙页，对齐 flutter `CreateCollectionScreen.show` */
const openCollection = () => {
    const conversationInfo = props.conversationInfo as ConversationInfo
    uni.navigateTo({
        url: '/pages/collection/CreateCollectionPage?groupId=' + conversationInfo.conversation.target,
        fail: (err) => {
            console.log('nav to CreateCollectionPage err', err)
        }
    } as NavigateToOptions)
}

/** 群投票入口：发起投票 / 我的投票，对齐 flutter `PollHomeScreen.show` */
const openPoll = () => {
    const conversationInfo = props.conversationInfo as ConversationInfo
    uni.navigateTo({
        url: '/pages/poll/PollHomePage?groupId=' + conversationInfo.conversation.target,
        fail: (err) => {
            console.log('nav to PollHomePage err', err)
        }
    } as NavigateToOptions)
}

const showPickGroupMemberToVoipModal = (audioOnly: boolean) => {
    const options = new PickUsersOptions()
    options.users = groupMemberUserInfos.value
    options.confirmTitle = '确定'
    options.showCategoryLabel = false
    options.successCB = (users: UserInfo[]): void => {
        const ids: string[] = []
        for (let i = 0; i < users.length; i++) {
            ids.push(users[i].uid)
        }
        const conversationInfo = props.conversationInfo as ConversationInfo
        const callSession = avEngineKit.startMultiCall(conversationInfo.conversation.target, ids, audioOnly)
        // 不加延时的话，选人弹窗关闭动画和跳转会互相干扰
        setTimeout((): void => {
            if (callSession != null) {
                navigateToPage('/pages/voip/Multi', callSession)
            } else {
                uni.showToast({
                    title: '发起通话失败',
                    icon: 'none',
                } as ShowToastOptions)
            }
        }, 50)
    }
    pickUsers(options)
}

const voip = (audioOnly: boolean) => {
    // 单聊那条链路（开关/权限/占线/跳页）与用户详情页共用，见 common/avcall.uts
    const conversationInfo = props.conversationInfo as ConversationInfo
    if (conversationInfo.conversation.type == ConversationType.Single) {
        startSingleCall(conversationInfo.conversation.target, audioOnly)
        return
    }
    if (!Config.ENABLE_VOIP) {
        toast(t('voip.not_supported'))
        return
    }
    checkVoipPermissions(audioOnly).then((granted: boolean): void => {
        if (!granted) {
            return
        }
        const curSession = avEngineKit.currentCallSession()
        if (curSession != null && curSession.state != CallState.STATUS_IDLE) {
            toast(t('voip.in_progress'))
            return
        }
        if (conversationInfo.conversation.type == ConversationType.Group) {
            showPickGroupMemberToVoipModal(audioOnly)
        }
    })
}

const sendUserCard = (user: UserInfo) => {
    const cardMessageContent = new CardMessageContent(0, user.uid, user.displayName, user.portrait, wfc.getUserId())
    cardMessageContent.name = user.name
    const conversationInfo = props.conversationInfo as ConversationInfo
    wfc.sendConversationMessage(conversationInfo.conversation, cardMessageContent)
}

// 名片：选联系人 → 二次确认 → 发送个人名片。
// 确认框由选人页自己弹（options.confirmDialogContent），回到会话页时已经是确认过的结果 ——
// 在这里等转场结束再 showModal 那套在 Android 上不显示，见 common/picker.uts 的注释。
const pickUserCard = () => {
    let users = contactState.favContactList.concat(contactState.friendList)
    const conversationInfo = props.conversationInfo as ConversationInfo
    if (conversationInfo.conversation.type == ConversationType.Single) {
        const target = conversationInfo.conversation.target
        users = users.filter((u: UserInfo): boolean => u.uid != target)
    }
    if (users.length == 0) {
        uni.showToast({
            title: '没有可发送的联系人',
            icon: 'none',
        } as ShowToastOptions)
        return
    }
    const options = new PickUserOptions()
    options.users = users
    options.showCategoryLabel = false
    options.confirmDialogTitle = '发送名片'
    options.confirmDialogContent = (user: UserInfo): string => {
        const name = user._displayName != '' ? user._displayName : user.displayName
        return '发送 ' + name + ' 的名片？'
    }
    options.successCB = (user: UserInfo) => {
        sendUserCard(user)
    }
    pickUser(options)
}

const takePhoto = () => {
    notifyTyping(TypingMessageContent.TYPING_CAMERA);
    uni.chooseImage({
        count: 1,
        sourceType: ['camera'],
        sizeType: ['original', 'compressed'],
        success: (e) => {
            const conversationInfo = props.conversationInfo as ConversationInfo
            for (let i = 0; i < e.tempFilePaths.length; i++) {
                store.sendFile(conversationInfo.conversation, toLocalFilePath(e.tempFilePaths[i]));
            }
        },
        fail: (err) => {
            console.log('take photo fail', err)
        }
    } as ChooseImageOptions)
}

const chooseVideo = () => {
    notifyTyping(TypingMessageContent.TYPING_CAMERA);
    uni.chooseVideo({
        sourceType: ['camera'],
        success: (e) => {
            console.log('choose video', e.tempFilePath);
            const conversationInfo = props.conversationInfo as ConversationInfo
            store.sendFile(conversationInfo.conversation, toLocalFilePath(e.tempFilePath));
        },
        fail: (err) => {
            console.log('choose video fail', err)
        }
    } as ChooseVideoOptions)
}

const shoot = () => {
    uni.showActionSheet({
        itemList: ['拍照', '录像'],
        success: (res) => {
            if (res.tapIndex == 0) {
                takePhoto()
            } else {
                chooseVideo()
            }
        },
        fail: (err) => {
            console.log('show shoot action sheet fail', err)
        }
    } as ShowActionSheetOptions)
}

const chooseImage = () => {
    uni.chooseImage({
        sourceType: ['album', 'camera'],
        sizeType: ['original', 'compressed'],
        success: (e) => {
            console.log('choose image', e.tempFilePaths.length);
            for (let i = 0; i < e.tempFilePaths.length; i++) {
                const conversationInfo = props.conversationInfo as ConversationInfo
                store.sendFile(conversationInfo.conversation, toLocalFilePath(e.tempFilePaths[i]));
            }
        },
        fail: (err) => {
            console.log('choose image fail', err)
        }
    } as ChooseImageOptions)
}

const chooseFile = () => {
    notifyTyping(TypingMessageContent.TYPING_FILE);
    wfc.chooseFile('all', (file: UTSJSONObject) => {
        const path = toLocalFilePath(file.getString('path') ?? '');
        if (path == '') {
            return
        }
        const name = file.getString('name') ?? ''
        const size = file.getNumber('size') ?? 0
        const conversationInfo = props.conversationInfo as ConversationInfo
        store.sendFile(conversationInfo.conversation, path, name, size);
    }, (err: number) => {
        console.error('choose file error', err);
    });
}

const onClickExt = (ext: ExtItem) => {
    console.log('onClick ext', ext.tag);
    // 点扩展项后**不收起**面板，和 emoji 面板点表情后一样保持展开：连着发几张图/几个文件时
    // 不用每次重新点「+」。（之前这里收起面板是想让发完消息后消息列表看着滚到了底，
    // 但滚到底本来就由会话页 messageList 的 watch → scrollToBottom 负责，与面板开合无关。）
    switch (ext.tag) {
        case 'image':
            chooseImage();
            break;
        case 'shot':
            shoot();
            break;
        case 'file':
            chooseFile();
            break;
        case 'voip_a':
            voip(true);
            break;
        case 'voip_v':
            voip(false);
            break;
        case 'userCard':
            pickUserCard();
            break;
        case 'collection':
            openCollection();
            break;
        case 'poll':
            openPoll();
            break;
        default:
            uni.showToast({
                title: 'TODO ' + ext.title,
                icon: 'none'
            } as ShowToastOptions)
            break;
    }
}

const onCategoryClick = (i: number) => {
    currentEmojiStickerIndex.value = i;
}

const onClickEmoji = (emoji: string) => {
    cancelAsrInput();
    text.value = text.value + emoji;
    moveCursorTo(text.value.length);
}

const onClickSticker = (sticker: string) => {
    const stickerMsg = new StickerMessageContent('', sticker, 200, 200)
    const conversationInfo = props.conversationInfo as ConversationInfo
    wfc.sendConversationMessage(conversationInfo.conversation, stickerMsg);
}

const onKeyboardHeightChange = (kbHeight: number, currentKbHeight: number) => {
    // kbHeight 是记住的键盘高度，用作表情/更多面板高度，还没记住过(为 0)时保留默认值
    if (kbHeight > 0) {
        keyboardHeight.value = kbHeight;
    }
    currentKeyboardHeight.value = currentKbHeight;
}

const cancelQuote = () => {
    store.quoteMessage(null);
}

defineExpose({
    insertText,
    mention,
    minimizeMessageInputView,
    onKeyboardHeightChange,
})
</script>

