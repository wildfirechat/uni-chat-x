<template>
    <view class="file-message-container" @tap="clickFile" :class="{ out: isOut }"
        :style="{ backgroundColor: isOut ? c.bubbleSent : c.bubbleReceived }">
        <image class="file-icon" :src="fileIcon" />
        <view class="flex-column flex-align-start file-info">
            <text class="file-name" :style="{ fontSize: fontPx(14), color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">{{ content.name }}</text>
            <text class="file-size single-line" :style="{ fontSize: fontPx(13), color: c.textSecondary }">{{ size }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import FileMessageContent from "@/wfc/messages/fileMessageContent.uts";
import { humanSize, getFiletypeIcon } from "@/pages/util/helper.uts";
import { openFileByDefault } from "@/common/panFileOpen.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "FileMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const isOut = computed<boolean>((): boolean => (props.message as Message).direction == 0)

const content = computed<FileMessageContent>((): FileMessageContent => {
    const message = props.message as Message
    return message.messageContent as FileMessageContent
})

const size = computed<string>((): string => {
    return humanSize(content.value.size)
})

const fileIcon = computed<string>((): string => {
    const fileName = content.value.name;
    const icon = getFiletypeIcon(fileName.substring(fileName.lastIndexOf('.') + 1))
    return "/static/image/filetypes/" + icon;
})

const clickFile = () => {
    // 文档格式在配置了网盘时走在线只读预览；其余（或未配置网盘）保持原系统打开
    openFileByDefault(content.value.name, content.value.remotePath)
}
</script>

<style scoped>
.file-message-container {
    margin: 0 10px;
    padding: 10px;
    position: relative;
    border-radius: 5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    max-width: 220px;
    min-width: 150px;
}

.file-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 3px;
}

.file-info {
    flex: 1;
}

.file-name {
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

</style>
