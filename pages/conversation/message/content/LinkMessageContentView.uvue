<template>
    <view class="link-message-container" @tap="openLink" :style="{ backgroundColor: isOut ? c.bubbleSent : c.bubbleReceived }">
        <view class="link-info">
            <text class="link-title" :style="{ fontSize: fontPx(15), color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">{{ title }}</text>
            <text v-if="content.contentDigest != ''" class="link-digest"
                :style="{ fontSize: fontPx(13), color: c.textTertiary }">{{ content.contentDigest }}</text>
        </view>
        <image v-if="content.thumbnail != ''" class="link-thumbnail" :src="content.thumbnail" mode="aspectFill" />
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import LinkMessageContent from "@/wfc/messages/linkMessageContent.uts";
import { isDocUrl } from "@/api/panDocUrl.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "LinkMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const isOut = computed<boolean>((): boolean => (props.message as Message).direction == 0)

const content = computed<LinkMessageContent>((): LinkMessageContent => {
    const message = props.message as Message
    return message.messageContent as LinkMessageContent
})

const title = computed<string>((): string => {
    const c = content.value
    return c.title.trim() != '' ? c.title : c.url
})

const openLink = () => {
    const url = content.value.url
    if (url == '') {
        return
    }
    // 在线文档页要靠客户端桥取认证码登录，系统浏览器 / 普通 web-view 打不开，必须走内置文档页
    if (isDocUrl(url)) {
        uni.navigateTo({
            url: '/pages/pan/PanDocWebViewPage?url=' + encodeURIComponent(url),
            fail: (err) => {
                console.log('nav to PanDocWebViewPage err', err)
            }
        } as NavigateToOptions)
        return
    }
    uni.navigateTo({
        url: '/pages/misc/WebViewPage?url=' + encodeURIComponent(url),
        fail: (err) => {
            console.log('nav to WebViewPage err', err)
        }
    } as NavigateToOptions)
}
</script>

<style scoped>
.link-message-container {
    margin: 0 10px;
    padding: 10px;
    border-radius: 5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    max-width: 230px;
    min-width: 150px;
}

.link-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.link-title {
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

.link-digest {
    margin-top: 6px;
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

.link-thumbnail {
    width: 45px;
    height: 45px;
    margin-left: 10px;
    border-radius: 3px;
}
</style>
