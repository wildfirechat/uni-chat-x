<template>
    <view class="pick-user-page" :style="{ backgroundColor: c.conversationBg }">
        <NavBar :title="pageTitle" :showBack="true" :rightText="confirmLabel" :rightTextDisabled="checkedUsers.length == 0"
            @rightTextTap="confirm" />

        <!-- 「从组织架构选择」。没配组织服务时整行不展示（同 §M2「宁可不放入口」） -->
        <view v-if="showOrganizationEntry" class="org-entry" :style="{ backgroundColor: c.surface, borderBottomColor: c.hairlineSoft }"
            @tap="pickFromOrganization">
            <!-- flutter 用的是 Icons.corporate_fare（一栋楼），icomoon(Ionicons) 里没有对应字形，
                 取最接近的公文包 ion-briefcase 代替 -->
            <text class="icomoon org-entry-icon" :style="{ color: c.accent, fontSize: iconPx(22) }">&#xf26c;</text>
            <text class="org-entry-title" :style="{ color: c.textPrimary, fontSize: fontPx(16) }">{{ t('pick.from_organization') }}</text>
            <text class="icomoon org-entry-arrow" :style="{ color: c.textTertiary, fontSize: iconPx(16) }">&#xf3d1;</text>
        </view>

        <!--
            已选头像 + 搜索框同处一条（对齐 flutter conversation 的 PickUserScreen）：
            头像横向滚动区限宽，输入框占剩下的部分。
        -->
        <view class="search-bar" :style="{ backgroundColor: c.surface }">
            <view class="search-box" :style="{ backgroundColor: c.inputBg }">
                <text class="icomoon search-icon" :style="{ color: c.iconSecondary, fontSize: iconPx(16) }">&#xf21f;</text>
                <!-- 头像必须是 scroll-view 的**直接子元素**，中间不能再套一层容器：
                     scroll-view 的可滚动内容宽度按直接子元素的 `getLayoutLeft() + getLayoutWidth()`
                     算（鸿蒙 runtime `UniScrollViewElement.getWrapperSize`），套 wrapper 的话 wrapper
                     自己被拉伸成 scroll-view 的宽度，内容宽度就永远等于可视宽度 —— 超出的头像
                     照样排出来了，但既被裁掉又滚不到。同 OrganizationPage 的面包屑。
                     横排靠 .picked-strip 自己的 flex-direction: row，direction="horizontal"
                     只管滚动方向，不改排版方向。 -->
                <scroll-view v-if="checkedUsers.length > 0" class="picked-strip" direction="horizontal"
                    :show-scrollbar="false" :scroll-with-animation="true" :scroll-into-view="pickedScrollIntoView"
                    :style="{ width: pickedStripWidth + 'px' }">
                    <image v-for="(user, index) in checkedUsers" :key="index" class="picked-avatar" :id="'pk-' + index"
                        :src="user.portrait" :style="{ backgroundColor: c.inputBg }" @tap="unpick(user)" />
                </scroll-view>
                <input class="search-input" type="text" :placeholder="t('common.search')" v-model="filterQuery"
                    :style="{ color: c.textPrimary, fontSize: fontPx(14) }" />
            </view>
        </view>

        <list-view class="friend-list" direction="vertical" :scroll-into-view="scrollIntoViewId" :show-scrollbar="false">
            <CheckableUserListView ref="userListView" :users="filteredUsers" :initial-checked-users="initialCheckedUsers"
                :uncheckable-users="uncheckableUsers" :show-category-label="showCategoryLabel && filterQuery == ''"
                :anchor-prefix="ANCHOR_PREFIX" :max-checked-count="maxSelected" @maxExceeded="onMaxExceeded"
                padding-left="16px" padding-right="32px" />
        </list-view>

        <!-- 右侧字母索引条。搜索态下分类标签本来就不显示，quickIndexCategories 会返回空数组，索引条一并收起 -->
        <quick-index-bar :categories="quickIndexCategories" :top="listTop" :bottom="16" @select="jumpToCategory"
            @backToTop="scrollToTop" />
        <watermark-overlay />
    </view>
</template>

<script setup lang="uts">
/**
 * 多选联系人页。对齐 `../flutter-chat/chat/lib/contact/pick_user_screen.dart`（移动端形态）。
 *
 * 与改版前的差别（这一版是 M4 按 flutter 重做的）：
 * - 确认按钮从底部面板挪到标题栏右上角，文案是「完成(n)」——「已选联系人」那块底部面板
 *   在 flutter 里不存在，已选的人以头像形式内嵌在搜索框左侧
 * - 补上右侧字母索引条（flutter `widget/sidebar_index.dart`）
 * - 补上 maxSelected 上限与「从组织架构选择」入口
 *
 * 与 flutter 的刻意差异：
 * - flutter 单选（maxSelected == 1）也走同一个页面，点一下就回调；uni 侧单选一直是独立的
 *   PickSingleUserPage，保持不动
 */
import store, { pickState } from "@/store.uts";
import Config from "@/config.uts";
import NavBar from "@/pages/common/NavBar.uvue";
import CheckableUserListView from "@/pages/user/CheckableUserListView.uvue";
import UserInfo from "@/wfc/model/userInfo.uts";
import wfc from "@/wfc/client/wfc.uts";
import {
    currentPickUsersOptions, notifyPickedUsers,
    pickOrganizationUsers, PickOrganizationUsersOptions
} from "@/common/picker.uts";
import { anchorIdForCategory } from "@/common/pinyin.uts";
import { toast } from "@/common/prompt.uts";
import { t, t1 } from "@/i18n/i18n.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx, iconPx } from "@/common/layoutScale.uts";

defineOptions({
    name: "PickUserPage"
})

const ANCHOR_PREFIX = 'pick-label-'
/** NavBar 的固定栏高，见 pages/common/NavBar.uvue */
const NAV_BAR_HEIGHT = 44
/** .org-entry 的行高 */
const ORG_ENTRY_HEIGHT = 56
/** .search-bar 的上下 padding 8 + .search-box 高 36 */
const SEARCH_BAR_HEIGHT = 52

const c = computed<AppColors>((): AppColors => colors())
const users = ref<UserInfo[]>([] as UserInfo[])
const initialCheckedUsers = ref<UserInfo[]>([] as UserInfo[])
const uncheckableUsers = ref<UserInfo[]>([] as UserInfo[])
const confirmTitle = ref<string>('确定')
const pageTitle = ref<string>(t('pick.pick_contact'))
const maxSelected = ref<number>(1024)
const showOrganizationEntry = ref<boolean>(false)
const showCategoryLabel = ref<boolean>(true)
const filterQuery = ref<string>('')

const userListView = ref<ComponentPublicInstance | null>(null)
const scrollIntoViewId = ref<string>('')
/** 已选头像条要滚到的那个头像的 id，见下面的 watch */
const pickedScrollIntoView = ref<string>('')
const statusBarHeight = ref<number>(0)

/** 列表区顶边，索引条按它垂直居中 */
const listTop = computed<number>((): number => {
    const entry = showOrganizationEntry.value ? ORG_ENTRY_HEIGHT : 0
    return statusBarHeight.value + NAV_BAR_HEIGHT + entry + SEARCH_BAR_HEIGHT
})

/** 回调只给「新选中的」，预先勾上的（已在群里那些）不算 */
const checkedUsers = computed<UserInfo[]>((): UserInfo[] => {
    const picked = pickState.users;
    if (initialCheckedUsers.value.length == 0) {
        return picked;
    }
    return picked.filter((u: UserInfo): boolean => {
        return initialCheckedUsers.value.findIndex((iu: UserInfo): boolean => iu.uid == u.uid) == -1
    })
})

/**
 * 已选头像条的宽度。窗口宽减去搜索图标、内边距和留给输入框的最小宽度，
 * 不给定宽的话头像条会把输入框挤没。
 *
 * 必须排在 [checkedUsers] 后面：android 上 setup 里的 const 落成顺序执行的 val，引用不到后面声明的。
 */
const pickedStripWidth = computed<number>((): number => {
    const winWidth = uni.getSystemInfoSync().windowWidth
    const avail = winWidth - 140
    const want = checkedUsers.value.length * 34
    return want < avail ? want : avail
})

/**
 * 新选中一个人后，把最后那个头像滚进可视范围（同 OrganizationPage 面包屑的 `_keepCurrentCrumbVisible`：
 * 目标节点靠右时 runtime 自己会 clamp 到最大滚动距离，等价于滚到底）。
 *
 * 只在人数**变多**时触发：取消选择会让后面的头像整体左移，本来就不会漏在可视区外，
 * 这时再拽到末尾反而把用户手动滚过的位置拉走。
 *
 * 先置空再赋值：scroll-into-view 是属性，值没变不会重新触发。
 * 延一帧再赋值是等新头像布局完成，`_scrollToItem` 要靠 getBoundingClientRect 算偏移；
 * 同时 .picked-strip 的宽度也是这一帧才变宽的。
 */
watch(checkedUsers, (newUsers: UserInfo[], oldUsers: UserInfo[]) => {
    pickedScrollIntoView.value = ''
    if (newUsers.length <= oldUsers.length || newUsers.length == 0) {
        return
    }
    const targetId = 'pk-' + (newUsers.length - 1)
    setTimeout(() => {
        pickedScrollIntoView.value = targetId
    }, 50)
})

const confirmLabel = computed<string>((): string => {
    const n = checkedUsers.value.length
    return n > 0 ? confirmTitle.value + '(' + n + ')' : confirmTitle.value
})

const filteredUsers = computed<UserInfo[]>((): UserInfo[] => {
    if (filterQuery.value != '') {
        return store.filterUsers(users.value, filterQuery.value);
    } else {
        return users.value;
    }
})

/** 索引条只在非搜索态、且确实分了组时出现 */
const quickIndexCategories = computed<string[]>((): string[] => {
    if (filterQuery.value != '' || !showCategoryLabel.value) {
        return [] as string[]
    }
    const categories: string[] = []
    const list = filteredUsers.value
    let last = ''
    for (let i = 0; i < list.length; i++) {
        const category = list[i]._category
        if (category != last) {
            last = category
            categories.push(category)
        }
    }
    return categories
})

onLoad((_options: OnLoadOptions) => {
    const options = currentPickUsersOptions()
    if (options != null) {
        users.value = options.users;
        initialCheckedUsers.value = options.initialCheckedUsers;
        uncheckableUsers.value = options.uncheckableUsers;
        showCategoryLabel.value = options.showCategoryLabel;
        confirmTitle.value = options.confirmTitle;
        maxSelected.value = options.maxSelected;
        if (options.title != '') {
            pageTitle.value = options.title
        }
        // 没配组织服务时这一行点了也拉不到数据，直接不放
        showOrganizationEntry.value = options.showOrganizationEntry && Config.getOrganizationServer() != ''
    }
})

onUnload(() => {
    pickState.users = []
})

onMounted(() => {
    statusBarHeight.value = uni.getSystemInfoSync().statusBarHeight
})

const isUserUncheckable = (user: UserInfo): boolean => {
    return uncheckableUsers.value.findIndex((u: UserInfo): boolean => u.uid == user.uid) >= 0;
}

const unpick = (user: UserInfo) => {
    if (isUserUncheckable(user)) {
        return;
    }
    store.pickOrUnpickUser(user);
}

const onMaxExceeded = () => {
    toast(t1('pick.max_user_limit', '' + maxSelected.value))
}

/**
 * 滚到某个锚点。`scroll-into-view` 只在值变化时生效，所以重复选同一个分类要先清空再置值；
 * 而索引条上滑动切换时前后两次是不同分类，直接赋值即可 —— 那条路径每帧都会走，
 * 不能白挨一次 setTimeout。
 */
const scrollToAnchor = (targetId: string) => {
    if (scrollIntoViewId.value != targetId) {
        scrollIntoViewId.value = targetId
        return
    }
    scrollIntoViewId.value = ''
    setTimeout(() => {
        scrollIntoViewId.value = targetId
    }, 16)
}

const jumpToCategory = (category: string) => {
    // 还没进渲染窗口的分类没有锚点节点，先让列表把那一段渲染出来
    const listView = userListView.value
    if (listView != null) {
        (listView as ComponentPublicInstance).$callMethod('ensureCategoryRendered', category)
    }
    scrollToAnchor(anchorIdForCategory(ANCHOR_PREFIX, category))
}

/** 本页列表顶部就是第一个分类标签，没有单独的表头行，「↑」直接跳第一个分类 */
const scrollToTop = () => {
    const categories = quickIndexCategories.value
    if (categories.length == 0) {
        return
    }
    jumpToCategory(categories[0])
}

/**
 * 从组织架构补选。把「还能选几个」和「已选/不可选」带过去，回来后按 uid 取 UserInfo 补进已选。
 * 对齐 flutter `_openOrganizationPicker`。
 */
const pickFromOrganization = () => {
    const remaining = maxSelected.value - checkedUsers.value.length
    if (remaining <= 0) {
        onMaxExceeded()
        return
    }
    const selectedIds: string[] = []
    const picked = pickState.users
    for (let i = 0; i < picked.length; i++) {
        selectedIds.push(picked[i].uid)
    }
    const disabledIds: string[] = []
    for (let i = 0; i < uncheckableUsers.value.length; i++) {
        disabledIds.push(uncheckableUsers.value[i].uid)
    }

    const options = new PickOrganizationUsersOptions()
    options.maxSelected = remaining
    options.initialSelectedUserIds = selectedIds
    options.disabledUserIds = disabledIds
    options.successCB = (userIds: string[]) => {
        for (let i = 0; i < userIds.length; i++) {
            if (checkedUsers.value.length >= maxSelected.value) {
                break
            }
            const uid = userIds[i]
            if (pickState.users.findIndex((u: UserInfo): boolean => u.uid == uid) >= 0) {
                continue
            }
            store.pickOrUnpickUser(wfc.getUserInfo(uid, false))
        }
    }
    pickOrganizationUsers(options)
}

/**
 * 不包含默认选中的用户
 */
const confirm = () => {
    const picked = checkedUsers.value.slice(0);
    pickState.users = []

    uni.navigateBack({} as NavigateBackOptions);
    notifyPickedUsers(picked);
}
</script>

<style scoped>
/* 组件吃不到全局 class（样式隔离 2.0），图标字体自己声明一份，见 M0「写组件的两个静默坑」 */
.icomoon {
    font-family: "icomoon";
}

.pick-user-page {
    display: flex;
    flex-direction: column;
    position: relative;
    flex: 1;
    width: 100%;
    overflow: hidden;
}

.org-entry {
    height: 56px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.org-entry-icon {
    width: 24px;
    margin-right: 16px;
}

/* 要截断的文字自己 flex:1，右侧箭头 flex-shrink:0，不放占位 view（见 M0 第 2 个坑） */
.org-entry-title {
    flex: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.org-entry-arrow {
    flex-shrink: 0;
}

.search-bar {
    padding: 8px 16px;
}

.search-box {
    height: 36px;
    border-radius: 6px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
}

.search-icon {
    margin-right: 8px;
    flex-shrink: 0;
}

/* 排版方向由这里给：direction="horizontal" 只改滚动轴，不改 flex 主轴。
 * 主轴变成横向后，头像按 left 依次排开、超出可视宽度也照排，scroll-view 才量得出
 * 大于自身宽度的内容宽度。 */
.picked-strip {
    height: 30px;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
}

/* flex-shrink: 0 是关键：默认会被压缩到刚好塞进这条的宽度，那样内容宽度永远等于可视宽度，
 * 既滚不动、头像又被挤扁 */
.picked-avatar {
    width: 30px;
    height: 30px;
    border-radius: 4px;
    margin-right: 4px;
    flex-shrink: 0;
}

.search-input {
    flex: 1;
    height: 30px;
}

.friend-list {
    flex: 1;
}

</style>
