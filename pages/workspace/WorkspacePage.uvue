<template>
    <view class="page-root">
        <web-view id="workspace-webview" class="webview" :src="url" @message="handlePostMessage"></web-view>
        <!-- web-view 自己不能有子节点，水印只好包一层 view 挂在它旁边 -->
        <watermark-overlay />
    </view>
</template>

<script setup lang="uts">
import { WorkspaceBridge } from './bridgeServerImpl.uts'
import { webViewMessageObjs } from './webViewMessage.uts'
import Config from "../../config.uts";
import { redirectMediaUrl } from "../../common/mediaUrlRedirector.uts";

// 双网下工作台地址按 IM 当前连接的网络在主备地址之间选，见 Config.WORKSPACE_URL_BACKUP
const url = ref<string>(Config.getWorkspaceUrl())
const bridge = ref<WorkspaceBridge>(new WorkspaceBridge())

onLoad((options: OnLoadOptions) => {
    const urlValue = options['url'] ?? ''
    if (urlValue != '') {
        url.value = redirectMediaUrl(urlValue);
    }
})

onReady(() => {
    // FYI https://doc.dcloud.net.cn/uni-app-x/api/create-webview-context.html
    //早期，本API的大小写不规范，createWebviewContext的view的首字母v没有大写。
    // 目前不规范的API已经废弃，推荐使用上方的uni.createWebViewContext。
    // app-android 平台在蒸汽模式下仅支持V大写的方式 ，不再支持向下兼容写法。
    // 非蒸汽模式时，可能需要改成小写版本
    const webviewContext = uni.createWebViewContext('workspace-webview', getCurrentInstance()!.proxy!)
    bridge.value.init(webviewContext);
})

const handlePostMessage = (event: UniWebViewMessageEvent) => {
    webViewMessageObjs(event).forEach((obj: string) => {
        bridge.value.messageFromWebView(obj)
    })
}
</script>

<style scoped>
.page-root {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.webview {
    flex: 1;
}
</style>
