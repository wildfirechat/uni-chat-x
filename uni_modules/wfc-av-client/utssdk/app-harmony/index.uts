/**
 * 音视频通话 UTS 插件（鸿蒙）。
 *
 * 和 Android/iOS 完全不同的一点：鸿蒙版音视频 SDK（@wfc/avenginekit，即 libs/avenginekit.har，
 * 取自原生鸿蒙工程 hm-chat）不是自包含的原生库，而是一份 **ArkTS 写的 WebRTC 信令实现**，它：
 *   1. 通过 @ohos/webrtc 建 PeerConnection、收发媒体流；
 *   2. 通过硬编码的 `@wfc/client` 包收发信令消息（getUserId/sendConversationMessage/…）。
 * 本项目的 IM 层是 UTS 写的，不存在这个 ArkTS 包，因此提供了一份最小适配层
 * （wfcclient.har，包名就叫 @wfc/client，底层复用 @wfc/marswrapper 同一个
 * libmarswrapper.so 实例）。源码在 harmony-configs/wfcclient/，改完要跑那里的
 * build-har.sh 重新生成 har，详见该目录的 README.md。
 * avenginekit、webrtc 在 utssdk/app-harmony/config.json 里声明；@wfc/client 和对讲插件共用，
 * 声明在工程根 harmony-configs/oh-package.json5 里（har 在 harmony-configs/libs/）。
 *
 * 三条链路：
 *   - 出信令：引擎 → @wfc/client 适配层 → marswrapper.sendMessage
 *   - 入信令：marswrapper → UTS 侧 wfc.uts → EventType.ReceiveProtoMessages
 *             → avEngineKit.uts → 本插件 dispatchReceivedMessages()
 *             → messageBridge.ets 解码后 emit 到 ability eventHub（引擎在此监听）
 *   - 视频画面：页面 <native-view> → bindHarmonyWrappedBuilder(videoBuilder.ets)
 *             → XComponent + WFCVideoRenderController.setVideoTrack()
 *
 * 对外导出的函数签名与 app-android/index.uts 一一对应，应用层
 * （wfc/av/engine/avEngineKit.uts）不区分平台。
 */

import { NativeEventListener } from '../interface.uts'
import { buildVideoView } from './videoBuilder.ets'
import { dispatchProtoMessages, emitConferenceEvent } from './messageBridge.ets'
import {
    setVoipMinimizeTexts,
    startVoipBackgroundTask,
    stopVoipBackgroundTask,
    setupVoipResume,
    setVoipAutoMinimizeCallback,
    prepareVoipPiP,
    startVoipPiP,
    destroyVoipPiP
} from './voipMinimize.ets'

import avengineKitImpl from '@wfc/avenginekit'
import WfcAVEngineKit from '@wfc/avenginekit/src/main/ets/wfc/av/engine/avenginekit'
import AVEngineCallback from '@wfc/avenginekit/src/main/ets/wfc/av/engine/avengineCallback'
import CallSession from '@wfc/avenginekit/src/main/ets/wfc/av/engine/callSession'
import CallSessionCallback from '@wfc/avenginekit/src/main/ets/wfc/av/engine/callSessionCallback'
import CallState from '@wfc/avenginekit/src/main/ets/wfc/av/engine/callState'
import ParticipantProfile from '@wfc/avenginekit/src/main/ets/wfc/av/engine/participantProfile'
import WFCVideoRenderController, { ScalingMode } from '@wfc/avenginekit/src/main/ets/wfc/av/xcomponent/WFCVideoRenderController'

import wfcShim from '@wfc/client'
import Config from '@wfc/client/src/main/ets/config'
import Conversation from '@wfc/client/src/main/ets/wfc/model/conversation'
import ConversationType from '@wfc/client/src/main/ets/wfc/model/conversationType'

import { VideoTrack } from '@ohos/webrtc/src/main/libohos_webrtc/webrtc'

import { common } from '@kit.AbilityKit'
import abilityAccessCtrl, { PermissionRequestResult, Permissions } from '@ohos.abilityAccessCtrl'
import { BusinessError } from '@kit.BasicServicesKit'
import audio from '@ohos.multimedia.audio'
import AVSessionManager from '@ohos.multimedia.avsession'
import { window } from '@kit.ArkUI'

const TAG = 'wfc-av-harmony'

let avEngineEventListener: NativeEventListener | null = null
let callSessionEventListener: NativeEventListener | null = null
let initialized = false
let iceServerReplaced = false
let abilityContext: common.UIAbilityContext | null = null
let avSession: AVSessionManager.AVSession | null = null
// 当前通话的会话，用来在通话结束时算时长（那时引擎已经把 currentSession 置空了）
let activeSession: CallSession | null = null
// 最近一次挂断原因，由 CallSessionCallback.didCallEndWithReason 记录，见 didCallEnded 的注释
let lastCallEndReason = 0
// 最近一次 didCreateLocalVideoTrack 给出的本地轨道。
// 为什么要缓存：引擎的 getParticipantVideoTrack(自己) 只会返回 previewStream/cameraVideoStream，
// **拿不到 screenShareStream**；而 SCREEN_SHARING_REPLACE_MODE 下开始共享时摄像头轨道已被停掉，
// 再去查就只能查到一条死轨道，本地预览会定格。所以本地视图一律优先用这里缓存的轨道。
let localVideoTrack: VideoTrack | null = null

// <native-view> 元素 -> 绑定在它上面的视频渲染信息。
// 轨道可能在视图创建之后才产生（本地流是异步开的，远端流要等对方连上），
// 所以这里记住每个视图“想显示谁”，等 didCreateLocalVideoTrack /
// didReceiveRemoteVideoTrack 回调时再回填。
class VideoViewHolder {
    controller: WFCVideoRenderController
    // 空字符串表示本地预览
    userId: string
    screenSharing: boolean

    constructor(controller: WFCVideoRenderController, userId: string, screenSharing: boolean) {
        this.controller = controller
        this.userId = userId
        this.screenSharing = screenSharing
    }
}

const videoViews = new Map<UniNativeViewElement, VideoViewHolder>()

// videoBuilder.ets 里 buildVideoView 的参数类型
interface VideoViewParams {
    id: string
    controller: WFCVideoRenderController
}

const videoViewBuilder = wrapBuilder<[VideoViewParams]>(buildVideoView)

function context(): common.UIAbilityContext {
    if (abilityContext == null) {
        abilityContext = getContext() as common.UIAbilityContext
    }
    return abilityContext!
}

function currentSessionOrNull(): CallSession | null {
    const session = avengineKitImpl.getCurrentSession()
    return session == undefined ? null : session!
}

function sessionOf(callId: string): CallSession | null {
    const session = currentSessionOrNull()
    if (session == null || session.callId != callId) {
        return null
    }
    return session
}

function conversationToJson(conv: Conversation | null): UTSJSONObject {
    if (conv == null) {
        return {
            type: ConversationType.Single,
            target: '',
            line: 0,
        }
    }
    return {
        type: conv.type,
        target: conv.target,
        line: conv.line,
    }
}

function callSessionToJson(session: CallSession): string {
    const obj = {
        callId: session.callId,
        // 鸿蒙 SDK 没有单独的 inviter 概念，发起人即邀请人
        initiator: session.initiatorId,
        inviter: session.initiatorId,
        state: session.status,
        startTime: session.startTime,
        connectedTime: session.connectedTime,
        endTime: session.endTime,
        conversation: conversationToJson(session.conversation),
        audioOnly: session.audioOnly,
        // 鸿蒙 CallSession 上没有 endReason 字段，挂断原因只通过 didCallEndWithReason 回调给出
        endReason: 0,
        conference: session.conference,
        audience: session.audience,
        defaultAudience: session.defaultAudience,
        advanced: session.advance,
        audioMuted: session.audioMuted,
        videoMuted: session.videoMuted,
        title: session.title,
        desc: session.desc,
        pin: session.pin,
        host: session.host,
        multiCall: session.getParticipantIds().length > 1,
    }
    return JSON.stringify(obj)
}

function participantProfileToJson(p: ParticipantProfile): UTSJSONObject {
    return {
        userId: p.userId,
        // 应用层的 ParticipantProfile 用的是 Android/iOS 的字段名：state/startTime
        state: p.status,
        startTime: p.joinTime,
        videoMuted: p.videoMuted,
        audioMuted: p.audioMuted,
        audience: p.audience,
        screenSharing: p.screenSharing,
    }
}

/**
 * args 只能放基本类型和纯数据，SDK 回调传进来的对象（CallSession / VideoTrack 等）一律不能直接放进来：
 * 它们内部有循环引用，JSON.stringify 会抛 "stack contains value, usually caused by circular structure"。
 * 这里兜一层 try/catch，是为了万一某个回调的实参和 .d.ets 签名对不上（SDK 里确实有，见
 * NativeAVEngineCallback.didCallEnded 的注释），异常不要顺着回调抛回引擎里把后续逻辑打断。
 */
function fireEvent(listener: NativeEventListener | null, event: string, args: Array<any>): void {
    if (listener == null) {
        return
    }
    let argsJson: string
    try {
        argsJson = JSON.stringify(args)
    } catch (e) {
        console.error(TAG, '事件参数序列化失败，请检查实参类型', event, e)
        return
    }
    listener!(event, argsJson)
}

function fireAVEngineEvent(event: string, args: Array<any>): void {
    fireEvent(avEngineEventListener, event, args)
}

function fireCallSessionEvent(event: string, args: Array<any>): void {
    fireEvent(callSessionEventListener, event, args)
}

// ------------------------------------------------------------------
// 视频画面
// ------------------------------------------------------------------

function trackOf(userId: string, screenSharing: boolean): VideoTrack | null {
    const session = currentSessionOrNull()
    if (session == null) {
        return null
    }
    // getParticipantVideoTrack 传自己的 userId 时返回本地流
    const uid = userId == '' ? wfcShim.getUserId() : userId
    if (uid == wfcShim.getUserId() && localVideoTrack != null) {
        // 见 localVideoTrack 的声明：屏幕共享期间查不到共享轨道，只能用回调缓存下来的那条
        return localVideoTrack
    }
    return session.getParticipantVideoTrack(uid, screenSharing)
}

function applyTrack(holder: VideoViewHolder): void {
    const track = trackOf(holder.userId, holder.screenSharing)
    if (track != null) {
        holder.controller.setVideoTrack(track!)
    }
}

/**
 * 轨道变化（本地流创建、远端流到达）后，把相关视图的画面刷一遍。
 * userId 传空字符串表示全刷一遍（本地流刚创建时用，顺带把还没拿到轨道的远端视图也补上）。
 */
function refreshVideoViews(userId: string): void {
    videoViews.forEach((holder: VideoViewHolder, _element: UniNativeViewElement) => {
        if (userId == '' || holder.userId == userId) {
            applyTrack(holder)
        }
    })
}

/** 远端流结束时把对应视图的画面撤掉，否则会定格在最后一帧 */
function clearVideoViewsOf(userId: string): void {
    videoViews.forEach((holder: VideoViewHolder, _element: UniNativeViewElement) => {
        if (holder.userId == userId) {
            holder.controller.setVideoTrack()
        }
    })
}

function holderOf(element: UniNativeViewElement, userId: string, screenSharing: boolean): VideoViewHolder {
    let holder = videoViews.get(element)
    if (holder == null) {
        // 一个 native-view 只能 bind 一次 builder，所以 controller 要跟着元素复用
        const controller = new WFCVideoRenderController(userId == '' ? 'local' : userId)
        const params: VideoViewParams = {
            id: userId == '' ? 'wfc-local-video' : ('wfc-video-' + userId + (screenSharing ? '-ss' : '')),
            controller: controller,
        }
        element.bindHarmonyWrappedBuilder(videoViewBuilder, params)
        holder = new VideoViewHolder(controller, userId, screenSharing)
        videoViews.set(element, holder!)
    } else {
        holder!.userId = userId
        holder!.screenSharing = screenSharing
    }
    return holder!
}

function clearVideoViews(): void {
    videoViews.forEach((holder: VideoViewHolder, _element: UniNativeViewElement) => {
        holder.controller.setVideoTrack()
    })
    videoViews.clear()
}

// ------------------------------------------------------------------
// 通话期间的系统能力：AVSession + 常亮。
// 长时任务（后台保活 + 通知栏那条「通话中」）和画中画在 voipMinimize.ets 里。
// ------------------------------------------------------------------

function setKeepScreenOn(on: boolean): void {
    window.getLastWindow(context()).then((win: window.Window) => {
        win.setWindowKeepScreenOn(on)
    }).catch((err: BusinessError) => {
        console.error(TAG, 'setWindowKeepScreenOn failed', err.code, err.message)
    })
}

function onCallStarted(session: CallSession): void {
    activeSession = session
    // 0 = CallEndReason.REASON_Unknown，避免万一没收到 didCallEndWithReason 时用上一通电话的原因
    lastCallEndReason = 0
    const type: AVSessionManager.AVSessionType = session.audioOnly ? 'voice_call' : 'video_call'
    AVSessionManager.createAVSession(context(), 'voip', type).then((s: AVSessionManager.AVSession) => {
        avSession = s
        s.activate()
    }).catch((err: BusinessError) => {
        console.error(TAG, 'createAVSession failed', err.code, err.message)
    })
    startVoipBackgroundTask(context())
    // 画中画控制器要提前建好：PiPWindow.create 是异步的，而 minimize() 一返回应用层立刻 pop 通话页，
    // 那时再建来不及。建失败不影响通话，只是最小化时进不了画中画（见 voipMinimize.ets 的日志）。
    prepareVoipPiP(context())
    setKeepScreenOn(true)
}

function onCallStopped(): void {
    activeSession = null
    localVideoTrack = null
    if (avSession != null) {
        avSession!.deactivate()
        avSession!.destroy()
        avSession = null
    }
    destroyVoipPiP()
    stopVoipBackgroundTask(context())
    setKeepScreenOn(false)
}

/**
 * 通话时长（秒），语义对齐 Android/iOS 的 didCallEnded(reason, duration)：没接通就挂断的记 0。
 * 鸿蒙 CallSession 的 connectedTime 是接通那一刻才赋值的（此前是 undefined），
 * 所以这里用「算出来不大于 0 就当 0」的写法兜住 NaN。
 */
function callDuration(): number {
    if (activeSession == null) {
        return 0
    }
    const session = activeSession!
    const end = session.endTime > 0 ? session.endTime : Date.now()
    const seconds = Math.floor((end - session.connectedTime) / 1000)
    return seconds > 0 ? seconds : 0
}

// ------------------------------------------------------------------
// 引擎回调
// ------------------------------------------------------------------

class NativeAVEngineCallback extends AVEngineCallback {

    constructor(ctx: common.UIAbilityContext) {
        super(ctx)
    }

    // 注意：鸿蒙版引擎自己不会调 shouldStartRing（对比 Android 原生 SDK 会调），
    // 铃声由回调实现方在收到来电/发起通话时主动触发，这点和 hm-chat 的
    // AVEngineCallbackImpl 保持一致。
    override async onReceiveCall(session: CallSession): Promise<void> {
        onCallStarted(session)
        fireAVEngineEvent('onReceiveCall', [callSessionToJson(session)])
        fireAVEngineEvent('shouldStartRing', [true])
    }

    override onStartCall(session: CallSession): void {
        onCallStarted(session)
        fireAVEngineEvent('shouldStartRing', [false])
    }

    override onJoinConference(session: CallSession): void {
        // 建房/入会成功的回调。会议页面的跳转由应用层在 startConference/joinConference 拿到
        // 会话后自己做（和 Android/iOS 一致，那两端没有这个回调），这里只负责起长时任务、
        // AVSession 和屏幕常亮。
        onCallStarted(session)
    }

    override shouldStartRing(isIncoming: boolean): void {
        fireAVEngineEvent('shouldStartRing', [isIncoming])
    }

    override shouldStopRing(): void {
        fireAVEngineEvent('shouldStopRing', [])
    }

    // 形参一个都不能用：鸿蒙 SDK 的实参和它自己的 .d.ets 签名（reason: CallEndReason, duration?: number）
    // 对不上，引擎里写的是 `callback.didCallEnded(this)`，传进来的是 CallSession 对象而不是挂断原因
    // （duration 也就永远是默认值）。CallSession 内部持有 PeerConnection、定时器等循环引用，
    // 塞给 JSON.stringify 会抛 "stack contains value, usually caused by circular structure"，
    // 一抛应用层就收不到 didCallEnded，铃声停不了、通话页也退不回去。
    // 所以原因取挂断前一步 didCallEndWithReason 记下的 lastCallEndReason，时长自己按会话时间算。
    override didCallEnded(_reason: number, _duration: number = 0): void {
        const reason = lastCallEndReason
        // 要在 onCallStopped() 清掉 activeSession 之前算
        const duration = callDuration()
        clearVideoViews()
        onCallStopped()
        fireAVEngineEvent('didCallEnded', [reason, duration])
    }
}

function createCallSessionCallback(): CallSessionCallback {
    const cb = new CallSessionCallback()
    cb.didCallEndWithReason = (reason: number) => {
        // 引擎紧接着就会调 AVEngineCallback.didCallEnded，但那里拿不到原因，只能在这里记下来
        lastCallEndReason = reason
        fireCallSessionEvent('didCallEndWithReason', [reason])
    }
    cb.didChangeState = (state: number) => {
        fireCallSessionEvent('didChangeState', [state])
    }
    cb.didParticipantJoined = (userId: string, screenSharing: boolean = false) => {
        fireCallSessionEvent('didParticipantJoined', [userId, screenSharing])
    }
    cb.didParticipantConnected = (userId: string, screenSharing: boolean = false) => {
        fireCallSessionEvent('didParticipantConnected', [userId, screenSharing])
    }
    cb.didParticipantLeft = (userId: string, callEndReason: number, screenSharing: boolean = false) => {
        fireCallSessionEvent('didParticipantLeft', [userId, callEndReason, screenSharing])
    }
    cb.didChangeMode = (audioOnly: boolean) => {
        fireCallSessionEvent('didChangeMode', [audioOnly])
    }
    cb.didChangeInitiator = (initiator: string) => {
        fireCallSessionEvent('didChangeInitiator', [initiator])
    }
    cb.didCreateLocalVideoTrack = (videoTrack: VideoTrack, _screenSharing: boolean) => {
        localVideoTrack = videoTrack
        refreshVideoViews('')
        fireCallSessionEvent('didCreateLocalVideoTrack', [])
    }
    cb.didScreenShareEnded = () => {
        // 只有 stopScreenShare() 里会发这条；SCREEN_SHARING_REPLACE_MODE 下摄像头轨道是异步重建的，
        // 重建完引擎会再发一次 didCreateLocalVideoTrack(track, false)，本地预览由那一下负责恢复。
        fireCallSessionEvent('didScreenShareEnded', [])
    }
    cb.didReceiveRemoteVideoTrack = (userId: string, _track: VideoTrack, screenSharing: boolean) => {
        refreshVideoViews(userId)
        fireCallSessionEvent('didReceiveRemoteVideoTrack', [userId, screenSharing])
    }
    cb.didRemoveRemoteVideoTrack = (userId: string) => {
        clearVideoViewsOf(userId)
        fireCallSessionEvent('didRemoveRemoteVideoTrack', [userId])
    }
    cb.didVideoMuted = (userId: string, muted: boolean) => {
        fireCallSessionEvent('didVideoMuted', [userId, muted])
    }
    cb.didReportAudioVolume = (userId: string, volume: number) => {
        fireCallSessionEvent('didReportAudioVolume', [userId, volume])
    }
    cb.didChangeType = (userId: string, audience: boolean, screenSharing: boolean = false) => {
        fireCallSessionEvent('didChangeType', [userId, audience, screenSharing])
    }
    cb.didMuteStateChanged = (participants: string[]) => {
        // args[0] 统一约定为字符串（JSON 数组文本），与 Android/iOS 一致，应用层再 parse 一次
        fireCallSessionEvent('didMuteStateChanged', [JSON.stringify(participants)])
    }
    return cb
}

// ------------------------------------------------------------------
// 对外 API
// ------------------------------------------------------------------

export function onAVEngineEvent(listener: NativeEventListener): void {
    avEngineEventListener = listener
}

export function onCallSessionEvent(listener: NativeEventListener): void {
    callSessionEventListener = listener
}

export function initAVEngineKit(): void {
    if (initialized) {
        return
    }
    initialized = true
    const ctx = context()
    // 每次通话新建的 CallSession 都会从这里取回调，来电/去电都覆盖到
    avengineKitImpl.sessionCallback = createCallSessionCallback()
    avengineKitImpl.setup(ctx, new NativeAVEngineCallback(ctx))
    WfcAVEngineKit.SCREEN_SHARING_REPLACE_MODE = true
    // 点通话通知（长时任务那条）/ 从画中画恢复 → 让应用层把通话页推回来。
    // 事件名和 Android/iOS 保持一致：应用层在 sessionCallback 判空**之前**就处理 resumeVoipPage，
    // 所以最小化状态下（通话页已销毁、sessionCallback 为 null）这条也送得到。
    setupVoipResume(ctx, () => {
        fireCallSessionEvent('resumeVoipPage', [])
    })
    // App 切到后台 → 系统按 autoStart 自动进画中画（见 voipMinimize.ets 的 prepareVoipPiP），
    // 通话页还留在页面栈里，得让应用层把它收掉 —— 收完的状态和用户手动点最小化一模一样，
    // 回来的路也就都收敛到上面那条 resumeVoipPage 上。Android/iOS 用的是同一个事件名。
    setVoipAutoMinimizeCallback(() => {
        fireCallSessionEvent('minimizeVoipPage', [])
    })
}

export function addICEServer(url: string, name: string, password: string): void {
    // 适配层里带了一条兜底的默认配置，第一次由应用层写入时要把它顶掉
    if (!iceServerReplaced) {
        iceServerReplaced = true
        Config.ICE_SERVERS = []
    }
    Config.ICE_SERVERS.push([url, name, password])
}

export function isSupportMultiCall(): boolean {
    // 多人版 / 高级版（会议版）avenginekit.har 都支持多人通话
    return true
}

// 鸿蒙的两个版本 har（libs/avenginekit.har-multi、libs/avenginekit.har-conference）对外 .d.ets
// 完全一致，会议相关方法在多人版里也存在（startConference 直接 Promise.reject、joinConference 返回
// null），差别只体现在 isSupportConference() 的返回值上，所以下面的会议接口在两个版本上都能编过。
export function isSupportConference(): boolean {
    return avengineKitImpl.isSupportConference()
}

export function setVideoProfile(profile: number, _swapWidthHeight: boolean): void {
    // 鸿蒙 SDK 只有分辨率档位，没有 swapWidthHeight 开关
    WfcAVEngineKit.VIDEO_PROFILE = profile
}

export function startSingleCall(userId: string, audioOnly: boolean): string | null {
    return startCall(new Conversation(ConversationType.Single, userId, 0), [userId], audioOnly)
}

export function startMultiCall(groupId: string, participants: string[], audioOnly: boolean): string | null {
    return startCall(new Conversation(ConversationType.Group, groupId, 0), participants, audioOnly)
}

function startCall(conversation: Conversation, participants: string[], audioOnly: boolean): string | null {
    // 引擎的 startCall 只要 currentSession 还在就直接 return（通话结束时才会置空），
    // 这里必须用同样的判断，否则会把上一通电话的 session 当成新建的返回给应用层
    const existing = currentSessionOrNull()
    if (existing != null) {
        console.error(TAG, 'startCall 失败：已有通话进行中', existing!.callId, existing!.status)
        return null
    }
    avengineKitImpl.startCall(conversation, participants, audioOnly)
    // startCall 内部是先同步建好 CallSession 再异步发起始信令的，这里可以直接取回
    const session = currentSessionOrNull()
    if (session == null) {
        console.error(TAG, 'startCall 失败：引擎未创建会话，检查 IM 是否已连接')
        return null
    }
    return callSessionToJson(session!)
}

/**
 * 发起会议（仅会议版 har 有效）。
 * 引擎的 startConference 返回 Promise，但和 startCall 一样，CallSession 是在 Promise 体里
 * **同步**建好并挂到 currentSession 上的（建房间的信令才是异步的），所以这里同样用
 * “调用后立刻取 currentSession” 的写法，把签名和 Android/iOS 的同步返回对齐。
 * Promise 的失败分支只用来兜底清场 + 打日志，不 catch 会变成 unhandled rejection。
 */
export function startConference(callId: string, audioOnly: boolean, pin: string, host: string, title: string, desc: string, audience: boolean, advance: boolean, record: boolean, callExtra: string): string | null {
    const existing = currentSessionOrNull()
    if (existing != null) {
        console.error(TAG, 'startConference 失败：已有通话进行中', existing!.callId, existing!.status)
        return null
    }
    avengineKitImpl.startConference(callId, audioOnly, pin, host, title, desc, audience, advance, record, '', callExtra)
        .catch((err: object) => {
            console.error(TAG, 'startConference failed', err)
        })
    const session = currentSessionOrNull()
    if (session == null) {
        console.error(TAG, 'startConference 失败：引擎未创建会话，检查是否为会议版 SDK、IM 是否已连接')
        return null
    }
    return callSessionToJson(session!)
}

/** 加入会议（仅会议版 har 有效） */
export function joinConference(callId: string, audioOnly: boolean, pin: string, host: string, title: string, desc: string, audience: boolean, advance: boolean, muteAudio: boolean, muteVideo: boolean, callExtra: string): string | null {
    const existing = currentSessionOrNull()
    if (existing != null) {
        console.error(TAG, 'joinConference 失败：已有通话进行中', existing!.callId, existing!.status)
        return null
    }
    const session = avengineKitImpl.joinConference(callId, audioOnly, pin, host, title, desc, audience, advance, muteAudio, muteVideo, '', callExtra)
    if (session == null) {
        console.error(TAG, 'joinConference 失败：引擎未创建会话，检查是否为会议版 SDK、IM 是否已连接')
        return null
    }
    return callSessionToJson(session!)
}

/**
 * 离开会议。鸿蒙 CallSession 上没有 leaveConference()，离会就是挂断；
 * destroyRoom（主持人结束整个会议）在鸿蒙端要靠应用层调 conferenceApi.destroyConference 完成，
 * 这里只负责把本端的会话断掉，保持三端签名一致。
 */
export function leaveConference(callId: string, _destroyRoom: boolean): void {
    const session = sessionOf(callId)
    if (session != null && session!.status != CallState.STATUS_IDLE) {
        session!.hangup()
    }
}

/**
 * 鸿蒙引擎没有 canSwitchAudience()，是否允许切换由会议信息里的 allowSwitchMode 决定，
 * 那个判断在应用层（conferenceManager）已经做了，这里只要是会议中就放行。
 */
export function canSwitchAudience(callId: string): boolean {
    const session = sessionOf(callId)
    return session != null && session!.conference
}

export function switchAudience(callId: string, audience: boolean): boolean {
    const session = sessionOf(callId)
    if (session == null || !session!.conference) {
        return false
    }
    session!.switchAudience(audience)
    return true
}

export function currentCallSession(): string | null {
    const session = currentSessionOrNull()
    return session == null ? null : callSessionToJson(session!)
}

export function answerCall(callId: string, audioOnly: boolean): void {
    const session = sessionOf(callId)
    if (session == null) {
        return
    }
    if (audioOnly && !session!.audioOnly) {
        session!.downgrade2Voice()
    }
    session!.call()
}

export function endCall(callId: string): void {
    const session = sessionOf(callId)
    if (session != null && session!.status != CallState.STATUS_IDLE) {
        session!.hangup()
    }
}

export function muteAudio(callId: string, mute: boolean): boolean {
    const session = sessionOf(callId)
    if (session == null) {
        return false
    }
    session!.muteAudio(mute)
    return true
}

export function muteVideo(callId: string, mute: boolean): boolean {
    const session = sessionOf(callId)
    if (session == null) {
        return false
    }
    session!.muteVideo(mute)
    return true
}

export function downgrade2Voice(callId: string): void {
    sessionOf(callId)?.downgrade2Voice()
}

export function switchCamera(callId: string): void {
    sessionOf(callId)?.switchCamera()
}

// ------------------------------------------------------------------
// 屏幕共享（仅高级版音视频 SDK 支持，多人版上 isSupportScreenShare() 恒为 false）
// ------------------------------------------------------------------

/**
 * 当前 SDK 是否支持屏幕共享。屏幕共享只在高级版（会议版）有，判定条件和会议一致。
 * 应用层拿它决定要不要显示「共享屏幕」入口。
 */
export function isSupportScreenShare(): boolean {
    return avengineKitImpl.isSupportConference()
}

export function isScreenSharing(callId: string): boolean {
    const session = sessionOf(callId)
    return session != null && session!.isScreenSharing()
}

/**
 * 开始屏幕共享。
 *
 * 鸿蒙这边不需要应用层做任何前置：引擎内部走 webrtc 的 getDisplayMedia()，
 * 系统会自己弹录屏确认框，module.json5 里也不用加权限（对齐 hm-av 的 chat/module.json5）。
 *
 * 结果是异步的，且用户可以在系统确认框上点取消（那时 Promise reject），所以这里不返回 boolean，
 * 而是统一用事件回话：成功 didScreenShareStarted，失败/取消 didScreenShareEnded ——
 * 后者和「共享正常结束」用的是同一条事件，页面只要照着它把按钮状态落回去就行。
 */
export function startScreenShare(callId: string): void {
    const session = sessionOf(callId)
    if (session != null && session!.isScreenSharing()) {
        // 页面状态和引擎不一致（比如最小化期间共享起来了），把真实状态吐回去
        fireCallSessionEvent('didScreenShareStarted', [])
        return
    }
    if (session == null || session!.audioOnly) {
        // audioOnly 时引擎内部也是直接 return，这里提前挡掉，免得页面等一个永远不来的事件
        fireCallSessionEvent('didScreenShareEnded', [])
        return
    }
    session!.startScreenShare().then(() => {
        fireCallSessionEvent('didScreenShareStarted', [])
    }).catch((err: BusinessError) => {
        // 最常见的就是用户在系统录屏确认框上点了取消
        console.error(TAG, 'startScreenShare failed', err.code, err.message)
        fireCallSessionEvent('didScreenShareEnded', [])
    })
}

export function stopScreenShare(callId: string): void {
    const session = sessionOf(callId)
    if (session == null || !session!.isScreenSharing()) {
        return
    }
    // 引擎内部会回调 didScreenShareEnded，页面状态由那一条负责
    session!.stopScreenShare()
}

export function setSpeakerOn(callId: string, speakerOn: boolean): void {
    if (sessionOf(callId) == null) {
        return
    }
    audio.getAudioManager().getRoutingManager()
        .setCommunicationDevice(audio.CommunicationDeviceType.SPEAKER, speakerOn)
        .catch((err: BusinessError) => {
            console.error(TAG, 'setCommunicationDevice failed', err.code, err.message)
        })
}

export function inviteNewParticipant(callId: string, userIds: string[]): void {
    sessionOf(callId)?.inviteNewParticipants(userIds)
}

export function kickoffParticipant(callId: string, userId: string, successCB: () => void, failCB: (error: number) => void): void {
    const session = sessionOf(callId)
    if (session == null) {
        failCB(-1)
        return
    }
    session!.kickoffParticipant(userId, successCB, failCB)
}

export function getParticipantProfiles(callId: string): string {
    const session = sessionOf(callId)
    if (session == null) {
        return '[]'
    }
    const list: UTSJSONObject[] = []
    session!.getParticipantProfiles().forEach((p: ParticipantProfile) => {
        list.push(participantProfileToJson(p))
    })
    return JSON.stringify(list)
}

export function getParticipantProfile(callId: string, userId: string, screenSharing: boolean): string | null {
    const session = sessionOf(callId)
    if (session == null) {
        return null
    }
    // 鸿蒙 CallSession 没有单个查询接口，从列表里挑
    const profiles = session!.getParticipantProfiles()
    for (let i = 0; i < profiles.length; i++) {
        const p = profiles[i]
        if (p.userId == userId && p.screenSharing == screenSharing) {
            return JSON.stringify(participantProfileToJson(p))
        }
    }
    // ⚠️ 查不到时兜底查自己。鸿蒙的 getParticipantProfiles() 只遍历 subscriberMap（远端订阅者），
    // **自己不在里面**；而 Android 的 getParticipantProfile 找不到时会 return getMyProfile()。
    // 不补这一刀，应用层「按 userId 查资料」在自己身上就是 null：didMuteStateChanged([自己])
    // 拿不到 profile 直接 continue，关摄像头后自己那格的 videoMuted 不会更新，
    // 格子继续挂 native-view，而摄像头轨道已经停了 —— 表现为黑屏而不是头像。
    // 屏幕共享那条（screenSharing = true）不兜底：自己的共享流在 REPLACE_MODE 下不单独成格。
    if (!screenSharing && userId == wfcShim.getUserId()) {
        const selfProfile = session!.getSelfProfile()
        if (selfProfile != null) {
            return JSON.stringify(participantProfileToJson(selfProfile!))
        }
    }
    return null
}

export function getMyProfile(callId: string): string | null {
    const session = sessionOf(callId)
    if (session == null) {
        return null
    }
    const p = session!.getSelfProfile()
    return p == null ? null : JSON.stringify(participantProfileToJson(p!))
}

export function requestVoipPermissions(audioOnly: boolean, successCB: () => void, failCB: () => void): void {
    const permissions: Permissions[] = audioOnly
        ? ['ohos.permission.MICROPHONE']
        : ['ohos.permission.MICROPHONE', 'ohos.permission.CAMERA']
    abilityAccessCtrl.createAtManager().requestPermissionsFromUser(context(), permissions)
        .then((data: PermissionRequestResult) => {
            const results: number[] = data.authResults
            for (let i = 0; i < results.length; i++) {
                if (results[i] != 0) {
                    failCB()
                    return
                }
            }
            successCB()
        })
        .catch((err: BusinessError) => {
            console.error(TAG, 'requestPermissionsFromUser failed', err.code, err.message)
            failCB()
        })
}

// 鸿蒙没有 Android 那种"悬浮窗权限"（跨应用悬浮要 SYSTEM_FLOAT_WINDOW，三方应用申请不到），
// 退到后台后通话由长时任务（VOIP 后台模式）维持，所以这里直接返回 true。
export function checkOverlayPermission(): boolean {
    return true
}

// 仅 Android 需要（跳系统设置页开悬浮窗权限）。鸿蒙上 checkOverlayPermission 恒为 true，
// 应用层永远不会调到这里；但三端导出必须齐全 —— uts 插件走运行时 proxy，缺函数编译期无感，
// 真机点到才报 not a function。
export function requestOverlayPermission(): void {
}

/**
 * 通话中挂在通知/画中画上的文案，由应用层在 avEngineKit.init() 时用当前语言的 i18n 词条送进来。
 * resumeHint 是 Android 通知栏的「点击返回通话界面」，鸿蒙的通知文案由系统长时任务生成，改不了，忽略。
 * 三端都必须导出这个函数 —— uts 插件走运行时 proxy，少导出一个编译期无感，真机调到才 not a function。
 */
export function setVoipUIStrings(ongoing: string, waitingAnswer: string, connecting: string, _resumeHint: string): void {
    setVoipMinimizeTexts(ongoing, waitingAnswer, connecting)
}

/**
 * 最小化：进画中画（鸿蒙唯一被系统认可的通话挂起 UI，见 voipMinimize.ets）。
 * 画中画没起来也不影响最小化本身 —— 通话由长时任务在后台继续，用户点那条系统通知也能回到通话页。
 * 返回上一页仍由调用方（应用层 uni.navigateBack）负责。
 */
export function minimize(_callId: string, _focusVideoUser: string): void {
    startVoipPiP()
}

export function setLocalVideoView(callId: string, element: UniNativeViewElement): void {
    if (sessionOf(callId) == null) {
        return
    }
    const holder = holderOf(element, '', false)
    holder.controller.setScalingMode(ScalingMode.AspectFill)
    applyTrack(holder)
}

export function setRemoteVideoView(callId: string, userId: string, screenSharing: boolean, element: UniNativeViewElement): void {
    if (sessionOf(callId) == null) {
        return
    }
    const holder = holderOf(element, userId, screenSharing)
    holder.controller.setScalingMode(ScalingMode.AspectFit)
    applyTrack(holder)
}

export function setParticipantVideoType(callId: string, userId: string, screenSharing: boolean, videoType: number): void {
    const session = sessionOf(callId)
    if (session == null || videoType < 0 || videoType > 2) {
        return
    }
    session!.setParticipantVideoType(userId, screenSharing, videoType)
}

/**
 * 由应用层 avEngineKit.uts 在收到 EventType.ReceiveProtoMessages 时调用，
 * 把原始 proto 消息喂给鸿蒙音视频引擎。Android/iOS 上是空实现
 * （原生 SDK 自己就挂在消息流上，不需要应用层转发）。
 */
export function dispatchReceivedMessages(messagesJson: string, hasMore: boolean): void {
    if (!initialized) {
        return
    }
    dispatchProtoMessages(context(), messagesJson, hasMore)
}

/**
 * 由应用层 avEngineKit.uts 在收到 EventType.ConferenceEvent 时调用，把会议事件转给引擎。
 * 高级版 avenginekit 的媒体订阅依赖这条通道，缺了它接通后订阅不到对方的音视频流，
 * 详见 messageBridge.ets#emitConferenceEvent。Android/iOS 上是空实现。
 */
export function dispatchConferenceEvent(event: string): void {
    if (!initialized) {
        return
    }
    emitConferenceEvent(context(), event)
}
