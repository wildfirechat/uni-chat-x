/**
 * 对讲（PTT）UTS 插件（iOS）。直接封装 PttClient.xcframework 的 WFPttClient 单例，
 * 方法/属性签名已对照 WFPttClient.h 头文件核对。
 *
 * 与 Android 的差异：
 * 1. iOS 的 requestTalk 没有 priority 参数（该 SDK 版本没有优先级模式），这里保留 priority
 *    形参只是为了和 Android 侧签名对称，实际不会用到。
 * 2. WFPttDelegate 没有 receiveData 对应的回调，iOS 侧不会触发 "receiveData" 事件。
 */

import { PttEventListener } from '../interface.uts'

import { WFPttClient, WFPttDelegate, PttEndReason } from 'PttClient'
import { WFCCConversation } from 'WFChatClient'

let pttEventListener: PttEventListener | null = null
let initialized = false

// WFPttDelegate 的回调可能来自后台线程（振幅上报等），统一派发到主线程再回调 JS 监听，
// 避免跨线程调用 UTS 事件桥导致崩溃。
function emitPttEvent(event: string, conversationJsonStr: string, argsJson: string): void {
    DispatchQueue.main.async(execute = (): void => {
        pttEventListener?.(event, conversationJsonStr, argsJson)
    })
}

function conversationJson(conv: WFCCConversation): string {
    // 数值字段先转成 String 再拼（每个转换单独一条语句，避免混合类型 String+/NSNumber 重载
    // 解析导致编译器 "unable to type-check in reasonable time"）
    const typeStr = Number(conv.type.rawValue).toString()
    const lineStr = Number(conv.line).toString()
    // conv.target 在 Swift 里是 String!（IUO），直接拼接会让类型检查器超时，先显式解包
    const target = conv.target!
    return "{\"type\":" + typeStr + ",\"target\":\"" + target + "\",\"line\":" + lineStr + "}"
}

function toConversation(type: number, target: string, line: number): WFCCConversation {
    // Swift 里 conversationWithType(_:target:line:) 已替换为 init(type:target:line:)，用构造器创建。
    // 注意不能写 type as WFCCConversationType：那会编译成 NSNumber as! 枚举，运行时直接崩。
    // 用 rawValue 初始化（toInt() 得到 Swift Int），rawValue init 是可选返回，加 ! 解包。
    return new WFCCConversation(type = WFCCConversationType(rawValue = type.toInt())!, target = target, line = line.toInt32())
}

class NativePttDelegate implements WFPttDelegate {
    // WFPttDelegate 的三个 didConversation 重载在 Swift 里带参数标签（startTalkingUser / endTalkingUser /
    // amplitudeUpdate / ofUser），必须用 @argumentLabel 标注，否则生成的 Swift 方法名全是 _，
    // 前两个会因签名完全相同而报 invalid redeclaration。
    didConversation(conversation: WFCCConversation, @argumentLabel("startTalkingUser") startTalkingUser: string): void {
        emitPttEvent("userStartTalking", conversationJson(conversation), "[\"" + startTalkingUser + "\"]")
    }

    didConversation(conversation: WFCCConversation, @argumentLabel("endTalkingUser") endTalkingUser: string): void {
        emitPttEvent("userEndTalking", conversationJson(conversation), "[\"" + endTalkingUser + "\"]")
    }

    didConversation(conversation: WFCCConversation, @argumentLabel("amplitudeUpdate") amplitudeUpdate: Int32, @argumentLabel("ofUser") ofUser: string): void {
        emitPttEvent("userAmplitudeUpdate", conversationJson(conversation), "[\"" + ofUser + "\"," + Number(amplitudeUpdate).toString() + "]")
    }
}

const nativePttDelegate = new NativePttDelegate()

export function onPttEvent(listener: PttEventListener): void {
    pttEventListener = listener
}

export function isPttClientEnable(): boolean {
    return true
}

export function initClient(options: UTSJSONObject): void {
    const client = WFPttClient.shared()!
    if (options.getBoolean("enableGlobalPtt") != null) {
        client.enablePtt = options.getBoolean("enableGlobalPtt")!
    }
    if (options.getNumber("singleChatMaxSpeakerCount") != null) {
        client.singleChatMaxSpeakerNumber = (options.getNumber("singleChatMaxSpeakerCount")!) as Int32
    }
    if (options.getBoolean("singleChatSaveVoiceMessage") != null) {
        client.singleChatSaveVoiceMessage = options.getBoolean("singleChatSaveVoiceMessage")!
    }
    if (options.getNumber("singleChatMaxSpeakTime") != null) {
        client.singleChatMaxSpeakerTime = (options.getNumber("singleChatMaxSpeakTime")!) as Int32
    }
    if (initialized) {
        return
    }
    initialized = true
    client.delegate = nativePttDelegate
}

// onAmplitudeUpdate 等回调会被多次触发，iOS 下回调默认触发一次即回收，必须 keepAlive
@UTSJS.keepAlive
export function requestTalk(type: number, target: string, line: number, priority: number, onStartTalking: () => void, onTalkingEnd: (reason: number) => void, onRequestFail: (errorCode: number) => void, onAmplitudeUpdate: (amplitude: number) => void): void {
    const conv = toConversation(type, target, line)
    WFPttClient.shared()!.requestTalk(conv, startTalking = (): void => {
        onStartTalking()
    }, onAmplitude = (amplitude: Int32): void => {
        onAmplitudeUpdate(Number(amplitude))
    }, requestFailure = (errorCode: Int32): void => {
        onRequestFail(Number(errorCode))
    }, talkingEnd = (reason: PttEndReason): void => {
        onTalkingEnd(Number(reason.rawValue))
    })
}

export function releaseTalking(type: number, target: string, line: number): void {
    WFPttClient.shared()!.releaseTalking(toConversation(type, target, line))
}

export function getMaxSpeakCount(type: number, target: string, line: number): number {
    return Number(WFPttClient.shared()!.getMaxSpeakerNumber(toConversation(type, target, line)))
}

export function getMaxSpeakTime(type: number, target: string, line: number): number {
    return Number(WFPttClient.shared()!.getMaxSpeakerTime(toConversation(type, target, line)))
}

export function isSaveVoiceMessage(type: number, target: string, line: number): boolean {
    return WFPttClient.shared()!.isSaveVoiceMessage(toConversation(type, target, line))
}

export function setSaveVoiceMessage(type: number, target: string, line: number, save: boolean, successCB: () => void, failCB: (error: number) => void): void {
    WFPttClient.shared()!.setConversation(toConversation(type, target, line), saveVoiceMessage = save, success = (): void => {
        successCB()
    }, error = (code: Int32): void => {
        failCB(Number(code))
    })
}

export function setConversationMaxSpeakTime(type: number, target: string, line: number, duration: number, successCB: () => void, failCB: (error: number) => void): void {
    WFPttClient.shared()!.setConversation(toConversation(type, target, line), maxSpeakerTime = duration as Int32, success = (): void => {
        successCB()
    }, error = (code: Int32): void => {
        failCB(Number(code))
    })
}

export function setConversationMaxSpeakerCount(type: number, target: string, line: number, count: number, successCB: () => void, failCB: (error: number) => void): void {
    WFPttClient.shared()!.setConversation(toConversation(type, target, line), maxSpeakerNumber = count as Int32, success = (): void => {
        successCB()
    }, error = (code: Int32): void => {
        failCB(Number(code))
    })
}

export function setConversationPttSilent(type: number, target: string, line: number, silent: boolean, successCB: () => void, failCB: (error: number) => void): void {
    WFPttClient.shared()!.setConversation(toConversation(type, target, line), pttSilent = silent, success = (): void => {
        successCB()
    }, error = (code: Int32): void => {
        failCB(Number(code))
    })
}

export function isConversationPttSilent(type: number, target: string, line: number): boolean {
    return WFPttClient.shared()!.isConversationPttSilent(toConversation(type, target, line))
}

export function getTalkingStartTime(): number {
    return Number(WFPttClient.shared()!.getTalkingStartTime())
}

export function getTalkingMembers(type: number, target: string, line: number): string {
    // getTalkingMember 在 Swift 里导入为 [String: NSNumber]?，需要先转成 NSDictionary 才能用 allKeys
    const dict = WFPttClient.shared()!.getTalkingMember(toConversation(type, target, line)) as NSDictionary
    const keys = dict.allKeys as string[]
    const items = keys.map((k: string): string => "\"" + k + "\"")
    return "[" + items.join(",") + "]"
}

export function getTalkingMemberCount(type: number, target: string, line: number): number {
    const dict = WFPttClient.shared()!.getTalkingMember(toConversation(type, target, line)) as NSDictionary
    return Number(dict.count)
}

export function setEnablePtt(type: number, target: string, line: number, enable: boolean): void {
    // WFPttClient 的 enablePtt 是全局属性，没有按会话开关的接口，这里只更新全局开关
    WFPttClient.shared()!.enablePtt = enable
}

// iOS 由系统在首次实际使用麦克风时自动弹出授权对话框，这里直接放行，与 wfc-av-client 的
// requestVoipPermissions 处理方式一致
export function isRecordPermissionGranted(): boolean {
    return true
}

export function requestRecordPermission(successCB: () => void, failCB: () => void): void {
    successCB()
}

export function isSpeakerEnable(): boolean {
    return WFPttClient.shared()!.enableSpeaker
}

export function enableSpeaker(): void {
    WFPttClient.shared()!.enableSpeaker = true
}

// 仅鸿蒙需要：鸿蒙版对讲 SDK 跑在 ArkTS 侧，收不到原生消息流，得由应用层把原始 proto 消息转发过去。
// iOS 的 WFPttClient 自己就挂在 SDK 的消息回调上，这里空实现即可。
export function dispatchReceivedMessages(messagesJson: string, hasMore: boolean): void {
}
