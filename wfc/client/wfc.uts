        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
    }

    /**
     * 保存会话草稿
     */
    setConversationDraft(conversation: Conversation, draft: string = ''): void {
        const conversationInfo = this.getConversationInfo(conversation);
        if (conversationInfo.draft == draft) {
            return;
        }
        native.setConversationDraft(conversation.toJsonStr(), draft);
        const newInfo = this.getConversationInfo(conversation);
        this.emit(EventType.ConversationInfoUpdate, [newInfo]);
    }

    /**
     * 设置会话时间戳，当会话不存在时，会创建一个新的会话
     */
    setConversationTimestamp(conversation: Conversation, timestamp: number): void {
        native.setConversationTimestamp(conversation.toJsonStr(), stringValue(timestamp));
        const conversationInfo = this.getConversationInfo(conversation);
        this.emit(EventType.ConversationInfoUpdate, [conversationInfo]);
    }

