    /**
     * 免打扰时段：返回 [起, 止]，单位是**从 UTC 零点算起的分钟数**，未设置时返回 null。
     *
     * 三端原生插件都没导出 `getNoDisturbingTimes`（鸿蒙侧连 flutter 的 imclient 都还是 TODO），
     * 但这个设置本身就是 user setting scope 17、key ''、值 `"起|止"`，服务端也是这么解析的
     * （broker `MemoryMessagesStore.isUserNoDisturbing`）。所以直接读写 user setting，
     * 三端一致，也不必为它再发一次插件版本。
     */
    getNoDisturbingTimes(): number[] | null {
        const value = this.getUserSetting(UserSettingScope.NoDisturbing, '');
        if (value == '') {
            return null;
        }
        const parts = value.split('|');
        if (parts.length != 2) {
            return null;
        }
        const start = parseInt(parts[0]);
        const end = parseInt(parts[1]);
        if (isNaN(start) || isNaN(end)) {
            return null;
        }
        return [start, end];
    }

    /**
     * 设置免打扰时段，参数同 [getNoDisturbingTimes]。
     * [endMins] 允许小于 [startMins]，表示跨夜。
     */
    setNoDisturbingTimes(startMins: number, endMins: number, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        this.setUserSetting(UserSettingScope.NoDisturbing, '', '' + startMins + '|' + endMins, successCB, failCB);
    }

    /** 取消免打扰。置空值即可，服务端把空值当作未设置。 */
    clearNoDisturbingTimes(successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        this.setUserSetting(UserSettingScope.NoDisturbing, '', '', successCB, failCB);
    }

    /**
     * 是否屏蔽音视频通话的推送。
     *
     * 没有对应的原生方法，走 user setting scope 21（与 iOS/Android 官方客户端一致）。
     */
