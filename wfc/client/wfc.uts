    /**
     * 获取会话列表
     */
    getConversationList(types: number[], lines: number[]): ConversationInfo[] {
        const conversationListStr = native.getConversationInfos(types, lines);
        const conversationInfoList: ConversationInfo[] = [];
        if (conversationListStr == '') {
            console.log('getConversationInfos return empty')
            return conversationInfoList;
        }

        const arr = JSON.parseArray(conversationListStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const info = ConversationInfo.protoConversationToConversationInfo(o as UTSJSONObject)
                    if (info != null) {
                        conversationInfoList.push(info)
                    }
                }
            }
        }
        return conversationInfoList;
    }

    /**
     * 获取会话详情
     */
    getConversationInfo(conversation: Conversation): ConversationInfo {
        const convStr = native.getConversationInfo(conversation.toJsonStr());
        if (convStr == '') {
            const convInfo = new ConversationInfo()
            convInfo.conversation = conversation
            return convInfo
        }
        const obj = JSON.parseObject(convStr);
        const info = obj != null ? ConversationInfo.protoConversationToConversationInfo(obj) : null;
        if (info == null) {
            const convInfo = new ConversationInfo()
            convInfo.conversation = conversation
            return convInfo
        }
        return info;
    }

    /**
     * 搜索会话
     */
    searchConversation(keyword: string, types: number[] = [0, 1, 2], lines: number[] = [0, 1, 2]): ConversationSearchResult[] {
        const result = native.searchConversation(keyword, types, lines);
        const conversationSearchResults: ConversationSearchResult[] = [];
        const arr = JSON.parseArray(result);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const r = ConversationSearchResult.fromProtoConversationSearchResult(o as UTSJSONObject)
                    if (r != null) {
                        conversationSearchResults.push(r)
                    }
                }
            }
        }
        return conversationSearchResults;
    }

