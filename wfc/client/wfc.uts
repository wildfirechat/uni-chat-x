    /**
     * 发送消息
     */
    sendConversationMessage(conversation: Conversation, messageContent: MessageContent, toUsers: string[] = [], preparedCB: ((messageId: number, timestamp: number) => void) | null = null, progressCB: ((uploaded: number, total: number) => void) | null = null, successCB: ((messageUid: string, timestamp: number) => void) | null = null, failCB: ((err: number) => void) | null = null): void {
        const message = new Message(conversation, messageContent);
        this.sendMessageEx(message, toUsers, preparedCB, progressCB, successCB, failCB);
    }

    sendMessage(message: Message, preparedCB: ((messageId: number, timestamp: number) => void) | null = null, progressCB: ((uploaded: number, total: number) => void) | null = null, successCB: ((messageUid: string, timestamp: number) => void) | null = null, failCB: ((err: number) => void) | null = null): void {
        this.sendMessageEx(message, [], preparedCB, progressCB, successCB, failCB);
    }

    // toUsers 用来实现定向消息
    sendMessageEx(message: Message, toUsers: string[] = [], preparedCB: ((messageId: number, timestamp: number) => void) | null = null, progressCB: ((uploaded: number, total: number) => void) | null = null, successCB: ((messageUid: string, timestamp: number) => void) | null = null, failCB: ((err: number) => void) | null = null): void {
        const strConv = message.conversation.toJsonStr();
        const payload = message.messageContent.encode();
        message.content = payload;
        message.from = this.getUserId();
        const strCont = payload.toJsonStr();

        native.sendMessage(strConv, strCont, toUsers, 0,
            (value: object) => { //preparedCB
                const args = argsOf(value);
                const messageId = args.length > 0 ? numberValue(args[0]) : 0;
                const timestamp = args.length > 1 ? numberValue(args[1]) : 0;
                message.messageId = messageId;
                message.timestamp = timestamp;
                preparedCB?.(messageId, timestamp);
                this.emit(EventType.SendMessage, [message]);
            },
            (value: object) => { //progressCB
                const args = argsOf(value);
                const uploaded = args.length > 0 ? numberValue(args[0]) : 0;
                const total = args.length > 1 ? numberValue(args[1]) : 0;
                progressCB?.(uploaded, total);
            },
            (value: object) => { //successCB
                const args = argsOf(value);
                const messageUid = args.length > 0 ? stringValue(args[0]) : '0';
                const timestamp = args.length > 1 ? numberValue(args[1]) : 0;
                message.status = MessageStatus.Sent;
                message.messageUid = messageUid;
                message.timestamp = timestamp;
                // update remote url
                if (message.messageContent instanceof MediaMessageContent) {
                    const msg = this.getMessageById(message.messageId);
                    if (msg != null) {
                        message.messageContent = msg.messageContent;
                    }
                }
                successCB?.(messageUid, timestamp);
                this.emit(EventType.MessageStatusUpdate, [message]);
            },
            (errorCode: number) => { //errorCB
                message.status = MessageStatus.SendFailure;
                failCB?.(errorCode);
                this.emit(EventType.MessageStatusUpdate, [message]);
            });
    }

    /**
     * 撤回消息
     */
    recallMessage(messageUid: string, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        console.log('recall', messageUid);
        native.recall(stringValue(messageUid),
            () => {
                successCB?.();
                this.onRecallMessage(this.getUserId(), stringValue(messageUid));
            },
            (errorCode: number) => {
                console.log('recall, f', messageUid, errorCode);
                failCB?.(errorCode);
            });
    }

