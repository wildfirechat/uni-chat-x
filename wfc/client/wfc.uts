    private _parseUserOnlineStates(userOnlineStateStr: string): UserOnlineState[] {
        const userOnlineStates: UserOnlineState[] = [];
        const arr = JSON.parseArray(userOnlineStateStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const s = o as UTSJSONObject
                    const userOnlineState = new UserOnlineState();
                    userOnlineState.userId = s.getString('userId') ?? '';
                    const customState = new UserCustomState();
                    customState.state = s.getNumber('customState') ?? 0;
                    customState.text = s.getString('customText') ?? '';
                    userOnlineState.customState = customState;

                    let clientStates = s.getArray<UTSJSONObject>('states');
                    if (clientStates == null) {
                        clientStates = s.getArray<UTSJSONObject>('clientStates');
                    }
                    if (clientStates != null) {
                        for (let j = 0; j < clientStates.length; j++) {
                            const ss = clientStates[j]
                            const clientState = new UserClientState();
                            clientState.state = ss.getNumber('state') ?? 0;
                            clientState.platform = ss.getNumber('platform') ?? 0;
                            clientState.lastSeen = numberValue(ss.get('lastSeen'));
                            userOnlineState.clientStates.push(clientState)
                        }
                    }
                    userOnlineStates.push(userOnlineState);
                }
            }
        }
        return userOnlineStates;
    }

