    defaultUserPortrait(userInfo: UserInfo): string {
        if (userInfo.updateDt == 0) {
            return Config.DEFAULT_PORTRAIT_URL
        }
        return redirectMediaUrl(`${Config.getAppServer()}/avatar?name=${encodeURIComponent(userInfo.displayName)}`)
    }

    defaultGroupPortrait(groupInfo: GroupInfo): string {
        let memberIds = this.getGroupMemberIds(groupInfo.target)
        memberIds = memberIds.slice(0, 9);
        const members = this.getUserInfosInternal(memberIds, groupInfo.target);
        const reqMembers: UTSJSONObject[] = []
        let pending = false;
        for (let i = 0; i < members.length; i++) {
            const m = members[i]
            if (m.portrait != '' && !Config.isAppServerUrl(m.portrait)) {
                reqMembers.push({ avatarUrl: m.portrait } as UTSJSONObject)
            } else {
                reqMembers.push({ name: m.displayName } as UTSJSONObject)
            }
            if (m instanceof NullUserInfo) {
                pending = true;
                break
            }
        }
        if (members.length == 0 || pending) {
            return Config.DEFAULT_GROUP_PORTRAIT_URL;
        }

        const req = JSON.stringify({ members: reqMembers } as UTSJSONObject)!;

        return redirectMediaUrl(`${Config.getAppServer()}/avatar/group?request=${encodeURIComponent(req)}`)
    }

    // 不填充默认头像的内部版本，避免 defaultGroupPortrait 死循环
    private getUserInfosInternal(userIds: string[], groupId: string): UserInfo[] {
        const users: UserInfo[] = [];
        if (userIds.length == 0) {
            return users;
        }
        const userInfoStrs = native.getUserInfos(userIds, groupId);
        if (userInfoStrs != '') {
            const arr = JSON.parseArray(userInfoStrs);
            if (arr != null) {
                for (let i = 0; i < arr.length; i++) {
                    const o = arr[i]
                    if (o instanceof UTSJSONObject) {
                        users.push(UserInfo.fromJsonObject(o as UTSJSONObject))
                    }
                }
            }
        }
        return users;
    }

    // ------------------- native 事件处理 -------------------

    private _handleNativeEvent(e: object): void {
        let args: Array<any | null> = []
        if (e instanceof UTSJSONObject) {
            const argsArr = (e as UTSJSONObject).getArray<any>('args')
            if (argsArr != null) {
                args = argsArr as Array<any | null>
            }
        } else {
            // 兜底：JSON 序列化再解析
            try {
                const str = JSON.stringify(e)
                if (str != null) {
                    const obj = JSON.parseObject(str)
                    if (obj != null) {
                        const argsArr = obj.getArray<any>('args')
                        if (argsArr != null) {
                            args = argsArr as Array<any | null>
                        }
                    }
                }
            } catch (err) {
                console.error('_handleNativeEvent parse error', err)
            }
        }
        if (args.length == 0) {
            return
        }
        const eventName = '' + args[0]
        const params = args.slice(1)
        this._dispatchNativeEvent(eventName, params)
    }

    private _dispatchNativeEvent(eventName: string, params: Array<any | null>): void {
        switch (eventName) {
            case 'onConnectionStatusChange':
                this.onConnectionChanged(params.length > 0 ? numberValue(params[0]) : 0);
                break;
            case 'onConnectToServer':
                this._refreshConnectedNetwork();
                this.emit(EventType.ConnectToServer, params);
                break;
            case 'onReceiveMessage':
                this.onReceiveMessage(params.length > 0 ? '' + params[0] : '[]', params.length > 1 ? params[1] == true : false);
                break;
            case 'onRecallMessage':
                this.onRecallMessage(params.length > 0 ? '' + params[0] : '', params.length > 1 ? stringValue(params[1]) : '0');
                break;
            case 'onDeleteMessage':
                this.onDeleteRemoteMessage(params.length > 0 ? stringValue(params[0]) : '0');
                break;
            case 'onMessageDelivered':
                this.onUserReceivedMessage(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onMessageRead':
                this.onUserReadedMessage(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onMessageUpdate':
                this.onMessageUpdate(params.length > 0 ? '' + params[0] : '');
                break;
            case 'onUserInfoUpdate':
                this.onUserInfoUpdate(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onFriendListUpdate':
                this.onFriendListUpdate(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onFriendRequestUpdate':
                this.onFriendRequestUpdate(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onGroupInfoUpdate':
                this.onGroupInfoUpdate(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onGroupMembersUpdate':
                this.onGroupMemberUpdate(params.length > 0 ? '' + params[0] : '', params.length > 1 ? '' + params[1] : '[]');
                break;
            case 'onChannelInfoUpdate':
                this.onChannelInfoUpdate(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onSettingUpdate':
                this.onSettingUpdate();
                break;
            case 'onUserOnlineEvent':
                this.onOnlineEvent(params.length > 0 ? '' + params[0] : '[]');
                break;
            case 'onConferenceEvent':
                this.emit(EventType.ConferenceEvent, params);
                break;
            case 'onSendSuccess':
            case 'onSendFail':
            case 'onMediaUpload':
                this.onSendStatusUpdate(params.length > 0 ? '' + params[0] : '');
                break;
            case 'onSendPrepare':
                this.onSendPrepare(params.length > 0 ? '' + params[0] : '');
                break;
            default:
                break;
        }
    }

    /**
     * 向协议栈查询当前连的是主网络还是备选网络，存到 common/dualNetwork.uts，服务地址选择和双网媒体 URL
     * 转换都用它。
     *
     * 不从 onConnectToServer 的回调参数里取：各端参数形状不一样（鸿蒙是 host, ip, port, mainNw(1/0)，
     * iOS 只有 host, ip, port），android 的插件根本不抛这个事件。
     *
     * 协议栈是先通知 Receiving、再确定网络类型、再回调 OnConnected，同步完才通知 Connected
     * （proto stn_callback.cc）。所以 Connected 时查到的一定准；鸿蒙的 onConnectToServer 就是 OnConnected，
     * 也准，能覆盖 Receiving 期间。Receiving 和 iOS 的 onConnectToServer（TCP 连上时就回调）可能还是上一次
     * 连接的网络，和不查时沿用的值一样，查了没有坏处。
     */
    private _refreshConnectedNetwork(): void {
        updateConnectedToMainNetwork(native.isConnectedToMainNetwork());
    }

    private onConnectionChanged(status: number): void {
        if (!this.isLogined && status == ConnectionStatus.ConnectionStatusConnected) {
            this.isLogined = true;
        }
        this.connectionStatus = status;
        if (status == ConnectionStatus.ConnectionStatusConnected || status == ConnectionStatus.ConnectionStatusReceiveing) {
            this._refreshConnectedNetwork();
        }
        this.eventEmitter.emit(EventType.ConnectionStatusChanged, [status]);
        console.log('connection status changed', status);
        if (this.isLogined && (status == ConnectionStatus.ConnectionStatusSecretKeyMismatch || status == ConnectionStatus.ConnectionStatusRejected)) {
            this.disconnect();
        }
    }

    private onReceiveMessage(messagesStr: string, hasMore: boolean): void {
        if (!this.isLogined) {
            return;
        }
        // receiving
        if (this.connectionStatus == ConnectionStatus.ConnectionStatusReceiveing && this.firstSync) {
            return;
        }

        if (this.connectionStatus == ConnectionStatus.ConnectionStatusConnected) {
            this.firstSync = false;
        }

        // 鸿蒙端的音视频引擎跑在 ArkTS 侧，需要自己解码原始 proto 消息拿 voip 信令，
        // 所以这里把未解码的原文也抛一份出去（其他端没有订阅者，开销可忽略）
        this.emit(EventType.ReceiveProtoMessages, [messagesStr, hasMore]);

        const msgs: Message[] = []
        const arr = JSON.parseArray(messagesStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (!(o instanceof UTSJSONObject)) {
                    continue
                }
                const msg = Message.fromProtoMessage(o as UTSJSONObject);
                if (msg == null) {
                    continue
                }
                if (msg.messageContent instanceof MarkUnreadMessageContent && msg.from == this.getUserId()) {
                    const markMsg = msg.messageContent as MarkUnreadMessageContent;
                    native.setLastReceivedMessageUnRead(msg.conversation.toJsonStr(), stringValue(markMsg.messageUid), stringValue(markMsg.timestamp));
                }
                // 兼容旧版
                this.emit(EventType.ReceiveMessage, [msg, hasMore]);
                msgs.push(msg)
            }
        }
        if (msgs.length > 0) {
            this.emit(EventType.ReceiveMessages, [msgs, hasMore]);
        }
    }

    private onSendStatusUpdate(messageStr: string): void {
        const msg = Message.fromProtoMessage(JSON.parseObject(messageStr));
        if (msg != null) {
            this.emit(EventType.MessageStatusUpdate, [msg]);
        }
    }

    private onSendPrepare(messageStr: string): void {
        const msg = Message.fromProtoMessage(JSON.parseObject(messageStr));
        if (msg != null) {
            this.emit(EventType.SendMessage, [msg]);
        }
    }

    private onMessageUpdate(messageStr: string): void {
        const msg = Message.fromProtoMessage(JSON.parseObject(messageStr));
        if (msg != null) {
            this.emit(EventType.MessageStatusUpdate, [msg]);
        }
    }

