        }
        this.emit(EventType.DeleteMessage, [messageId]);
    }

    private onUserReceivedMessage(receivedMapStr: string): void {
        if (!this.isLogined) {
            return;
        }
        const deliveryMap = new Map<string, number>();
        const arr = JSON.parseArray(receivedMapStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const obj = o as UTSJSONObject
                    const key = obj.getString('key')
                    const value = obj.getNumber('value')
                    if (key != null && value != null) {
                        deliveryMap.set(key, value);
                    }
                }
            }
        }
        this.emit(EventType.MessageReceived, [deliveryMap]);
    }

    private onUserReadedMessage(readedMapStr: string): void {
        if (!this.isLogined) {
            return;
        }
        // [{"userId":"GNMtGtZZ","conversationType":1,"target":"Jl8jLjkk","line":0,"readDt":1590308777299} ]
        const readEntries: ReadEntry[] = [];
        const arr = JSON.parseArray(readedMapStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const e = o as UTSJSONObject
                    const entry = new ReadEntry();
                    entry.userId = e.getString('userId') ?? '';
                    const convObj = e.getJSON('conversation');
                    if (convObj != null) {
                        entry.conversation = Conversation.fromJsonObject(convObj);
                    } else {
                        entry.conversation = Conversation.fromJsonObject(e);
                    }
                    entry.readTime = e.getNumber('readDt') ?? 0;
                    readEntries.push(entry);
                }
            }
        }
        this.emit(EventType.MessageRead, [readEntries]);
    }

    private onUserInfoUpdate(userInfosStr: string): void {
        if (!this.isLogined) {
            return;
        }
        const userInfos: UserInfo[] = [];
        const arr = JSON.parseArray(userInfosStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    userInfos.push(UserInfo.fromJsonObject(o as UTSJSONObject));
                }
            }
        }
        this.emit(EventType.UserInfosUpdate, [userInfos]);
    }

