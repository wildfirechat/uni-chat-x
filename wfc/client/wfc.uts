    private _parseMessages(protoMsgsStr: string): Message[] {
        const msgs: Message[] = [];
        const arr = JSON.parseArray(protoMsgsStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const msg = Message.fromProtoMessage(o as UTSJSONObject)
                    if (msg != null) {
                        msgs.push(msg)
                    }
                }
            }
        }
        return msgs;
    }

    /**
     * 获取会话消息
     */
    getMessagesV2(conversation: Conversation, fromIndex: number, before: boolean, count: number, withUser: string, successCB: ((msgs: Message[]) => void) | null, failCB: ((err: number) => void) | null): void {
        native.getMessagesV2(conversation.toJsonStr(), fromIndex, before, count, withUser, (protoMsgsStr: string) => {
            successCB?.(this._parseMessages(protoMsgsStr));
        }, (err: number) => {
            failCB?.(err);
        });
    }

    getUserMessagesV2(userId: string, conversation: Conversation, fromIndex: number, before: boolean, count: number, successCB: ((msgs: Message[]) => void) | null, failCB: ((err: number) => void) | null): void {
        native.getUserMessagesV2(userId, conversation.toJsonStr(), fromIndex, before, count, (protoMsgsStr: string) => {
            successCB?.(this._parseMessages(protoMsgsStr));
        }, (err: number) => {
            failCB?.(err);
        });
    }

    /**
     * 按会话类型 + line + 消息状态跨会话取消息。
     *
     * [messageStatuses] 传空数组表示不限状态。朋友圈的评论/提醒消息落在 line=1 的单聊会话里，
     * 只能通过这个接口取（见 `wfc/moment/momentClient.uts` 的 getMessages）。
     */
    getMessagesByStatusEx(conversationTypes: number[], lines: number[], messageStatuses: number[], fromIndex: number, before: boolean, count: number, withUser: string, successCB: ((msgs: Message[]) => void) | null, failCB: ((err: number) => void) | null): void {
        native.getMessagesEx2V2(conversationTypes, lines, messageStatuses, fromIndex, before, count, withUser, (protoMsgsStr: string) => {
            successCB?.(this._parseMessages(protoMsgsStr));
        }, (err: number) => {
            failCB?.(err);
        });
    }

    getUserMessagesExV2(userId: string, conversationTypes: number[], lines: number[], fromIndex: number, before: boolean, count: number, contentTypes: number[], successCB: ((msgs: Message[]) => void) | null, failCB: ((err: number) => void) | null): void {
        native.getUserMessagesExV2(userId, conversationTypes, lines, fromIndex, before, count, contentTypes, (protoMsgsStr: string) => {
            successCB?.(this._parseMessages(protoMsgsStr));
        }, (err: number) => {
            failCB?.(err);
        });
    }

    /**
     * 获取会话的远程历史消息
     */
    loadRemoteConversationMessages(conversation: Conversation, contentTypes: number[], beforeUid: string, count: number, successCB: ((msgs: Message[]) => void) | null, failCB: ((err: number) => void) | null): void {
        native.getRemoteMessages(conversation.toJsonStr(), stringValue(beforeUid), count, (protoMsgsStr: string) => {
            const msgs = this._parseMessages(protoMsgsStr);
            console.log('loadRemoteMessages', msgs.length);
            successCB?.(msgs);
        }, (errorCode: number) => {
            console.log("loadRemoteMessages failure:", errorCode);
            failCB?.(errorCode);
        });
    }

    loadRemoteMessages(conversation: Conversation, contentTypes: number[], beforeUid: string, count: number, successCB: ((msgs: Message[]) => void) | null, failCB: ((err: number) => void) | null): void {
        this.loadRemoteConversationMessages(conversation, contentTypes, beforeUid, count, successCB, failCB);
    }

