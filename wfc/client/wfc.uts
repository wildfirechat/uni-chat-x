    /**
     * 发送朋友圈相关请求
     *
     * 朋友圈没有独立的原生 SDK —— 全部功能（时间线、发布、评论、可见范围、隐私设置）
     * 都通过这一个通道走：[path] 是朋友圈服务的路径，[data] 是 JSON 字符串，
     * 回调拿到的 [resp] 也是 JSON 字符串（protobuf 响应由原生侧解码完再回调）。
     * 业务层见 `wfc/moment/momentClient.uts`。
     *
     * ⚠️ 目前只有鸿蒙端可用。android / iOS 的原生插件尚未导出该方法，
     * 会直接回调 [ErrorCode.kEcServerNotImplement]（254），等两端 SDK 更新后即可生效。
     */
    sendMomentsRequest(path: string, data: string, callback: ((errorCode: number, resp: string | null) => void) | null): void {
        native.sendMomentsRequest(path, data,
            (resp: string) => {
                callback?.(0, resp);
            },
            (errorCode: number) => {
                callback?.(errorCode, null)
            });
    }

