import AddGroupMemberNotification from '../messages/notification/addGroupMemberNotification.uts';

/**
 * 把 native 回调传回的 args(object) 转为数组
 */
function argsOf(value: object | null): Array<any | null> {
    if (value == null) {
        return []
    }
    if (value instanceof Array) {
        return value as Array<any | null>
    }
    // 兜底：JSON 序列化再解析
    try {
        const str = JSON.stringify(value)
        if (str != null && str.startsWith('[')) {
            const arr = JSON.parseArray(str)
            if (arr != null) {
                return arr as Array<any | null>
            }
        }
    } catch (e) {
        console.error('argsOf error', e)
    }
    return []
}

export class WfcManager {
    /**
     * 事件通知，EventType 中定义的事件，都会采用本 eventEmitter 通知
     */
    eventEmitter: EventEmitter = new EventEmitter();

    private connectionStatus = 0;
    private userId = '';
    private isLogined = false;
    private firstSync = true;

    private emit(event: string, args: Array<any | null>): void {
        if (event == EventType.ConnectionStatusChanged || event == EventType.UserOnlineEvent) {
            this.eventEmitter.emit(event, args)
        } else {
            if (this.connectionStatus == ConnectionStatus.ConnectionStatusConnected) {
                this.eventEmitter.emit(event, args)
            }
            // else ignore
        }
    }

    /**
     * 初始化，请参考本demo的用法
     */
    init(): void {
        console.log('wfc init');
        native.initProto();

        native.onWfcEventListener((value: object) => {
            this._handleNativeEvent(value);
        })

        this.connectionStatus = native.getConnectionStatus();
        this.isLogined = this.connectionStatus == ConnectionStatus.ConnectionStatusConnected;
        if (this.connectionStatus == ConnectionStatus.ConnectionStatusConnected || this.connectionStatus == ConnectionStatus.ConnectionStatusReceiveing) {
            this._refreshConnectedNetwork();
        }

        this.registerDefaultMessageContents();
        console.log('wfc init end')
    }

    private registerDefaultMessageContents(): void {
        for (let i = 0; i < MessageConfig.MessageContents.length; i++) {
            const e = MessageConfig.MessageContents[i]
            native.registerMessageFlag(e.type, e.flag);
        }
    }

    /**
     * 注册新的自定义消息
     */
    registerMessageContent(name: string, flag: number, type: number, creator: MessageContentCreator): void {
        MessageConfig.registerMessageContent(name, flag, type, creator);
        native.registerMessageFlag(type, flag);
    }

    getClientId(): string {
        return native.getClientId();
    }

    /**
     * 启用国密加密。注意需要服务器端同步开启国密配置
     */
    useSM4(): void {
        native.useSM4();
    }

    setSendLogCommand(command: string): void {
        native.setSendLogCommand(command);
    }

    /**
     * 使用 websocket 作为 IM 长连接，需要 2026.9.11 之后的专业版 IM 服务。
     * 必须在 connect 之前调用：长连接类型在协议栈初始化时确定，连接建立之后再切换不会生效。
     */
    setUseWebsocket(useWebsocket: boolean): void {
        native.setUseWebsocket(useWebsocket);
    }

    isUseWebsocket(): boolean {
        return native.isUseWebsocket();
    }

    /**
     * 开启 TLS（wss/https），需要专业版 IM 服务并开启 TLS 功能。必须在 connect 之前调用。
     *
     * @param skipVerifyCert 是否跳过服务端证书校验，true 时只加密不校验，有中间人攻击风险
     * @param certificates 额外信任的私有/自签证书，元素既可以是 PEM 内容，也可以是证书文件路径；公签证书传空数组
     */
    useTls(skipVerifyCert: boolean, certificates: string[]): void {
        native.useTls(skipVerifyCert, certificates);
    }

    /**
     * 连接服务器
     */
    connect(userId: string, token: string): void {
        this.userId = userId;
        native.connect(Config.IM_SERVER_HOST, userId, token);
        console.log('connect', userId, Config.IM_SERVER_HOST);
    }

    setProxyInfo(host: string, ip: string, port: number, username: string, password: string): void {
        native.setProxyInfo(host, ip, port, username, password);
    }

    /**
     * 设置第三方推送设备token
     */
    setDeviceToken(pushType: number, token: string): void {
        native.setDeviceToken(pushType, token);
    }

    /**
     * 断开连接
     */
    disconnect(disablePush: boolean = false, clearSession: boolean = false): void {
        this.userId = '';
        native.disconnect(disablePush, clearSession);
    }

    getUserId(): string {
        if (this.userId != '') {
            return this.userId;
        }
        this.userId = native.getUserId();
        return this.userId;
    }

    getServerDeltaTime(): number {
        return native.getServerDeltaTime();
    }

    isLogin(): boolean {
        return this.isLogined;
    }

    getConnectionStatus(): number {
        return native.getConnectionStatus();
    }

    /**
     * 设置双网环境的网络策略，仅专业版 IM 服务支持，一般用于政企单位内外网两种网络环境。
     *
     * @param strategy 网络策略，0 是复合连接；1 是使用主要网络；2 使用备选网络
     */
    setBackupAddressStrategy(strategy: number): void {
        updateBackupAddressStrategy(strategy);
        native.setBackupAddressStrategy(strategy);
    }

    getBackupAddressStrategy(): number {
        return _getBackupAddressStrategy();
    }

    /**
     * 设置 IM 备选地址，仅专业版 IM 服务支持，要在 connect 之前调用。
     *
     * @param backupHost 备选网络的 IP 或域名
     * @param backupPort 备选网络的端口
     */
    setBackupAddress(backupHost: string, backupPort: number): void {
        native.setBackupAddress(backupHost, backupPort);
    }

    /**
     * 双网环境时，当前是否连接到了主网络。未连接时返回最近一次连接的网络，还没有连接过时按主网络处理。
     * 各服务地址的主备选择见 Config.getAppServer() 等方法。
     */
    isConnectedToMainNetwork(): boolean {
        return _isConnectedToMainNetwork();
    }

    setProtoUserAgent(userAgent: string): void {
        native.setUserAgent(userAgent);
    }

    addHttpHeader(header: string, value: string): void {
        native.addHttpHeader(header, value);
    }

    /**
     * 获取我保存到通讯录的群组信息列表
     */
    getFavGroupList(): GroupInfo[] {
        const settings = this.getUserSettings(UserSettingScope.FavoriteGroup);
        const groupInfos: GroupInfo[] = [];
        for (let i = 0; i < settings.length; i++) {
            const setting = settings[i]
            if (setting.value == '1') {
                groupInfos.push(this.getGroupInfo(setting.key, false));
            }
        }
        return groupInfos;
    }

    getMyGroupList(): GroupInfo[] {
        return this.getFavGroupList();
    }

    getUserDisplayName(userId: string): string {
        const userInfo = this.getUserInfo(userId, false);
        return this.getUserDisplayNameEx(userInfo);
    }

    getGroupMemberDisplayName(groupId: string, userId: string): string {
        const userInfo = this.getUserInfo(userId, false, groupId);
        return this.getGroupMemberDisplayNameEx(userInfo);
    }

    getUserDisplayNameEx(userInfo: UserInfo): string {
        if (userInfo.friendAlias != '') {
            return userInfo.friendAlias
        }
        if (userInfo.displayName != '') {
            return userInfo.displayName
        }
        return '<' + userInfo.uid + '>';
    }

    getGroupMemberDisplayNameEx(userInfo: UserInfo): string {
        if (userInfo.groupAlias != '') {
            return userInfo.groupAlias
        }
        if (userInfo.friendAlias != '') {
            return userInfo.friendAlias
        }
        if (userInfo.displayName != '') {
            return userInfo.displayName
        }
        return '<' + userInfo.uid + '>';
    }

    /**
     * 获取用户信息
     */
    getUserInfo(userId: string, refresh: boolean = false, groupId: string = ''): UserInfo {
        if (userId == '') {
            return new NullUserInfo('');
        }
        let userInfo: UserInfo
        const userInfoStr = native.getUserInfo(userId, refresh, groupId);
        if (userInfoStr == '') {
            userInfo = new NullUserInfo(userId);
        } else {
            const obj = JSON.parseObject(userInfoStr)
            userInfo = obj != null ? UserInfo.fromJsonObject(obj) : new NullUserInfo(userId);
        }
        if (userInfo.portrait == '') {
            userInfo.portrait = this.defaultUserPortrait(userInfo);
        }
        return userInfo;
    }

    getUserInfoEx(userId: string, refresh: boolean, success: ((userInfo: UserInfo) => void) | null, fail: ((err: number) => void) | null): void {
        native.getUserInfoEx(userId, refresh, (userInfoStr: string) => {
            const obj = JSON.parseObject(userInfoStr)
            if (obj != null && success != null) {
                const userInfo = UserInfo.fromJsonObject(obj)
                if (userInfo.portrait == '') {
                    userInfo.portrait = this.defaultUserPortrait(userInfo);
                }
                success(userInfo);
            }
        }, (errorCode: number) => {
            fail?.(errorCode);
        });
    }

    /**
     * 批量获取用户信息
     */
    getUserInfos(userIds: string[], groupId: string = ''): UserInfo[] {
        const users: UserInfo[] = [];
        if (userIds.length == 0) {
            return users;
        }
        const userInfoStrs = native.getUserInfos(userIds, groupId);
        if (userInfoStrs != '') {
            const arr = JSON.parseArray(userInfoStrs);
            if (arr != null) {
                for (let i = 0; i < arr.length; i++) {
                    const o = arr[i]
                    if (o instanceof UTSJSONObject) {
                        const u = UserInfo.fromJsonObject(o as UTSJSONObject)
                        if (u.portrait == '') {
                            u.portrait = this.defaultUserPortrait(u)
                        }
                        users.push(u)
                    }
                }
            }
        }
        return users;
    }

    /**
     * 服务端搜索用户
     */
    searchUser(keyword: string, searchType: number, page: number, successCB: ((keyword: string, userInfos: UserInfo[]) => void) | null, failCB: ((err: number) => void) | null): void {
        native.searchUser(keyword, searchType, page, (result: string) => {
            const userList: UserInfo[] = [];
            const arr = JSON.parseArray(result);
            if (arr != null) {
                for (let i = 0; i < arr.length; i++) {
                    const o = arr[i]
                    if (o instanceof UTSJSONObject) {
                        const u = UserInfo.fromJsonObject(o as UTSJSONObject)
                        if (u.portrait == '') {
                            u.portrait = this.defaultUserPortrait(u)
                        }
                        userList.push(u)
                    }
                }
            }
            successCB?.(keyword, userList);
        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
    }

    /**
     * 本地搜索好友
     */
    searchFriends(keyword: string): UserInfo[] {
        const result = native.searchFriends(keyword);
        const userList: UserInfo[] = [];
        const arr = JSON.parseArray(result);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const u = UserInfo.fromJsonObject(o as UTSJSONObject)
                    if (u.portrait == '') {
                        u.portrait = this.defaultUserPortrait(u)
                    }
                    userList.push(u)
                }
            }
        }
        return userList;
    }

    /**
     * 本地搜索群组
     */
    searchGroups(keyword: string): GroupSearchResult[] {
        const result = native.searchGroups(keyword);
        const list: GroupSearchResult[] = [];
        const arr = JSON.parseArray(result);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const r = GroupSearchResult.fromProtoGroupSearchResult(o as UTSJSONObject)
                    if (r.groupInfo.portrait == '') {
                        r.groupInfo.portrait = this.defaultGroupPortrait(r.groupInfo);
                    }
                    list.push(r)
                }
            }
        }
        return list;
    }

    /**
     * 获取收到的好友请求
     */
    getIncommingFriendRequest(): FriendRequest[] {
        const result = native.getIncommingFriendRequest();
        return this._parseFriendRequests(result);
    }

    /**
     * 获取发送出去的好友请求
     */
    getOutgoingFriendRequest(): FriendRequest[] {
        const result = native.getOutgoingFriendRequest();
        return this._parseFriendRequests(result);
    }

    private _parseFriendRequests(result: string): FriendRequest[] {
        const list: FriendRequest[] = [];
        const arr = JSON.parseArray(result);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    list.push(FriendRequest.fromJsonObject(o as UTSJSONObject))
                }
            }
        }
        return list;
    }

    /**
     * 获取单条好友请求
     */
    getFriendRequest(userId: string, incoming: boolean = true): FriendRequest | null {
        const result = native.getFriendRequest(userId, incoming);
        const obj = JSON.parseObject(result);
        return obj != null ? FriendRequest.fromJsonObject(obj) : null;
    }

    loadFriendRequestFromRemote(): void {
        native.loadFriendRequestFromRemote();
    }

    getUnreadFriendRequestCount(): number {
        return native.getUnreadFriendRequestStatus();
    }

    clearUnreadFriendRequestStatus(): void {
        native.clearUnreadFriendRequestStatus();
    }

    /**
     * 清除好友请求
     */
    clearFriendRequest(incomming: boolean, beforeTime: number = 0): void {
        native.clearFriendRequest(incomming ? 1 : 0, beforeTime);
    }

    /**
     * 清除一条好友请求
     */
    deleteFriendRequest(userId: string, incomming: boolean): void {
        native.deleteFriendRequest(userId, incomming ? 1 : 0);
    }

    deleteFriend(userId: string, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        native.deleteFriend(userId, () => {
            successCB?.();
        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
    }

    handleFriendRequest(userId: string, accept: boolean, extra: string, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        native.handleFriendRequest(userId, accept, () => {
            successCB?.();
        }, (errorCode: number) => {
            failCB?.(errorCode);
        }, extra);
    }

    isBlackListed(userId: string): boolean {
        return native.isBlackListed(userId);
    }

    getBlackList(): string[] {
        const result = native.getBlackList();
        const arr = JSON.parse<Array<string>>(result);
        return arr ?? ([] as string[]);
    }

    setBlackList(userId: string, block: boolean, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        native.setBlackList(userId, block, () => {
            successCB?.();
        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
    }

    /**
     * 获取好友列表，返回好友id数组
     */
    getMyFriendList(fresh: boolean = false): string[] {
        const idsStr = native.getMyFriendList(fresh);
        if (idsStr != '') {
            const arr = JSON.parse<Array<string>>(idsStr);
            return arr ?? ([] as string[]);
        }
        return [];
    }

    getFriendAlias(userId: string): string {
        return native.getFriendAlias(userId);
    }

    setFriendAlias(userId: string, alias: string, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        native.setFriendAlias(userId, alias, () => {
            successCB?.();
        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
    }

    /**
     * 创建群组
     */
    createGroup(groupId: string | null, groupType: number, name: string, portrait: string | null, groupExtra: string | null, memberIds: string[], memberExtra: string | null, lines: number[], notifyContent: MessageContent | null, successCB: ((groupId: string) => void) | null, failCB: ((err: number) => void) | null): void {
        const gid = groupId ?? '';
        const myUid = this.getUserId();
        if (memberIds.indexOf(myUid) < 0) {
            memberIds.push(myUid);
        }
        const notifyContentStr = notifyContent != null ? notifyContent.encode().toJsonStr() : '';
        native.createGroup(gid, groupType, name, portrait ?? '', groupExtra ?? '', memberIds, memberExtra ?? '', lines, notifyContentStr,
            (newGroupId: string) => {
                successCB?.(newGroupId);
            },
            (errorCode: number) => {
                failCB?.(errorCode);
            });
    }

    setGroupManager(groupId: string, isSet: boolean, memberIds: string[], lines: number[], notifyContent: MessageContent | null, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        const notifyContentStr = notifyContent != null ? notifyContent.encode().toJsonStr() : '';
        native.setGroupManager(groupId, isSet, memberIds, lines, notifyContentStr, () => {
            successCB?.();
        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
    }

    /**
     * 获取群信息
     */
    getGroupInfo(groupId: string, refresh: boolean = false): GroupInfo {
        const groupInfoStr = native.getGroupInfo(groupId, refresh);
        let info: GroupInfo
        if (groupInfoStr == '') {
            info = new NullGroupInfo(groupId);
        } else {
            const obj = JSON.parseObject(groupInfoStr)
            info = obj != null ? GroupInfo.fromJsonObject(obj) : new NullGroupInfo(groupId);
        }
        if (info.portrait == '') {
            info.portrait = this.defaultGroupPortrait(info);
        }
        return info;
    }

    /**
     * 批量获取群信息
     */
    getGroupInfos(groupIds: string[], refresh: boolean = false): GroupInfo[] {
        const infos: GroupInfo[] = [];
        if (groupIds.length == 0) {
            return infos;
        }
        const groupInfosStr = native.getGroupInfos(groupIds, refresh);
        if (groupInfosStr != '') {
            const arr = JSON.parseArray(groupInfosStr);
            if (arr != null) {
                for (let i = 0; i < arr.length; i++) {
                    const o = arr[i]
                    if (o instanceof UTSJSONObject) {
                        const g = GroupInfo.fromJsonObject(o as UTSJSONObject)
                        if (g.portrait == '') {
                            g.portrait = this.defaultGroupPortrait(g);
                        }
                        infos.push(g)
                    }
                }
            }
        }
        return infos;
    }

    /**
     * 添加群成员
     */
    addGroupMembers(groupId: string, memberIds: string[], extra: string, notifyLines: number[], notifyMessageContent: MessageContent | null, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        const content: MessageContent = notifyMessageContent ?? new AddGroupMemberNotification(this.getUserId(), memberIds);
        const notifyContentStr = content.encode().toJsonStr();
        native.addMembers(groupId, memberIds, extra, notifyLines, notifyContentStr,
            () => {
                successCB?.();
            },
            (errorCode: number) => {
                failCB?.(errorCode);
            });
    }

    /**
     * 获取群成员id列表
     */
    getGroupMemberIds(groupId: string, fresh: boolean = false): string[] {
        const groupMembers = this.getGroupMembers(groupId, fresh);
        const groupMemberIds: string[] = [];
        for (let i = 0; i < groupMembers.length; i++) {
            groupMemberIds.push(groupMembers[i].memberId);
        }
        return groupMemberIds;
    }

    /**
     * 获取群成员信息
     */
    getGroupMembers(groupId: string, fresh: boolean = false): GroupMember[] {
        const memberIdsStr = native.getGroupMembers(groupId, fresh);
        const members: GroupMember[] = [];
        const arr = JSON.parseArray(memberIdsStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    members.push(GroupMember.fromJsonObject(o as UTSJSONObject))
                }
            }
        }
        return members;
    }

    /**
     * 获取单个群成员信息
     */
    getGroupMember(groupId: string, memberId: string): GroupMember {
        const result = native.getGroupMember(groupId, memberId);
        const obj = JSON.parseObject(result);
        return obj != null ? GroupMember.fromJsonObject(obj) : new GroupMember();
    }

    /**
     * 将用户从群里移除
     */
    kickoffGroupMembers(groupId: string, memberIds: string[], notifyLines: number[], notifyMsg: MessageContent | null, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        const strCont = notifyMsg != null ? notifyMsg.encode().toJsonStr() : '';
        native.kickoffMembers(groupId, memberIds, notifyLines, strCont,
            () => {
                successCB?.();
            }, (errorCode: number) => {
                failCB?.(errorCode);
            });
    }

    /**
     * 对群成员禁言
     */
    muteGroupMembers(groupId: string, isSet: boolean, memberIds: string[], notifyLines: number[], notifyMsg: MessageContent | null, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
        const notifyContentStr = notifyMsg != null ? notifyMsg.encode().toJsonStr() : '';
        native.muteGroupMember(groupId, isSet, memberIds, notifyLines, notifyContentStr, () => {
            successCB?.();
        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
