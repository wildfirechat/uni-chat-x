    /**
     * 获取会话已读情况
     * @return Map<userId, readTime>
     */
    getConversationRead(conversation: Conversation): Map<string, number> {
        const readedStr = native.getConversationRead(conversation.toJsonStr());
        const result = new Map<string, number>();
        const arr = JSON.parseArray(readedStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const obj = o as UTSJSONObject
                    const key = obj.getString('key')
                    const value = obj.getNumber('value')
                    if (key != null && value != null) {
                        result.set(key, value)
                    }
                }
            }
        }
        return result;
    }

    private _parseFileRecords(frsStr: string): FileRecord[] {
        const fileRecords: FileRecord[] = [];
        const arr = JSON.parseArray(frsStr);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const obj = o as UTSJSONObject
                    const fileRecord = new FileRecord();
                    fileRecord.userId = obj.getString('userId') ?? '';
                    const convObj = obj.getJSON('conversation');
                    if (convObj != null) {
                        fileRecord.conversation = Conversation.fromJsonObject(convObj);
                    } else {
                        fileRecord.conversation = Conversation.fromJsonObject(obj);
                    }
                    fileRecord.messageUid = stringValue(obj.get('messageUid'));
                    fileRecord.name = obj.getString('name') ?? '';
                    fileRecord.url = redirectMediaUrl(obj.getString('url') ?? '');
                    fileRecord.size = obj.getNumber('size') ?? 0;
                    fileRecord.downloadCount = obj.getNumber('downloadCount') ?? 0;
                    fileRecord.timestamp = obj.getNumber('timestamp') ?? 0;
                    fileRecords.push(fileRecord);
                }
            }
        }
        return fileRecords;
    }

    /**
     * 获取会话中的文件记录。
     *
     * [conversation] 传 null 表示不限会话（拉全部文件），[fromUser] 传 '' 表示不限发送者
     * —— 与 [searchFiles] 的语义一致。
     */
    getConversationFileRecords(conversation: Conversation | null, fromUser: string, beforeMessageUid: string, count: number, successCB: ((records: FileRecord[]) => void) | null, failCB: ((err: number) => void) | null): void {
        native.getConversationFiles(conversation != null ? conversation.toJsonStr() : '', fromUser, stringValue(beforeMessageUid), count, (frsStr: string) => {
