        }, (errorCode: number) => {
            failCB?.(errorCode);
        });
    }

    /**
     * 获取消息
     */
    getMessageById(messageId: number): Message | null {
        const mStr = native.getMessage(messageId);
        const obj = JSON.parseObject(mStr);
        return Message.fromProtoMessage(obj);
    }

