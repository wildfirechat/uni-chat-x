    /**
     * 获取某个命名空间下的所有设置
     */
    getUserSettings(scope: number): UserSettingEntry[] {
        const result = native.getUserSettings(scope);
        const list: UserSettingEntry[] = [];
        const arr = JSON.parseArray(result);
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    list.push(UserSettingEntry.fromJsonObject(o as UTSJSONObject))
                }
            }
        }
        return list;
    }

