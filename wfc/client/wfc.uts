    /**
     * 上传媒体数据（base64）
     */
    uploadMedia(fileName: string, data: string, mediaType: number, successCB: ((remoteUrl: string) => void) | null, failCB: ((err: number) => void) | null, progressCB: ((current: number, total: number) => void) | null): void {
        let b64Data = data
        if (b64Data.indexOf("base64,") >= 0) {
            b64Data = b64Data.substring(b64Data.indexOf(',') + 1);
        }
        native.uploadMedia(fileName, b64Data, mediaType,
            (remoteUrl: string) => {
                successCB?.(remoteUrl);
            },
            (errorCode: number) => {
                failCB?.(errorCode);
            },
            (value: object) => {
                const args = argsOf(value);
                const current = args.length > 0 ? numberValue(args[0]) : 0;
                const total = args.length > 1 ? numberValue(args[1]) : 0;
                progressCB?.(current, total);
            });
    }

